---
export interface Props {
  lang?: 'en' | 'pt' | 'es' | 'ar' | 'zh';
}
const { lang = 'en' } = Astro.props;
const isRtl = lang === 'ar';
// [语言差异] 中文使用新号码，其他语言保持原号码
const phone = lang === 'zh' ? '+86 19020586646' : '+86 18818994346';
const phoneHref = lang === 'zh' ? '+8619020586646' : '+8618818994346';
// [语言差异] 中文使用新邮箱，其他语言保持原邮箱
const email = lang === 'zh' ? 'yue.peng@chitek-inno.com' : 'leo.li@chitek-inno.com';
---
<div class:list={[
  "sidebar-wrapper fixed top-[75%] -translate-y-1/2 z-[9999] flex flex-col bg-brand-orange shadow-lg overflow-hidden w-[50px] hover:w-[250px] transition-all duration-300 group",
  isRtl ? "left-0 rounded-r-lg" : "right-0 rounded-l-lg"
]}>
  <!-- [语言差异] 电话链接和显示号码 -->
  <a href={`tel:${phoneHref}`} class="sidebar-phone contact-item relative flex items-center justify-start w-full h-[50px] cursor-pointer border-b border-white/20 no-underline text-white overflow-hidden whitespace-nowrap hover:bg-[#C43B13] transition-colors duration-300">
    <div class="w-[50px] h-[50px] flex items-center justify-center shrink-0">
      <svg class="w-[22px] h-[22px] stroke-white stroke-2 fill-none [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    </div>
    <span dir="ltr" class="contact-info flex items-center h-[50px] text-[clamp(11px,0.9vw,14px)] font-medium text-white pr-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible whitespace-nowrap shrink-0 transition-all duration-300">{phone}</span>
  </a>

  <!-- [语言差异] 中文使用新邮箱，其他语言保持原邮箱 -->
  <a href={`mailto:${email}`} class="sidebar-email contact-item relative flex items-center justify-start w-full h-[50px] cursor-pointer border-b border-white/20 no-underline text-white overflow-hidden whitespace-nowrap hover:bg-[#C43B13] transition-colors duration-300">
    <div class="w-[50px] h-[50px] flex items-center justify-center shrink-0">
      <svg class="w-[22px] h-[22px] stroke-white stroke-2 fill-none [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
    </div>
    <span class="contact-info flex items-center h-[50px] text-[clamp(11px,0.9vw,14px)] font-medium text-white pr-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible whitespace-nowrap shrink-0 transition-all duration-300">{email}</span>
  </a>

  <!-- [语言差异] WhatsApp链接号码 -->
  <a href={`https://wa.me/${phoneHref.replace('+', '')}`} target="_blank" class="sidebar-whatsapp contact-item relative flex items-center justify-start w-full h-[50px] cursor-pointer no-underline text-white overflow-hidden whitespace-nowrap hover:bg-[#C43B13] transition-colors duration-300">
    <div class="w-[50px] h-[50px] flex items-center justify-center shrink-0">
      <svg class="w-[22px] h-[22px] fill-white" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
    </div>
    <span dir="ltr" class="contact-info flex items-center h-[50px] text-[clamp(11px,0.9vw,14px)] font-medium text-white pr-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible whitespace-nowrap shrink-0 transition-all duration-300">{phone}</span>
  </a>
</div>

<style>
  @media (max-width: 767px) {
    .sidebar-phone,
    .sidebar-email {
      height: 0;
      overflow: hidden;
      border-bottom: none;
    }
    .sidebar-wrapper:hover .sidebar-phone,
    .sidebar-wrapper:hover .sidebar-email,
    .sidebar-wrapper.is-open .sidebar-phone,
    .sidebar-wrapper.is-open .sidebar-email {
      height: 50px;
      border-bottom-width: 1px;
      border-color: rgba(255,255,255,0.2);
    }
    /* 手机上 tap 一下：整个侧边栏向左滑出到 250px，图标 + 文字一起显示（2026-10-21）。
       第一次 tap 只展开、不跳转；展开后再点具体项才拨号 / 发邮件 / 开 WhatsApp。
       拦截逻辑在下面的 script 里 —— 纯 CSS 做不到「未展开时拦截、已展开时放行」。 */
    .sidebar-wrapper.is-open {
      width: 250px;
    }
    .sidebar-wrapper.is-open .contact-info {
      opacity: 1;
      visibility: visible;
    }
  }
</style>

<script>
  (function () {
    var bar = document.querySelector('.sidebar-wrapper');
    if (!bar) return;
    var isOpen = false;
    var isPhone = function () {
      return window.matchMedia('(max-width: 767px)').matches;
    };
    var setOpen = function (v) {
      isOpen = v;
      bar.classList.toggle('is-open', v);
    };

    // 手机：第一次 tap 任一项 => 只展开，拦掉导航
    bar.addEventListener('click', function (e) {
      if (!isPhone() || isOpen) return;
      if (!e.target.closest('a')) return;
      e.preventDefault();
      e.stopPropagation();
      setOpen(true);
    });

    // 点侧边栏外面 => 收起
    document.addEventListener('click', function (e) {
      if (isOpen && !bar.contains(e.target)) setOpen(false);
    });

    // 转回桌面宽度时清掉手机端的展开态
    window.addEventListener('resize', function () {
      if (!isPhone() && isOpen) setOpen(false);
    });
  })();
</script>
