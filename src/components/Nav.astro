---
export interface Props {
  lang?: 'en' | 'pt' | 'es' | 'ar' | 'zh';
}
const { lang = 'en' } = Astro.props;
const isRtl = lang === 'ar';
// 本地开发/预览（localhost）用路径前缀；线上 zh/en 用根路径（子域名承载语言）
const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);

const t: Record<string, { en: string; pt: string; es: string; ar: string; zh: string }> = {
  products: { en: 'Products', pt: 'Produtos', es: 'Productos', ar: 'المنتجات', zh: '产品中心' },
  solutions: { en: 'Solutions', pt: 'Soluções', es: 'Soluciones', ar: 'الحلول', zh: '解决方案' },
  services: { en: 'Services', pt: 'Serviços', es: 'Servicios', ar: 'الخدمات', zh: '服务支持' },
  news: { en: 'News', pt: 'Notícias', es: 'Noticias', ar: 'الأخبار', zh: '新闻资讯' },
  about: { en: 'About', pt: 'Sobre', es: 'Sobre Nosotros', ar: 'عن الشركة', zh: '关于我们' },
  contact: { en: 'Contact', pt: 'Contato', es: 'Contacto', ar: 'اتصل بنا', zh: '联系我们' },
  search: { en: 'Search...', pt: 'Pesquisar...', es: 'Buscar...', ar: 'بحث...', zh: '搜索...' },
  activeHarmonicFilter: { en: 'Active Harmonic Filter', pt: 'Filtro Harmônico Ativo', es: 'Filtro Armónico Activo', ar: 'فلتر التوافق النشط', zh: '有源滤波器AHF' },
  staticVarGenerator: { en: 'Static Var Generator', pt: 'Gerador Estático de Var', es: 'Generador Estático de Var', ar: 'مولد الفولت أمبير الساكن', zh: '无功静止发生器SVG' },
  advancedStaticVarGenerator: { en: 'Advanced Static Var Generator', pt: 'Gerador Estático de Var Avançado', es: 'Generador Estático de Var Avanzado', ar: 'مولد الفولت أمبير الساكن المتقدم', zh: '高级无功静止发生器ASVG' },
  sicAhfSvg: { en: 'Silicon Carbide AHF/SVG', pt: 'Silicon Carbide AHF/SVG', es: 'Silicon Carbide AHF/SVG', ar: 'Silicon Carbide AHF/SVG', zh: '碳化硅系列 Sic AHF/SVG' },
  industrialManufacturing: { en: 'Industrial Manufacturing', pt: 'Manufatura Industrial', es: 'Fabricación Industrial', ar: 'التصنيع الصناعي', zh: '工业制造' },
  commercialMedical: { en: 'Commercial & Medical Buildings', pt: 'Edifícios Comerciais e Médicos', es: 'Edificios Comerciales y Médicos', ar: 'المباني التجارية والطبية', zh: '商业及医疗建筑' },
  dataCentersTelecom: { en: 'Data Centers & Telecom', pt: 'Data Centers e Telecom', es: 'Centros de Datos y Telecomunicaciones', ar: 'مراكز البيانات والاتصالات', zh: '数据中心与通信' },
  renewableEnergy: { en: 'Renewable Energy (PV/Wind)', pt: 'Energia Renovável (FV/Eólica)', es: 'Energía Renovable (FV/Eólica)', ar: 'الطاقة المتجددة (الطاقة الشمسية/الرياح)', zh: '新能源（光伏/风电）' },
  transportation: { en: 'Transportation (Rail/Charging)', pt: 'Transporte (Ferroviário/Carregamento)', es: 'Transporte (Ferroviario/Carga)', ar: 'النقل (السكك الحديدية/الشحن)', zh: '轨道交通与充电' },
  powerGridUtility: { en: 'Power Grid & Utility', pt: 'Rede Elétrica e Utilidades', es: 'Red Eléctrica y Servicios Públicos', ar: 'شبكة الكهرباء والمرافق', zh: '电网与公用事业' },
  oemOdm: { en: 'OEM/ODM', pt: 'OEM/ODM', es: 'OEM/ODM', ar: 'OEM/ODM', zh: 'OEM/ODM' },
  technicalSupport: { en: 'Technical Support', pt: 'Suporte Técnico', es: 'Soporte Técnico', ar: 'الدعم الفني', zh: '技术支持' },
  distributorProgram: { en: 'Distributor Program', pt: 'Programa de Distribuidores', es: 'Programa de Distribuidores', ar: 'برنامج الموزعين', zh: '经销商计划' },
  companyProfile: { en: 'Company Profile', pt: 'Perfil da Empresa', es: 'Perfil de la Empresa', ar: 'ملف الشركة', zh: '公司简介' },
  caseStudies: { en: 'Case Studies', pt: 'Estudos de Caso', es: 'Casos de Estudio', ar: 'دراسات الحالة', zh: '案例研究' },
  certifications: { en: 'Certifications', pt: 'Certificações', es: 'Certificaciones', ar: 'الشهادات', zh: '资质认证' },
};

function _(key: string): string {
  return t[key]?.[lang] || t[key]?.en || key;
}
const langLabel: Record<string, string> = { en: 'English', pt: 'Português', es: 'Español', ar: 'العربية', zh: '中文' };
const langFlagCode: Record<string, string> = { en: 'gb', pt: 'pt', es: 'es', ar: 'sa', zh: 'cn' };

/** Build href for a target language from current pathname */
function langHref(targetLang: string): string {
  const { pathname } = Astro.url;
  let base = pathname;
  for (const prefix of ['/en', '/es', '/ar', '/pt']) {
    if (base.startsWith(prefix)) {
      base = base.slice(prefix.length) || '/';
      break;
    }
  }
  // 详情页（/products|products-svg|products-asvg/{slug}）仅英文版存在。
  // 从英文详情页切到 es/ar/pt → 仍指向英文详情页（避免 404）；切到 zh → 回退本语言系列汇总页。
  const detailMatch = base.match(/^\/products(-svg|-asvg)?\/[^/]+\/?$/);
  if (detailMatch) {
    if (targetLang === 'es' || targetLang === 'ar' || targetLang === 'pt') {
      return isLocal ? '/en' + base : 'https://en.chitek-inno.com' + base;
    }
    if (targetLang === 'zh') {
      const series = detailMatch[1] ? '/products' + detailMatch[1] : '/products';
      return isLocal ? series : 'https://chitek-inno.com' + series;
    }
  }
  // 本地开发/预览（localhost）用路径前缀相对链接，避免跳到线上子域名；线上维持绝对子域名
  if (isLocal) {
    const localPrefix: Record<string, string> = { zh: '', en: '/en', es: '/es', ar: '/ar', pt: '/pt' };
    return (localPrefix[targetLang] || '') + base;
  }
  const domain: Record<string, string> = {
    zh: 'https://chitek-inno.com',
    en: 'https://en.chitek-inno.com',
    es: 'https://es.chitek-inno.com',
    ar: 'https://ar.chitek-inno.com',
    pt: 'https://pt.chitek-inno.com',
  };
  return (domain[targetLang] || 'https://chitek-inno.com') + base;
}
const activeLangLabel = langLabel[lang] || 'English';
const activeLangFlag = langFlagCode[lang] || 'gb';
const enHref = langHref('en');
const ptHref = langHref('pt');
const esHref = langHref('es');
const arHref = langHref('ar');
const zhHref = langHref('zh');

// pt 站没有新闻栏目（与其他语言一致化后依然如此）。
// 新闻路径下不再向用户提供 pt 切换项，避免指向 /pt/news/... 的 404 死链。
// 与下方 News 导航项仅对 zh/en/es/ar 渲染的处理保持一致。
const pathNoLang = (() => {
  let b = Astro.url.pathname;
  for (const p of ['/en', '/es', '/ar', '/pt']) {
    if (b.startsWith(p)) { b = b.slice(p.length) || '/'; break; }
  }
  return b;
})();
const showPtSwitch = !/^\/news(\/|$)/.test(pathNoLang);
// 本地（localhost）全语言用路径前缀；线上统一无前缀（子域名承载语言）
const prefix = isLocal
  ? (lang === 'en' ? '/en' : lang === 'es' ? '/es' : lang === 'ar' ? '/ar' : lang === 'pt' ? '/pt' : '')
  : '';
const productsHref = prefix + '/products';
// products 页的系列锚点（#ahf / #svg / #asvg）在**全部 5 个语言版本**里都不存在实体：
// 10-08 HTTP 实测 —— /products、/en/products、/es|/ar|/pt/products 渲染后
// id="ahf" / id="svg" / id="asvg" 出现次数均为 0，继续用锚点只会得到死链接。
// en / zh 有独立列表页 → 直接指向；es / ar / pt 无对应页 → 兜底到本语言 products 页（不带锚点）。
// ⚠️ 曾据「es/ar/pt 是单页锚点结构」保留锚点，该前提已被实测证伪（2026-10-08）。
const productsAhfHref = productsHref;   // AHF 无独立页，en/zh 的 /products 即其列表页
const productsSvgHref = (lang === 'en' || lang === 'zh') ? prefix + '/products-svg' : productsHref;
const productsAsvgHref = (lang === 'en' || lang === 'zh') ? prefix + '/products-asvg' : productsHref;
// 产品详情页目前仅英文版存在（/en/products|products-svg|products-asvg/{slug}）。
// en：指向英文详情页；zh：暂无详情页，回退本语言列表（用户未要求改中文）；
// es/ar/pt：英文详情页是唯一存在的详情页，深链到英文（与「卡片链接导向英文详情页」一致）。
const prodDetailHref = (base, slug, fallback) => {
  if (lang === 'en') return prefix + base + '/' + slug;
  if (lang === 'zh') return fallback;
  return isLocal ? '/en' + base + '/' + slug : 'https://en.chitek-inno.com' + base + '/' + slug;
};
// ── 移动端菜单 Products 三级展开数据（2026-10-08）─────────────────────────
// 名称 = 对应汇总页（/en/products、/en/products-svg、/en/products-asvg）卡片的标题，逐字一致；
// 同一详情页只保留首次出现的那条：208V/400V/480V 与 690V/800V 共用 anti-pollution-*、
// IP65 SiC-Fanless 与 SiC-Fanless 共用 sic-fanless-*，故 AHF / SVG / ASVG 各有 8 张卡、去重后均为 6 条。
// ⚠️ 汇总页改卡片文案时此处须同步 —— 回归脚本 00_中转站\nav_mobile_prod\verify_nav_mobile.py 断言逐字一致。
// 详情页目前仅英文版存在，故三级只对 lang === 'en' 渲染；其余语言沿用原来的 3 条平铺链接。
const navProductCards: Record<string, { name: string; slug: string }[]> = {
  ahf: [
    { name: 'Silicon Carbide MOSFET Active Harmonic Filter SiC AHF', slug: 'sic-ultra-ahf' },
    { name: '208V/400V/480V Anti-Pollution Active Harmonic Filter AHF', slug: 'anti-pollution-ahf' },
    { name: 'Ultra-slim Active Harmonic Filter AHF', slug: 'ultra-slim-ahf' },
    { name: 'Distributed Active Harmonic Filter AHF', slug: 'distributed-ahf' },
    { name: 'IP65 SiC-Fanless & Low Noise Active Harmonic Filter', slug: 'sic-fanless-ahf' },
    { name: 'IP65 Active Harmonic Filter', slug: 'ip65-ahf' },
  ],
  svg: [
    { name: 'Silicon Carbide MOSFET Static Var Generator SiC SVG', slug: 'sic-ultra-svg' },
    { name: '208V/400V/480V Anti-Pollution Static Var Generator SVG', slug: 'anti-pollution-svg' },
    { name: 'Ultra-slim Static Var Generator SVG', slug: 'ultra-slim-svg' },
    { name: 'Distributed Static Var Generator SVG', slug: 'distributed-svg' },
    { name: 'IP65 SiC-Fanless & Low Noise Static Var Generator', slug: 'sic-fanless-svg' },
    { name: 'IP65 Static Var Generator', slug: 'ip65-svg' },
  ],
  asvg: [
    { name: 'Silicon Carbide MOSFET Advanced Static Var Generator SiC ASVG', slug: 'sic-ultra-asvg' },
    { name: '208V/400V/480V Anti-Pollution Advanced Static Var Generator ASVG', slug: 'anti-pollution-asvg' },
    { name: 'Ultra-slim Advanced Static Var Generator ASVG', slug: 'ultra-slim-asvg' },
    { name: 'Distributed Advanced Static Var Generator ASVG', slug: 'distributed-asvg' },
    { name: 'IP65 SiC-Fanless & Low Noise Advanced Static Var Generator ASVG', slug: 'sic-fanless-asvg' },
    { name: 'IP65 Advanced Static Var Generator ASVG', slug: 'ip65-asvg' },
  ],
};
const navProductFamilies = [
  { id: 'ahf',  label: _('activeHarmonicFilter'),          base: '/products',      list: productsHref,    cards: navProductCards.ahf },
  { id: 'svg',  label: _('staticVarGenerator'),            base: '/products-svg',  list: productsSvgHref, cards: navProductCards.svg },
  { id: 'asvg', label: _('advancedStaticVarGenerator'),    base: '/products-asvg', list: productsAsvgHref, cards: navProductCards.asvg },
];
const solutionsHref = prefix + '/solutions';
// 解决方案 6 个行业子页只有英文版（/en/solutions/{slug}）；其它语言仍是单页 + 锚点，
// 保持原样指向 hub，避免指向不存在的子页。做法与上面的 productsSvgHref 一致。
const solHref = (slug) => (lang === 'en' ? prefix + '/solutions/' + slug : solutionsHref);
const solIndustryHref   = solHref('industrial');
const solCommercialHref = solHref('commercial');
const solDatacenterHref = solHref('data-center');
const solRenewableHref  = solHref('renewable');
const solRailHref       = solHref('rail-transit');
const solGridHref       = solHref('power-grid');
const servicesHref = prefix + '/services';
const newsHref = prefix + '/news';
const aboutHref = prefix + '/about';
const contactHref = prefix + '/contact';
const homeHref = prefix || '/';
---
<!-- NAV: 桌面导航 + 移动菜单 (共用组件) -->
<style>
  #hamburgerBtn.open > span:nth-child(1) {
    translate: 0 4px;
    rotate: 45deg;
  }
  #hamburgerBtn.open > span:nth-child(2) {
    opacity: 0;
    scale: 0;
  }
  #hamburgerBtn.open > span:nth-child(3) {
    translate: 0 -4px;
    rotate: -45deg;
  }
  .mobile-submenu.open {
    display: flex;
  }
  /* Products 二级项右侧折叠箭头展开时翻转（aria-expanded 由脚本切换） */
  .mobile-subtoggle[aria-expanded="true"] > span {
    rotate: 180deg;
  }
  /* 三级项缩进再多一级，与二级区分 */
  .mobile-submenu .mobile-submenu {
    padding-left: 1rem;
  }
  [dir="rtl"] .lang-item {
    border-left: none;
    border-right-width: 3px;
    border-right-color: transparent;
  }
  [dir="rtl"] .lang-item:hover,
  [dir="rtl"] .lang-item.border-l-brand-orange {
    border-right-color: #EA511E;
  }
  [dir="rtl"] .lang-item.border-l-brand-orange {
    border-right-color: #EA511E;
  }
</style>
<nav class="fixed top-0 left-0 right-0 z-[1000] h-[72px] bg-white/[0.97] backdrop-blur-md border-b border-border-light shadow-sm">
  <div class="w-full h-full flex items-center px-5 md:px-12 gap-6 lg:gap-10">
	  <a href={homeHref} class:list={["flex items-center no-underline", isRtl ? "ml-auto" : "mr-auto"]}>
    <img src="/assets/images/logo.webp" alt="CHITEK Logo" class="w-[140px] h-auto object-contain" />
  </a>

  <button class="flex lg:hidden flex-col justify-center items-center w-10 h-10 cursor-pointer bg-transparent border-none p-0 gap-1.5 shrink-0" id="hamburgerBtn" aria-label={lang === 'pt' ? 'Alternar menu' : 'Toggle menu'}>
    <span class="block w-[22px] h-0.5 bg-text-dark rounded transition-all duration-300 origin-center"></span>
    <span class="block w-[22px] h-0.5 bg-text-dark rounded transition-all duration-300 origin-center"></span>
    <span class="block w-[22px] h-0.5 bg-text-dark rounded transition-all duration-300 origin-center"></span>
  </button>

  <div class="hidden lg:flex gap-1 items-center">
    <!-- Products Dropdown -->
    <div class="group relative flex items-center">
      <a href={productsHref} class="nav-link-base relative text-[14px] font-semibold tracking-[0.08em] no-underline text-[#333333] px-5 py-2 rounded-sm inline-flex items-center whitespace-nowrap hover:text-brand-orange">
        {_('products')}
        <span class="absolute bottom-1 left-4 right-4 h-0.5 bg-brand-orange scale-x-0 origin-left transition-transform duration-200 group-hover:scale-x-100"></span>
      </a>
      <div class:list={[
        "absolute top-full bg-white min-w-[340px] min-h-[210px] flex flex-col justify-center shadow-lg border border-border-light rounded py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible -translate-y-2.5 group-hover:translate-y-0 transition-all duration-300 z-[1001] mt-2 before:content-[''] before:absolute before:top-[-6px] before:w-3 before:h-3 before:bg-white before:border-t before:border-border-light before:rotate-45",
        isRtl ? "right-0 before:right-6 before:border-r before:border-l-0" : "left-0 before:left-6 before:border-l"
      ]}>
        <!-- AHF 项：悬停/聚焦时右侧飞出三组小卡片（图+文，占位文字） -->
        <div class="group/ahf">
          <a href={productsAhfHref} class="block px-6 py-3 text-[#333333] whitespace-nowrap no-underline text-[13px] font-medium tracking-[0.02em] transition-all duration-200 border-l-3 border-transparent hover:bg-[rgba(234,81,30,0.05)] hover:text-brand-orange hover:border-l-brand-orange hover:pl-7">{_('activeHarmonicFilter')}</a>
          <div class:list={[
            "absolute top-0 hidden lg:grid grid-cols-3 gap-3 bg-white shadow-xl border border-border-light rounded-lg p-4 w-[540px] opacity-0 invisible group-hover/ahf:opacity-100 group-hover/ahf:visible group-focus-within/ahf:opacity-100 group-focus-within/ahf:visible transition-all duration-300 z-[1002]",
            isRtl ? "right-full mr-2" : "left-full ml-2"
          ]}>
            <a href={prodDetailHref('/products', 'anti-pollution-ahf', productsAhfHref)} class="group/card block no-underline">
              <img src="/assets/images/products-ahf-anti-pollution.webp" alt="Anti-Pollution Active Harmonic Filter AHF" class="w-full aspect-square object-cover rounded-md" />
              <div class="mt-2 text-[12px] font-semibold text-[#333333] group-hover/card:text-brand-orange">Anti-Pollution AHF</div>
            </a>
            <a href={prodDetailHref('/products', 'sic-ultra-ahf', productsAhfHref)} class="group/card block no-underline">
              <img src="/assets/images/products-ahf-sic.webp" alt="Silicon Carbide MOSFET Active Harmonic Filter SiC AHF" class="w-full aspect-square object-cover rounded-md" />
              <div class="mt-2 text-[12px] font-semibold text-[#333333] group-hover/card:text-brand-orange">SiC AHF</div>
            </a>
            <a href={prodDetailHref('/products', 'ultra-slim-ahf', productsAhfHref)} class="group/card block no-underline">
              <img src="/assets/images/products-ahf-ultra-slim-rackmount.webp" alt="Ultra-slim Active Harmonic Filter AHF" class="w-full aspect-square object-cover rounded-md" />
              <div class="mt-2 text-[12px] font-semibold text-[#333333] group-hover/card:text-brand-orange">Ultra-Slim AHF</div>
            </a>
          </div>
        </div>
        <!-- SVG 项：悬停/聚焦时右侧飞出三组小卡片（占位，内容后补） -->
        <div class="group/svg">
          <a href={productsSvgHref} class="block px-6 py-3 text-[#333333] whitespace-nowrap no-underline text-[13px] font-medium tracking-[0.02em] transition-all duration-200 border-l-3 border-transparent hover:bg-[rgba(234,81,30,0.05)] hover:text-brand-orange hover:border-l-brand-orange hover:pl-7">{_('staticVarGenerator')}</a>
          <div class:list={[
            "absolute top-0 hidden lg:grid grid-cols-3 gap-3 bg-white shadow-xl border border-border-light rounded-lg p-4 w-[540px] opacity-0 invisible group-hover/svg:opacity-100 group-hover/svg:visible group-focus-within/svg:opacity-100 group-focus-within/svg:visible transition-all duration-300 z-[1002]",
            isRtl ? "right-full mr-2" : "left-full ml-2"
          ]}>
            <a href={prodDetailHref('/products-svg', 'anti-pollution-svg', productsSvgHref)} class="group/card block no-underline">
              <img src="/assets/images/products-ahf-anti-pollution.webp" alt="Anti-Pollution Static Var Generator SVG" class="w-full aspect-square object-cover rounded-md" />
              <div class="mt-2 text-[12px] font-semibold text-[#333333] group-hover/card:text-brand-orange">Anti-Pollution SVG</div>
            </a>
            <a href={prodDetailHref('/products-svg', 'sic-ultra-svg', productsSvgHref)} class="group/card block no-underline">
              <img src="/assets/images/products-ahf-sic.webp" alt="Silicon Carbide MOSFET Static Var Generator SiC SVG" class="w-full aspect-square object-cover rounded-md" />
              <div class="mt-2 text-[12px] font-semibold text-[#333333] group-hover/card:text-brand-orange">SiC SVG</div>
            </a>
            <a href={prodDetailHref('/products-svg', 'ultra-slim-svg', productsSvgHref)} class="group/card block no-underline">
              <img src="/assets/images/products-ahf-ultra-slim-rackmount.webp" alt="Ultra-slim Static Var Generator SVG" class="w-full aspect-square object-cover rounded-md" />
              <div class="mt-2 text-[12px] font-semibold text-[#333333] group-hover/card:text-brand-orange">Ultra-Slim SVG</div>
            </a>
          </div>
        </div>
        <!-- ASVG 项：悬停/聚焦时右侧飞出三组小卡片（占位，内容后补） -->
        <div class="group/sic">
          <a href={productsAsvgHref} class="block px-6 py-3 text-[#333333] whitespace-nowrap no-underline text-[13px] font-medium tracking-[0.02em] transition-all duration-200 border-l-3 border-transparent hover:bg-[rgba(234,81,30,0.05)] hover:text-brand-orange hover:border-l-brand-orange hover:pl-7">{_('advancedStaticVarGenerator')}</a>
          <div class:list={[
            "absolute top-0 hidden lg:grid grid-cols-3 gap-3 bg-white shadow-xl border border-border-light rounded-lg p-4 w-[540px] opacity-0 invisible group-hover/sic:opacity-100 group-hover/sic:visible group-focus-within/sic:opacity-100 group-focus-within/sic:visible transition-all duration-300 z-[1002]",
            isRtl ? "right-full mr-2" : "left-full ml-2"
          ]}>
            <a href={prodDetailHref('/products-asvg', 'anti-pollution-asvg', productsAsvgHref)} class="group/card block no-underline">
              <img src="/assets/images/products-ahf-anti-pollution.webp" alt="Anti-Pollution Advanced Static Var Generator ASVG" class="w-full aspect-square object-cover rounded-md" />
              <div class="mt-2 text-[12px] font-semibold text-[#333333] group-hover/card:text-brand-orange">Anti-Pollution ASVG</div>
            </a>
