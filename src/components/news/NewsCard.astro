---
export interface Props {
  href: string;
  img: string;
  alt: string;
  category: string;
  cat: string;
  date: string;
  title: string;
  desc: string;
  readMore: string;
}

const { href, img, alt, category, cat, date, title, desc, readMore } = Astro.props;

// Static class strings live here (not in the data file) so Tailwind can see them.
const CHIP_CLASS: Record<string, string> = {
  tech: 'text-xs font-semibold text-brand-orange bg-brand-orange/10 px-3 py-1 rounded-full',
  case: 'text-xs font-semibold text-green-600 bg-green-50 px-3 py-1 rounded-full',
  product: 'text-xs font-semibold text-purple-600 bg-purple-50 px-3 py-1 rounded-full',
  industry: 'text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1 rounded-full',
  sustain: 'text-xs font-semibold text-cyan-600 bg-cyan-50 px-3 py-1 rounded-full',
};

const chip = CHIP_CLASS[cat] || CHIP_CLASS.tech;
---

<a href={href} class="group bg-white rounded-xl overflow-hidden border border-border-light hover:shadow-xl transition-all duration-300 flex flex-col md:flex-row no-underline">
  <div class="relative w-full md:w-[320px] lg:w-[380px] h-48 md:h-64 bg-gray-50 overflow-hidden shrink-0">
    <img src={img} alt={alt} class="w-full h-full object-cover" loading="lazy" />
  </div>
  <div class="p-6 md:p-8 flex flex-col justify-center flex-1">
    <div class="flex items-center gap-3 mb-3">
      <span class={chip}>{category}</span>
      <span class="text-xs text-text-muted">{date}</span>
    </div>
    <h2 class="text-xl font-bold text-text-dark mb-3 group-hover:text-brand-orange transition-colors">{title}</h2>
    <p class="text-text-mid text-sm leading-relaxed mb-4">{desc}</p>
    <span class="inline-flex items-center text-brand-orange text-sm font-semibold">
      {readMore}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 ml-1">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</a>
