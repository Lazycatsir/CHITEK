---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { getHreflang, LOCALE_DOMAIN, type Locale } from '../i18n/index';

export interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'pt' | 'es' | 'ar' | 'zh';
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  ogType?: 'website' | 'article';
  /** Set false on pages with no equivalent in the other languages (e.g. /en/news/page_2/) */
  alternates?: boolean;
  /** Set when the page exists in only some languages (e.g. news exists in zh/en/es/ar but not pt) */
  alternateLangs?: string[];
}

const { title, description, lang = 'en', ogTitle, ogDescription, ogImage, ogUrl, ogType = 'website', alternates = true, alternateLangs } = Astro.props;

const ALL_LOCALES: Locale[] = ['zh', 'en', 'pt', 'es', 'ar'];
const altLangs: Locale[] = alternateLangs && alternateLangs.length ? (alternateLangs as Locale[]) : ALL_LOCALES;
const xDefault: Locale = altLangs.includes('zh') ? 'zh' : altLangs[0];

const currentPath = Astro.url.pathname;
const canonicalUrl = ogUrl || getHreflang(lang as Locale, currentPath);

/* ── 2026-10-08 裁定（审计 P1-3 方案 A）：全站绝对 URL 统一到「本页自己的语言域」──
   此前 canonical 用语言子域、而 Organization / WebSite / OG 用根域，同页两个 host。
   现在一律取 LOCALE_DOMAIN[lang]，与 <link rel="canonical"> 完全同 host。
   （zh 的 canonical host 就是那个不带语言前缀的根域，故 zh 无变化） */
const siteOrigin = LOCALE_DOMAIN[lang as Locale];

const defaultOgImage = `${siteOrigin}/assets/images/logo.webp`;

/* ── 2026-10-15 Phase1-1.3：关键字体 preload ──
   只 preload「拉丁/Barlow」这类小文件（~16-20KB）。
   刻意不 preload OPPO Sans SC：单个 CJK 字重 1.06-1.09MB，zh 站 preload 它
   会和 LCP 图抢移动端带宽，反而拖慢首屏。zh 站的 CJK 字体交给
   font-display:swap 的正常按需加载（见 global.css）。 */
const preloadFont = lang === 'ar'
  ? '/assets/fonts/Barlow-400.woff2'
  : (lang === 'zh' ? null : '/assets/fonts/OPPOSans-400.woff2');

/* 社交账号 = Footer 第 1/2/3 个图标（2026-10-08 裁定的单一来源）。
   注：contact 页的 Facebook / Twitter / Instagram 三图标当前是 data-social-temp 占位
   （暂指 LinkedIn），真主页 URL 到位后需同时更新此数组 + Footer + contact 三处。 */
const SOCIAL_PROFILES = [
  'https://www.linkedin.com/in/yongkai-li/',
  'https://www.youtube.com/@CHITEKNewEnergyTechnology',
  'https://www.facebook.com/profile.php?id=61579260405315',
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'CHITEK INNOPOWER',
  url: siteOrigin,
  logo: `${siteOrigin}/assets/images/logo.webp`,
  description: 'Leading manufacturer of low-voltage power quality solutions — Active Harmonic Filter (AHF) and Static Var Generator (SVG).',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+86-18818994346',
    contactType: 'sales',
    availableLanguage: ['English', 'Portuguese', 'Spanish', 'Arabic', 'Chinese'],
  },
  sameAs: SOCIAL_PROFILES,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CHITEK INNOPOWER',
  url: siteOrigin,
  description: 'B2B industrial power quality solutions manufacturer — AHF and SVG for global industrial and commercial applications.',
  inLanguage: ['en', 'pt', 'es', 'ar', 'zh'],
};
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- Phase1-1.3：关键字体 preload（仅小体积拉丁字体，zh 的 CJK 字体不 preload） -->
  {preloadFont && (
    <link rel="preload" href={preloadFont} as="font" type="font/woff2" crossorigin />
  )}
  <!-- Bing Webmaster Tools 站点验证（全语言/全子域通用，与 public/BingSiteAuth.xml 互为备份） -->
  <meta name="msvalidate.01" content="97E3493522EEB269E495058E6ECCE683" />
  <!-- Favicon：主图标用 logo-head.svg（C 字标，现代浏览器原生支持）；PNG 为 Safari/iOS 兜底 -->
  <link rel="icon" href="/assets/images/logo-head.svg" type="image/svg+xml" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="64x64" href="/assets/images/favicon-64.png" />
  <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Alternate language links (skipped when the page has no sibling in other languages) -->
  {alternates && (
    <>
      {altLangs.map((l) => (
        <link rel="alternate" hreflang={l} href={getHreflang(l, currentPath)} />
      ))}
      <link rel="alternate" hreflang="x-default" href={getHreflang(xDefault, currentPath)} />
    </>
  )}

  <!-- Open Graph -->
  <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : lang === 'es' ? 'es_ES' : lang === 'ar' ? 'ar_SA' : lang === 'zh' ? 'zh_CN' : 'en_US'} />
  <meta property="og:title" content={ogTitle || title} />
  <meta property="og:description" content={ogDescription || description} />
  <meta property="og:image" content={ogImage || defaultOgImage} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="CHITEK INNOPOWER" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle || title} />
  <meta name="twitter:description" content={ogDescription || description} />

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema, null, 2)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema, null, 2)} />

  <!-- Google Analytics (GA4) — only on non-Chinese languages; zh is excluded (Google blocked in mainland + PIPL) -->
  {lang !== 'zh' && (
    <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HVJS1DXF00"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-HVJS1DXF00');
      </script>
    </>
  )}

  <!-- Baidu Tongji — Chinese site only (zh); data stays in mainland, PIPL-friendly. Non-zh uses GA4 instead. -->
  {lang === 'zh' && (
    <script is:inline>
      var _hmt = _hmt || [];
      (function() {
        var hm = document.createElement("script");
        hm.src = "https://hm.baidu.com/hm.js?3b9dceb779c78363e60cb3aba11959bd";
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
  )}

  <!-- Conversion & event tracking (GA4 for non-zh, Baidu Tongji for zh) -->
  <script is:inline src="/assets/js/analytics.js" defer></script>
  <slot name="head" />
</head>
<body class="font-barlow text-text-dark bg-white overflow-x-hidden min-h-screen flex flex-col">
  <Nav lang={lang} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer lang={lang} />
  <Sidebar lang={lang} />

  <!-- Shared scroll animation -->
  <script>
    (function() {
      'use strict';
      function initScrollAnimation() {
        var observer = new IntersectionObserver(
          function(entries) {
            entries.forEach(function(e) {
              if (e.isIntersecting) e.target.classList.add('visible');
            });
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll('.fade-up').forEach(function(el) {
          observer.observe(el);
        });
        setTimeout(function() {
          document.querySelectorAll('.hero .fade-up').forEach(function(el) {
            el.classList.add('visible');
          });
        }, 100);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollAnimation);
      } else {
        initScrollAnimation();
      }
    })();
  </script>
</body>
</html>
