---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = {
  title: 'CHITEK — مولد فار الثابت منخفض الجهد (SVG) | تصحيح معامل القدرة',
  description: 'يقدم مولد فار الثابت (SVG) من تشايتك تعويضًا تفاعليًا بلا خطوات وتصحيحًا لمعامل القدرة لشبكات منخفضة الجهد — سلاسل حائطية ورفية وموزعة وIP65.',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/ar' + p : p;
---

<BaseLayout lang="ar" title={meta.title} description={meta.description}>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": "https://en.chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "المنتجات", "item": "https://en.chitek-inno.com/products" },
      { "@type": "ListItem", "position": 3, "name": "مولد فار الثابت" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "سلسلة مولدات فار الثابتة (SVG)",
    "numberOfItems": 8,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "موسفت كربيد السيليكون مولد الفولت أمبير الساكن SiC", "url": "https://en.chitek-inno.com/products-svg/sic-ultra-svg" },
      { "@type": "ListItem", "position": 2, "name": "208V/400V/480V مولد الفولت أمبير الساكن مضاد للتلوث", "url": "https://en.chitek-inno.com/products-svg/anti-pollution-svg" },
