---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="ar" alternates={false} title="الصفحة غير موجودة – CHITEK INNOPOWER" description="الصفحة التي تبحث عنها غير موجودة. عد إلى الصفحة الرئيسية أو استعرض منتجاتنا.">
  <section class="min-h-screen flex flex-col items-center justify-center text-center px-6 mt-[72px]">
    <h1 class="font-barlow-condensed text-[clamp(72px,12vw,160px)] font-bold text-brand-orange leading-[1] mb-4">404</h1>
    <p class="text-[clamp(16px,1.5vw,24px)] text-text-dark font-medium mb-8">الصفحة غير موجودة</p>
    <p class="text-text-muted max-w-md mb-10">ربما تم نقل الصفحة التي تبحث عنها أو حذفها. دعنا نعيدك إلى المسار الصحيح.</p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="/ar" class="bg-brand-orange text-white text-[13px] font-semibold tracking-[0.06em] uppercase px-7 py-3.5 rounded-sm no-underline hover:bg-brand-orange-dark transition-colors duration-200">العودة إلى الصفحة الرئيسية</a>
      <a href="/ar/products" class="bg-white text-brand-orange border border-brand-orange text-[13px] font-semibold tracking-[0.06em] uppercase px-7 py-3.5 rounded-sm no-underline hover:bg-brand-orange hover:text-white transition-colors duration-200">تفاصيل المنتجات</a>
    </div>
  </section>
</BaseLayout>
