---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';

const article = {
  title: "كربيد السيليكون في مرشحات AHF: لماذا يُعيد المفتاح ذو الفجوة العريضة تعريف أداء LV AHF",
  category: "تحديث المنتج",
  date: "2026-07-18",
  dateDisplay: "18 يوليو 2026",
  author: "فريق CHITEK الفني",
  readTime: "4 دقائق قراءة",
  description: "كان الـ AHF دائماً محدوداً بالمفتاح الذي بُني عليه. تغيّر SiC MOSFET السقف. يقدر هذا المقال ما يمنحه أشباه الموصل ذو الفجوة العريضة لـ AHF منخفض الجهد وأين لا يزال IGBT له مكانه.",
  keywords: [    "SiC",
      "كربيد السيليكون",
      "AHF",
      "IGBT",
      "فجوة عريضة",
      "كفاءة",
      "كثافة قدرة",
      "CHITEK"]
};

const otherArticles = [
    { title: "تعزيز موثوقية مرشح AHF بطلاء كونفورمال", category: "تقنية", href: "/news/conformal-coating-ahf-reliability", color: "orange" },
    { title: "مرشحات AHF مقابل مفاعلات الخط", category: "تقنية", href: "/news/blog-ahf-vs-line-reactors", color: "orange" },
    { title: "AHF لأنظمة VFD", category: "تقنية", href: "/news/blog-active-harmonic-filter-for-vfd-systems", color: "orange" }
];
const relatedProducts = [
    { name: "مرشح الموجة النشط AHF", href: "/products#ahf", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
    { name: "مولد فار الساكن SVG", href: "/products#svg", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
    { name: "سلسلة SiC-AHF/SVG عالية الكفاءة", href: "/products#sic", icon: "M13 10V3L4 14h7v7l9-11h-7z" }
];
const relatedCases = [
    { name: "مركز بيانات في البرازيل", industry: "مراكز البيانات" },
    { name: "مصنع صناعي في السعودية", industry: "التصنيع" },
    { name: "مزرعة طاقة شمسية 50 ميجاواط في دبي", industry: "الطاقة المتجددة" }
];

const lp = (p) => p;

---
<BaseLayout
  title={`${article.title} | CHITEK INNOPOWER`}
  description={article.description}
  lang="ar"
  ogType="article"
  ogTitle={article.title}
  ogDescription={article.description}
  ogImage="https://chitek-inno.com/assets/images/news/news-img-5.webp"
>
  <!-- Schema.org Article Structured Data -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "كربيد السيليكون في مرشحات AHF: لماذا يُعيد المفتاح ذو الفجوة العريضة تعريف أداء LV AHF",
    "description": "كان الـ AHF دائماً محدوداً بالمفتاح الذي بُني عليه. تغيّر SiC MOSFET السقف. يقدر هذا المقال ما يمنحه أشباه الموصل ذو الفجوة العريضة لـ AHF منخفض الجهد وأين لا يزال IGBT له مكانه.",
    "image": "https://chitek-inno.com/assets/images/news/news-img-5.webp",
    "author": {"@type": "Organization","name": "فريق CHITEK الفني"},
    "publisher": {"@type": "Organization","name": "CHITEK INNOPOWER","logo": {"@type": "ImageObject","url": "https://chitek-inno.com/assets/images/logo.webp"}},
    "datePublished": "2026-07-18",
    "dateModified": "2026-07-18",
    "keywords": "SiC كربيد السيليكون AHF IGBT فجوة عريضة كفاءة"
  }
  </script>

  <Sidebar lang="ar" />

  <!-- Article Header -->
  <section class="pt-[72px] bg-bg-dark text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-orange/20 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 py-16 md:py-20">
      <a href={lp('/news')} class="inline-flex items-center text-brand-orange text-sm font-semibold mb-6 hover:underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 mr-2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        العودة إلى الأخبار
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold text-brand-orange bg-brand-orange/10 px-3 py-1 rounded-full">تحديث المنتج</span>
        <span class="text-xs text-gray-400">18 يوليو 2026</span>
        <span class="text-xs text-gray-400">&middot;</span>
        <span class="text-xs text-gray-400">4 دقائق قراءة</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-[family-name:var(--font-barlow-condensed)] tracking-tight max-w-4xl">
        كربيد السيليكون في مرشحات AHF: لماذا يُعيد المفتاح ذو الفجوة العريضة تعريف أداء LV AHF
      </h1>
    </div>
  </section>

  <!-- Article Content + Sidebar -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-12 flex flex-col lg:flex-row gap-10">

      <!-- Main Content -->
      <article class="flex-1 max-w-4xl">
        <!-- Featured Image -->
        <div class="w-full h-64 md:h-96 rounded-xl overflow-hidden mb-10 bg-gray-50">
          <img src="/assets/images/news/news-img-5.webp" alt="كربيد السيليكون في مرشحات AHF: لماذا يُعيد المفتاح ذو الفجوة العريضة تعريف أداء LV AHF" class="w-full h-full object-cover" loading="eager" />
        </div>

        <div class="prose prose-lg max-w-none">
<p class="text-text-mid text-lg leading-relaxed mb-6">كان مرشح الموجة النشط (AHF) دائماً محدوداً بالمفتاح الذي بُني عليه. لعقود كان ذلك المفتاح IGBT السيليكون —فعال لكن محصور بفيزياء السيليكون. يغيّر SiC MOSFET السقف. يقدر هذا المقال ما يمنحه أشباه الموصل ذو الفجوة العريضة لـ AHF منخفض الجهد وأين لا يزال IGBT له مكانه.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">سقف IGBT</h2>
<p class="text-text-mid leading-relaxed mb-3">يستخدم AHF LV التقليدي IGBT بوصلة <strong>150°C</strong>، يبدّل عادة <strong>دون 20 kHz</strong>.</p>
<p class="text-text-mid leading-relaxed mb-3">• <strong>حد النطاق:</strong> تُركّب تيار التعويض عند f_sw؛ الرتب العالية (13 و17 و25…) التي ينظفها محصورة بسرعة التبديل.</p>
<p class="text-text-mid leading-relaxed mb-6">• <strong>التكلفة الحرارية:</strong> تزداد خسارة التبديل مع التردد؛ للبقاء تحت 150°C تُضاف مشتتات ومراوح تكبر الخزانة.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">ماذا يغيّر SiC فعلاً</h2>
<p class="text-text-mid leading-relaxed mb-2">• <strong>فجوة النطاق:</strong> <strong>3.26 eV مقابل 1.12 eV</strong> للسيليكون.</p>
<p class="text-text-mid leading-relaxed mb-2">• <strong>حرارة الوصلة:</strong> حتى <strong>200°C</strong> مقابل 150°C لـ IGBT.</p>
<p class="text-text-mid leading-relaxed mb-2">• <strong>حقل الانهيار:</strong> ~<strong>10×</strong> السيليكون.</p>
<p class="text-text-mid leading-relaxed mb-2">• <strong>تردد التبديل:</strong> <strong>2–3× IGBT</strong>.</p>
<p class="text-text-mid leading-relaxed mb-6">• <strong>خسارة التبديل:</strong> ~<strong>50% أقل</strong>، ترفع الكفاءة <strong>1–3%</strong>.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">عائد الـ AHF</h2>
<p class="text-text-mid leading-relaxed mb-2">1. <strong>نطاق إلغاء أوسع.</strong> f_sw أعلى تعالج الرتبة 13 فما فوق —الفرق بين تنظيف جزئي وكامل.</p>
<p class="text-text-mid leading-relaxed mb-2">2. <strong>خزانة أصغر وأبرد.</strong> فقد أقل ووصلة 200°C تصغر النظام الحراري.</p>
<p class="text-text-mid leading-relaxed mb-2">3. <strong>الكفاءة.</strong> 1–3% أقل فقداً هو تكلفة تشغيل الـ AHF المزالة.</p>
<p class="text-text-mid leading-relaxed mb-6">4. <strong>الموثوقية.</strong> تشغيل أبرد يطيل العمر ويسمح بمراوح أبطأ.</p>
<p class="text-text-mid leading-relaxed mb-6">قانون التعويض لا يتغير: <strong>i_c* = i_L − i_s(الأساسية)</strong> —SiC ينفذه أسرع وعلى نطاق أوسع، متابعاً في <strong>&lt; 1 ms</strong> ومخفضاً THDi من <strong>30%+ إلى &lt; 5%</strong> عبر رتب أكثر.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">متى لا يزال IGBT يفوز</h2>
<p class="text-text-mid leading-relaxed mb-6">ليست استبدالاً كلياً. في بيئات صناعية قياسية بطيف متوقع حيث يسود تكلفة أولية، يبقى IGBT AHF خياراً متيناً اقتصادياً. يستحق SiC تكلفته حيث يكون الفضاء والتوفير طويل الأمد والأداء العالي هم القيد —مراكز بيانات كثيفة وغرف مفاتيح مدمجة.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">الخلاصة</h2>
<p class="text-text-mid leading-relaxed mb-6">لا يجعل SiC الـ IGBT AHF قديمًا؛ بل يرفع السقف للحالات التي تحتاجه. بنيت منصة CHITEK LV AHF حول مسار الترقية IGBT→SiC —نفس المبدأ ونطاق أوسع وحجم أصغر وتشغيل أبرد.</p>
<p class="text-text-mid leading-relaxed mb-6">ما أعلى رتبة توافقية يولدها ناقلك فعلاً —وهل AHF لديك مصنّف لإلغائها؟</p>
        </div>

        <!-- SEO Keywords -->
        <div class="mt-10 pt-6 border-t border-border-light">
          <div class="flex flex-wrap gap-2">
            {article.keywords.map((keyword) => (
              <span class="text-xs text-text-muted bg-gray-100 px-3 py-1 rounded-full">#{keyword}</span>
            ))}
          </div>
        </div>

        <!-- Author & Share -->
        <div class="mt-12 pt-8 border-t border-border-light">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-orange to-brand-orange-dark flex items-center justify-center text-white font-bold text-lg">C</div>
              <div>
                <p class="font-semibold text-text-dark">فريق CHITEK الفني</p>
                <p class="text-sm text-text-muted">4 دقائق قراءة</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm text-text-muted">مشاركة:</span>
              <button class="w-8 h-8 rounded-full bg-gray-100 hover:bg-brand-orange hover:text-white transition-colors flex items-center justify-center text-sm" aria-label="Share">&#x2197;</button>
            </div>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="lg:w-[320px] shrink-0">
        <div class="lg:sticky lg:top-[88px] space-y-4">

          <!-- Other Articles -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              المقالات
            </h3>
            <div class="space-y-2">
              {otherArticles.map((item) => (
                <a href={lp(item.href)} class="block p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="text-sm font-semibold text-text-dark leading-snug">{item.title}</div>
                </a>
              ))}
            </div>
          </div>

          <!-- Related Products -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
              المنتجات ذات الصلة
            </h3>
            <div class="space-y-2">
              {relatedProducts.map((item) => (
                <a href={item.href} class="flex items-center gap-3 p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange shrink-0"><path d="{item.icon}"/></svg>
                  <span class="text-sm font-semibold text-text-dark leading-snug">{item.name}</span>
                </a>
              ))}
            </div>
          </div>

          <!-- Customer Cases -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              حالات العملاء
            </h3>
            <div class="space-y-2">
              {relatedCases.map((item) => (
                <div class="p-2.5 bg-white rounded-lg border border-border-light">
                  <div class="text-sm font-semibold text-text-dark leading-snug">{item.name}</div>
                  <div class="text-xs text-text-muted mt-1">{item.industry}</div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </aside>

    </div>
  </section>
</BaseLayout>
