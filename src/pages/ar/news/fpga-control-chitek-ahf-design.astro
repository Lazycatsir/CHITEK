  }
  </script>

  <Sidebar lang="ar" />

  <section class="pt-[72px] bg-bg-dark text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-orange/20 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 py-16 md:py-20">
      <a href="/ar/news" class="inline-flex items-center text-brand-orange text-sm font-semibold mb-6 hover:underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 mr-2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        العودة إلى الأخبار
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold text-brand-orange bg-brand-orange/20 px-3 py-1 rounded-full">{article.category}</span>
        <span class="text-xs text-gray-400">{article.dateDisplay}</span>
        <span class="text-xs text-gray-400">·</span>
        <span class="text-xs text-gray-400">{article.readTime}</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-[family-name:var(--font-barlow-condensed)] tracking-tight max-w-4xl">
        {article.title}
      </h1>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-12 flex flex-col lg:flex-row gap-10">

      <article class="flex-1 max-w-4xl">
        <div class="w-full h-64 md:h-96 rounded-xl overflow-hidden mb-10 bg-gray-50">
          <img src="/assets/images/news/news-img-5.webp" alt="تحكم FPGA في تصميم المرشح النشط للتوافقيات CHITEK" class="w-full h-full object-cover" loading="eager" />
        </div>

        <div class="prose prose-lg max-w-none">
<p class="text-text-mid text-lg leading-relaxed mb-6">المرشح النشط للتوافقيات لا يتعدى سقف أدائه حدود حلقة التحكم الخاصة به. يجب على المرشح أن يكشف التيار التوافقي ويحسب مرجعًا عكسي الطور ويُبدّل IGBT أو SiC MOSFET قبل أن يتقدم تيار الحمل — وكل ذلك ضمن كسر من دورة الشبكة. في تصميم المرشح النشط للتوافقيات من CHITEK، تعمل هذه الحلقة على FPGA، واختيار السيليكون يحدد سقف ما تستطيع الحلقة فعله. يتناول هذا المقال سلسلة التحكم وميزانية التوقيت وسبب قصور التصاميم المعتمدة على DSP، وكيفية تحديد مرشح AHF خاضع لتحكم FPGA ووضعه في الخدمة إلى جانب مولد التيار المتغير الثابت.</p>
<h2 id="what-the-control-loop-must-do" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">ماذا يجب أن تفعل حلقة التحكم</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">ينفّذ كل AHF ثلاث مهام بالتتابع، وتستهلك كل واحدة وقتًا من نفس الميزانية:</p>
<ul class="list-disc list-inside space-y-2 mb-6 text-text-mid leading-relaxed"><li><strong class="font-semibold text-text-dark">كشف التوافقيات</strong> — استخراج المحتوى التوافقي من تيار الحمل المقاس باستخدام FFT أو نظرية القدرة اللحظية (نظرية pq).</li><li><strong class="font-semibold text-text-dark">توليد المرجع</strong> — عكس ذلك المحتوى لإنتاج أمر تيار التعويض i_c*.</li><li><strong class="font-semibold text-text-dark">تركيب PWM</strong> — تبديل جسر القدرة بحيث يتبع التيار الخارجي i_c* ضمن نطاق التموج.</li></ul>
<p class="text-text-mid text-lg leading-relaxed mb-6">الأمر في حد ذاته بسيط الصياغة:</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">i_c* = i_L − i_s(الأساسي)</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">الصعوبة أن i_L يتغير باستمرار. تنتج الواجهة الأمامية المُقوّية في مُحوّل السرعة المتغيرة نقطة قفز في التيار عند كل تبديل، ولدى المرشح تقريبًا <strong class="font-semibold text-text-dark">فترة تبديل واحدة</strong> للاستجابة قبل أن يتكامل الخطأ في تشوه مرئي.</p>
<h2 id="how-fpga-control-is-quantified" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">كيف يُقاس تحكم FPGA</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">المقياس المهم هو زمن حلقة التحكم: الزمن من تغيّر في تيار الحمل إلى تغيّر مناظر في تيار خرج المرشح. في تصميم معتمد على DSP، يتراكم أخذ العينات ودخول المقاطعة والحساب المتسلسل وتحديث PWM عادةً إلى عشرات الميكروثوانيات. تنفّذ FPGA كشف التوافقيات ورياضيات المرجع في عتاد متوازٍ، لذا ينخفض الزمن إلى نطاق <strong class="font-semibold text-text-dark">الميكروثانية</strong>.</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">هامش التوافقيات هو ما يسمح للمرشح بتتبّع التوافقيات 5 و7 و11 و13 — المرات المهيمنة من مُقوٍّ سداسي النبضات — دون مهلة طور عند تردد التبديل. كما يحدد زمن التأخير عرض نطاق التحكم القابل للتحقيق، وعرض النطاق يحدد سرعة رفض الحلقة للاضطراب.</p>
<h2 id="major-causes-of-poor-harmonic-compensation" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">الأسباب الرئيسية لسوء تعويض التوافقيات</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">عندما يُحرز AHF أداءً دون المتوقع في الموقع، يكون السبب عادةً أحد التالي:</p>
<ul class="list-disc list-inside space-y-2 mb-6 text-text-mid leading-relaxed"><li><strong class="font-semibold text-text-dark">زمن تأخر التحكم</strong> — حلقة بطيئة تترك خطأً متبقيًا يظهر كـ THDi مرتفع عند PCC.</li><li><strong class="font-semibold text-text-dark">خطأ الكشف</strong> — PLL يفقد القفل أثناء تشوه الجهد يخطئ في تحديد الأساسي ويعيد توزيع المحتوى التوافقي خطأً.</li><li><strong class="font-semibold text-text-dark">تذبذب توقيت PWM</strong> — توقيت بوابة غير دقيق يوسع تموج تيار الخرج ويبدد هامش التبديل.</li><li><strong class="font-semibold text-text-dark">التشبع</strong> — ينفد المرشح من سعة التيار عند ذروات الحمل ويتوقف عن التعويض.</li><li><strong class="font-semibold text-text-dark">الرنين مع المكثفات القائمة</strong> — يتفاعل المرشح مع بنك قريب فيُنتج تضخيمًا بدل الإلغاء.</li></ul>
<h2 id="what-it-costs" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">ما كلفته</h2>
<ul class="list-disc list-inside space-y-2 mb-6 text-text-mid leading-relaxed"><li><strong class="font-semibold text-text-dark">غرامات المرافق</strong> — يفرض IEEE 519 وGB/T حدودًا على تشوه الجهد والتيار عند PCC؛ وTHDi متبقٍ فوق الحد رسم متكرر.</li><li><strong class="font-semibold text-text-dark">تسخين المحول والكابل</strong> — يرفع تيار التوافقيات خسائر I²R ويخفض السعة.</li><li><strong class="font-semibold text-text-dark">فشل المكثفات</strong> — تُسرّع الجهود الغنية بالتوافقيات شيخوخة العازل الكهربائي في بنوك تصحيح معامل القدرة.</li><li><strong class="font-semibold text-text-dark">القطع الإزعاجي</strong> — تشوّه الجهد يُربك مرحل الحماية والمحولات.</li></ul>
<h2 id="why-dsp-based-control-falls-short" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">لماذا يُخفق التحكم المعتمد على DSP</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">تنفّذ DSP خوارزمية الكشف وحساب المرجع وتحديث PWM بالتتابع. تنتظر كل خطوة السابقة، وتضيف كل مقاطعة حملًا إضافيًا. النتيجة حلقة سريعة بما يكفي للأحمال المتغيرة ببطء لكنها تتأخر عن محوّل يُبدّل كل بضع مئات من الميكروثوانيات.</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">رفع تردد ساعة DSP لا يفيد إلا هامشيًا، لأن العنق ضيق معماري لا ترددي. المعالج الأسرع ما زال ينفّذ تعليمة واحدة في كل مرة. نقل نفس الرياضيات إلى بنية FPGA يُزيل التسلسل تمامًا.</p>
<h2 id="how-fpga-control-fixes-it" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">كيف يصلح تحكم FPGA الأمر</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">تقسّم FPGA سلسلة التحكم إلى كتل عتادية متوازية تعمل جميعها في نفس دورة الساعة. يتقدّم الكشف وتوليد المرجع ومقارنة PWM في آنٍ واحد لا بالتناوب.</p>
<ul class="list-disc list-inside space-y-2 mb-6 text-text-mid leading-relaxed"><li><strong class="font-semibold text-text-dark">كشف متوازٍ</strong> — تُعالج كتل FFT أو نظرية pq جميع الأطوار دفعة واحدة، دون مورد تنفيذ مشترك.</li><li><strong class="font-semibold text-text-dark">PWM حتمي</strong> — تُولّد إشارات البوابة في العتاد، لذا يحدّ تذبذب التوقيت الساعة لا جدولة البرنامج.</li><li><strong class="font-semibold text-text-dark">تغذية راجعة مغلقة</strong> — تُقارن تيار الخرج المقاس بـ i_c* كل فترة تبديل، ويُصحّح الخطأ قبل أن يتراكم.</li></ul>
<p class="text-text-mid text-lg leading-relaxed mb-6">في تصميم المرشح النشط للتوافقيات من CHITEK، تخفض هذه البنية THDi عند PCC من <strong class="font-semibold text-text-dark">30%+ إلى &lt; 5%</strong>، مع تعويض يتبع الحمل في <strong class="font-semibold text-text-dark">&lt; 1 ms</strong>. وتقود المنصة نفسها CHITEK SVG، حيث يحافظ حقن التيار التفاعلي لكل طور على معامل القدرة عند <strong class="font-semibold text-text-dark">0,99+</strong> ويعيد توازن تيار التسلسل السالب الذي لا يبلغه بنك ثابت.</p>
<h2 id="igbt-vs-sic" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">IGBT مقابل SiC</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">لا تستطيع حلقة التحكم استغلال سرعة التبديل التي يسمح بها المسرح القدري إلا. تقتصر وحدات AHF ومولد التيار المتغير الثابت التقليدية المعتمدة على IGBT عند نحو <strong class="font-semibold text-text-dark">150 °C</strong> لحرارة الوصلة، وتُبدّل عادةً دون <strong class="font-semibold text-text-dark">20 kHz</strong>. يرفع SiC MOSFET حد الوصلة إلى نحو <strong class="font-semibold text-text-dark">200 °C</strong>، ويوفر نحو <strong class="font-semibold text-text-dark">10×</strong> من صلابة الانهيار، ويدعم <strong class="font-semibold text-text-dark">2–3×</strong> من تردد التبديل مع خسارة تبديل أقل بنحو <strong class="font-semibold text-text-dark">50%</strong>.</p>
<div class="overflow-x-auto mb-6"><table class="w-full border-collapse"><thead><tr class="bg-gray-50"><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">المعلمة</th><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">مسرح IGBT</th><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">مسرح SiC MOSFET</th></tr></thead><tbody><tr><td class="p-4 border-b border-border-light text-text-mid font-medium">حرارة الوصلة</td><td class="p-4 border-b border-border-light text-text-mid font-medium">~150 °C</td><td class="p-4 border-b border-border-light text-text-mid font-medium">~200 °C</td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium">تردد التبديل النموذجي</td><td class="p-4 border-b border-border-light text-text-mid font-medium">&lt; 20 kHz</td><td class="p-4 border-b border-border-light text-text-mid font-medium">2–3× أعلى</td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium">خسارة التبديل</td><td class="p-4 border-b border-border-light text-text-mid font-medium">أساس</td><td class="p-4 border-b border-border-light text-text-mid font-medium">~50% أقل</td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium">هامش عرض نطاق التحكم</td><td class="p-4 border-b border-border-light text-text-mid font-medium">محدود</td><td class="p-4 border-b border-border-light text-text-mid font-medium">واسع</td></tr></tbody></table></div>
<p class="text-text-mid text-lg leading-relaxed mb-6">الأثر العملي حلقة داخلية أسرع وفلتر خرج أصغر وخزانة أضيق لنفس تيار التعويض. تلك هي الوجهة التي بُنيت عليها منصة CHITEK LV AHF + SVG.</p>
<h2 id="engineering-deployment-checklist" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">قائمة التحقق من النشر الهندسي</h2>
<ol class="list-decimal list-inside space-y-2 mb-6 text-text-mid leading-relaxed"><li>قس تيار الحمل وجهد PCC عبر دورة عمل كاملة؛ سجّل الطيف التوافقي وأسوأ THDi.</li><li>أكّد المرات التوافقية المهيمنة وحدّد سعة تيار المرشح لتغطيتها بهامش <strong class="font-semibold text-text-dark">15–25%</strong>.</li><li>تحقق من زمن تأخر حلقة التحكم مقابل أسرع خطوة حمل متوقعة في الموقع.</li><li>راجع بنوك المكثفات القائمة من الرنين قبل التشغيل.</li><li>افحص هامش الشبكة الضعيفة وتأكد أن المرشح يحافظ على التنظيم عند أسوأ هبوط جهد.</li><li>بعد التشغيل، أعد قياس THDi عند PCC مقابل حدود IEEE 519 وGB/T.</li></ol>
<h2 id="typical-application-profiles" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">ملامح التطبيق النموذجية</h2>
<ul class="list-disc list-inside space-y-2 mb-6 text-text-mid leading-relaxed"><li><strong class="font-semibold text-text-dark">عناقيد محولات السرعة المتغيرة</strong> — خطوات تبديل كل بضع مئات من الميكروثوانيات؛ يُبقي تأخر FPGA الخطأ المتبقي صغيرًا.</li><li><strong class="font-semibold text-text-dark">مراكز البيانات</strong> — تولّد مصادر التبديل توافقيات عريضة النطاق تحتاج كشفًا متوازيًا عبر مرات كثيرة.</li><li><strong class="font-semibold text-text-dark">مصانع صناعية بحمل غير خطي مختلط</strong> — يجمع CHITEK AHF وCHITEK SVG بين تشوه الموجة والتعويض التفاعلي من منصة تحكم واحدة.</li><li><strong class="font-semibold text-text-dark">مغذيات الشبكة الضعيفة</strong> — تثبّت الاستجابة السريعة للحلقة الجهد حيث يُذبذب متحكم بطيء.</li></ul>
<h2 id="bottom-line" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">الخلاصة</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">تحكم FPGA هو ما يسمح للمرشح النشط للتوافقيات بالاستجابة خلال ميكروثوانٍ لا ميلي ثوانٍ، وهو السبب المعماري وراء قدرة تصاميم المرشح النشط للتوافقيات من CHITEK على إبقاء THDi دون 5% على الأحمال الديناميكية. يوسّع المسرح القدري SiC تلك الميزة بإتساع عرض النطاق الذي تستطيع حلقة التحكم استخدامه فعليًا. ما أسرع خطوة حمل لديك عند PCC — وهل تملك حلقة تحكم مرشحك ميزانية التأخير لتتبّعها؟</p>
        </div>

        <!-- SEO Keywords -->
        <div class="mt-10 pt-6 border-t border-border-light">
          <div class="flex flex-wrap gap-2">
            {article.keywords.map((keyword) => (
              <span class="text-xs text-text-muted bg-gray-100 px-3 py-1 rounded-full">#{keyword}</span>
            ))}
          </div>
        </div>
        <div class="flex flex-col md:flex-row items-center justify-between mt-16 pt-8 border-t border-border-light">
          <div class="flex items-center gap-4 mb-4 md:mb-0">
            <div class="w-12 h-12 bg-brand-orange/10 rounded-full flex items-center justify-center">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6 text-brand-orange">
                <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <div>
              <div class="font-semibold text-text-dark">الفريق الفني لـ CHITEK</div>
              <div class="text-sm text-text-muted">نُشر {article.dateDisplay}</div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-sm text-text-muted">مشاركة:</span>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(SHARE_URL)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(SHARE_URL)}&text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Twitter" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.05c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/></svg>
            </a>
            <a href="https://www.facebook.com/profile.php?id=61579260405315" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          </div>
        </div>
      </article>

      <aside class="lg:w-[320px] shrink-0">
        <div class="lg:sticky lg:top-[88px] space-y-4">

          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              مقالات أخرى
            </h3>
            <div class="space-y-2">
              {otherArticles.map((item) => (
                <a href={item.href} class="block p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="text-sm font-semibold text-text-dark leading-snug">{item.title}</div>
                </a>
              ))}
            </div>
          </div>

          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
              منتجات ذات صلة
            </h3>
            <div class="space-y-2">
              {relatedProducts.map((product) => (
                <a href={product.href} class="flex items-center gap-2.5 p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="w-8 h-8 bg-brand-orange/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 text-brand-orange">
                      <path d={product.icon}/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-text-dark truncate">{product.name}</div>
                  </div>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-text-muted shrink-0">
                    <path d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              ))}
            </div>
          </div>

          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              حالات العملاء
            </h3>
            <div class="space-y-2">
              {relatedCases.map((caseItem) => (
                <a href={caseItem.href} class="block p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="text-sm font-semibold text-text-dark">{caseItem.name}</div>
                  <div class="text-xs text-text-muted mt-1">{caseItem.industry}</div>
                </a>
              ))}
            </div>
          </div>

        </div>
      </aside>

    </div>
  </section>
</BaseLayout>
