  }
  </script>

  <Sidebar lang="ar" />

  <section class="pt-[72px] bg-bg-dark text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-orange/20 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 py-16 md:py-20">
      <a href="/ar/news" class="inline-flex items-center text-brand-orange text-sm font-semibold mb-6 hover:underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 mr-2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        العودة إلى الأخبار
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold text-brand-orange bg-brand-orange/20 px-3 py-1 rounded-full">{article.category}</span>
        <span class="text-xs text-gray-400">{article.dateDisplay}</span>
        <span class="text-xs text-gray-400">·</span>
        <span class="text-xs text-gray-400">{article.readTime}</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-[family-name:var(--font-barlow-condensed)] tracking-tight max-w-4xl">
        {article.title}
      </h1>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-12 flex flex-col lg:flex-row gap-10">

      <article class="flex-1 max-w-4xl">
        <div class="w-full h-64 md:h-96 rounded-xl overflow-hidden mb-10 bg-gray-50">
          <img src="/assets/images/news/news-img-6.webp" alt="بنوك مكثفات رنانة: دراسة حالة CHITEK AHF + SVG" class="w-full h-full object-cover" loading="eager" />
        </div>

        <div class="prose prose-lg max-w-none">
<p class="text-text-mid text-lg leading-relaxed mb-6">تُركّب بنوك المكثفات لتصحيح معامل القدرة. في مصنع غني بالتوافقيات تفعل العكس: سعة البنك ومحثية النظام تكوّنان دائرة رنانة موازية تضخّم التوافقيات التي كان يجب أن تتجاهلها. في منشأة معالجة نحاس في تشجيانغ، أدى هذا الميكانيزم إلى قطع كل بنك مكثفات عند التشغيل، وجرّ معامل القدرة إلى 0.61، وترك تيار التوافقي الخامس عند 254 A. يتتبع هذا الدراسة القياس والتشخيص الرنيني وبنية المرشح النشط للتوافقيات (AHF) + مولد التيار المتغير الثابت (SVG) التي أعادت الشبكة.</p>
<h2 id="the-plant-and-the-3-transformer" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">المصنع والمحول رقم 3</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">شركة تشجيانغ جينجيا للنحاس ذي الشكل الخاص المحدودة (مقاطعة تشانغشينغ، خوتشو) تنتج قضبان نحاسية خالية من الأكسجين وقضبان ناقلة ومنتجات نحاسية متخصصة. تعمل خطوطها بأفران الحث ومحولات التردد — أحمال غير خطية تحقن تيارات توافقية باستمرار.</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">كان <strong class="font-semibold text-text-dark">المحول رقم 3 سعة 1600 kVA</strong> يحمل الأعراض:</p>
<ul class="list-disc list-inside space-y-2 mb-6 text-text-mid leading-relaxed"><li><strong class="font-semibold text-text-dark">كانت بنوك المكثفات تنقطع أو تفشل فور التشغيل</strong>.</li><li><strong class="font-semibold text-text-dark">تضررت المكثفات مرارًا بسبب التيار الزائد والاحترار المفرط</strong>.</li><li><strong class="font-semibold text-text-dark">واجهت محولات التردد صعوبة في الانطلاق عند الحمل العالي</strong>.</li><li><strong class="font-semibold text-text-dark">انخفض معامل القدرة إلى 0.61</strong>.</li><li><strong class="font-semibold text-text-dark">بلغ تشوه التوافقيات مستويات هددت عمر المعدات وأمان الموقع</strong>.</li></ul>
<h2 id="how-the-problem-was-quantified" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">كيف حُددت المشكلة كميًا</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">حددت القياسات الأساسية عند المحول الحجم قبل تحديد أي معدات:</p>
<div class="overflow-x-auto mb-6"><table class="w-full border-collapse"><thead><tr class="bg-gray-50"><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">المعلمة</th><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">القيمة المقاسة</th></tr></thead><tbody><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">THDv</strong></td><td class="p-4 border-b border-border-light text-text-mid font-medium">حتى 7.72%</td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">THDi</strong></td><td class="p-4 border-b border-border-light text-text-mid font-medium">حتى 28.5%</td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">التوافقيات المهيمنة</strong></td><td class="p-4 border-b border-border-light text-text-mid font-medium">5 و11 و13</td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">الطلب التفاعلي</strong></td><td class="p-4 border-b border-border-light text-text-mid font-medium">781 kvar</td></tr></tbody></table></div>
<p class="text-text-mid text-lg leading-relaxed mb-6">كان المغذي 3-1# (الفرع الأيسر) أسوأ: THDi حتى 31.77%، THDv حتى 7.92%، مهيمنًا مجددًا بالخامس والحادي عشر. بلغ تيار التوافقي الخامس وحده 254 A؛ وصل الحادي عشر إلى ذروته عند 139 A — كلاهما يتجاوز حدود IEEE وGB بكثير.</p>
<h2 id="root-cause-parallel-resonance" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">السبب الجذري: الرنين الموازي</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">أشار الطيف التوافقي إلى VFD والعواكس كمصدر. لكن آلية الفشل كانت أدق.</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">يُظهر بنك المكثفات مفاعلة سعوية تهبط مع التردد. وترتفع محثية النظام مع التردد. عند تردد واحد — التردد الرنيني الموازي — يلغي الاثنان وتقفز الممانعة التي تراها تيارات التوافقيات:</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">f_res = (1 / 2π) × √(L_system × C_bank)</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">عندما يقع تيار توافقي قرب f_res، يصبح البنك فخًا: يتداول التيار التوافقي بين المكثف والمحث، ويتحمل البنك تيارًا أعلى بكثير من تقييمه، وتصعد حرارة العازل حتى تفشل الوحدة. وهذا هو سبب انقطاع البنوك عند التشغيل بدل التدهور البطيء — فالرنين يُثار اللحظة التي يُغلق فيها القاطع.</p>
<h2 id="what-resonant-banks-cost" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">ما كلفته بنوك الرنين</h2>
<ul class="list-disc list-inside space-y-2 mb-6 text-text-mid leading-relaxed"><li><strong class="font-semibold text-text-dark">فشل المكثفات</strong> — يدمر التيار الزائد والاحترار المفرط الوحدات؛ والاستبدال متكرر لا لمرة واحدة.</li><li><strong class="font-semibold text-text-dark">انهيار معامل القدرة</strong> — مع خروج البنوك عن الخدمة، استقر FP عند 0.61، مما أدى إلى غرامات المرافق.</li><li><strong class="font-semibold text-text-dark">انطلاق VFD غير موثوق</strong> — يشوّش الجهد المشوّه تحكم المحوّل ويقطع المحولات عند الحمل العالي.</li><li><strong class="font-semibold text-text-dark">إجهاد حراري على الأصول</strong> — تسرّع خسائر التوافقيات شيخوخة المحول والكابلات.</li><li><strong class="font-semibold text-text-dark">تعرّض للسلامة</strong> — النقاط المحايدة المحمومة وعلب المكثفات الفاشلة تمثل خطر حريق.</li></ul>
<h2 id="why-fixed-correction-falls-short" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">لماذا يُخفق التصحيح الثابت</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">كان هناك علاجان تقليديان على الطاولة. لم يحل أي منهما المشكلة بالكامل.</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">المفاعلات غير المضبوطة مع المكثفات (7%) تزيح التردد الرنيني إلى ما دون الخامس، مما يمنع تضخيم الخامس. هذا تحوير صالح — لكنه ثابت، مضبوط على طيف مفترض، ولا يفعل شيئًا مع الحادي عشر والثالث عشر. كما أنه لا يمكنه توفير قدرة تفاعلية متغيرة باستمرار مع تأرجح حمل الفرن.</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">بنوك المكثفات البسيطة تصحح معامل القدرة المتوسط فقط. لا تستطيع تتبّع حمل متأرجح، ولا إعادة توازن للأطوار، وفي شبكة غنية بالتوافقيات هي ذاتها مصدر الرنين.</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">ما احتاجته المنشأة هو مصدر يتكيّف: إلغاء توافقي في الوقت الفعلي مع دعم تفاعلي متغير باستمرار، دون عناصر مضبوطة يمكنها الرنين.</p>
<h2 id="how-chitek-ahf-svg-fix-it" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">كيف يعالجها CHITEK AHF + SVG</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">حددت CHITEK بنية تعويض نشط هجينة مُحجمة للطيف المقاس والطلب التفاعلي للمحول رقم 3.</p>
<div class="overflow-x-auto mb-6"><table class="w-full border-collapse"><thead><tr class="bg-gray-50"><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">الجهاز</th><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">الكمية</th><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">الوظيفة</th></tr></thead><tbody><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">CHITEK SVG</strong> (100 kvar لكل وحدة)</td><td class="p-4 border-b border-border-light text-text-mid font-medium">8 وحدات</td><td class="p-4 border-b border-border-light text-text-mid font-medium">تعويض تفاعلي ديناميكي، 800 kvar إجمالي</td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">CHITEK AHF</strong> (150 A لكل وحدة)</td><td class="p-4 border-b border-border-light text-text-mid font-medium">3 وحدات</td><td class="p-4 border-b border-border-light text-text-mid font-medium">ترشيح التوافقيات الفردية من 2 إلى 50</td></tr></tbody></table></div>
<p class="text-text-mid text-lg leading-relaxed mb-6">مولد التيار المتغير الثابت هو محوّل مصدر جهد يحقن أو يمتص تيارًا تفاعليًا باستمرار، من +300 kvar إلى –800 kvar، ويبقي معامل القدرة قرب الوحدة مع تحرك حمل الفرن. يَقيس المرشح النشط للتوافقيات تيار الحمل، ويستخرج المكوّن التوافقي، ويركّب تيار إلغاء:</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">i_c* = i_L − i_s(الأساسي)</p>
<p class="text-text-mid text-lg leading-relaxed mb-6">كلاهما يستجيب في <strong class="font-semibold text-text-dark">&lt; 5 ms</strong>، لذا يتبع التعويض الحمل بدل أن يتأخر عنه. وبما أنه لا عنصر LC مضبوط، لا توجد تردد رنيني لإثارته — فقد أُزيل وضع الفشل الذي دمّر البنوك الأصلية بنيويًا. كما يحمل AHF سعة نقطة محايدة 3× لتصفية التوافقيات الثلاثية.</p>
<h2 id="igbt-vs-sic" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">IGBT مقابل SiC</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">تستخدم وحدات LV AHF وSVG التقليدية IGBT محدودة عند نحو <strong class="font-semibold text-text-dark">150 °C</strong> وبتردد تبديل عادة دون <strong class="font-semibold text-text-dark">20 kHz</strong>. الانتقال إلى SiC MOSFET (وصلة <strong class="font-semibold text-text-dark">200 °C</strong>، صلابة انهيار ~<strong class="font-semibold text-text-dark">10×</strong>، تردد تبديل <strong class="font-semibold text-text-dark">2–3×</strong>، خسارة تبديل أقل بنحو <strong class="font-semibold text-text-dark">50%</strong>) يوسّع عرض نطاق التحكم ويصغّر الخزانة. يدفع تردد التبديل الأعلى التموج إلى ما وراء التوافقيات المُلغاة ويقصر حلقة التصحيح — وهي الوجهة التي بُنيت عليها منصة CHITEK LV AHF + SVG.</p>
<h2 id="results-after-commissioning" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">النتائج بعد التشغيل</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">أكدت القياسات بعد التشغيل التغيّر عبر كل معلمة:</p>
<div class="overflow-x-auto mb-6"><table class="w-full border-collapse"><thead><tr class="bg-gray-50"><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">المعلمة</th><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">قبل</th><th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">بعد</th></tr></thead><tbody><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">معامل القدرة</strong></td><td class="p-4 border-b border-border-light text-text-mid font-medium">0.61</td><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">&gt; 0.95</strong></td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">THDv</strong></td><td class="p-4 border-b border-border-light text-text-mid font-medium">7.72%</td><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">&lt; 3%</strong></td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">THDi</strong></td><td class="p-4 border-b border-border-light text-text-mid font-medium">28.5%</td><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">&lt; 5%</strong></td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">تشغيل المكثفات</strong></td><td class="p-4 border-b border-border-light text-text-mid font-medium">فشل</td><td class="p-4 border-b border-border-light text-text-mid font-medium">مستقر وفعّال</td></tr><tr><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">انطلاق VFD</strong></td><td class="p-4 border-b border-border-light text-text-mid font-medium">غير موثوق</td><td class="p-4 border-b border-border-light text-text-mid font-medium"><strong class="font-semibold text-text-dark">نجاح 100%</strong></td></tr></tbody></table></div>
<p class="text-text-mid text-lg leading-relaxed mb-6">يمكن الآن تشغيل بنوك المكثفات القائمة بأمان لأن تيارات التوافقيات التي كانت تُثير الرنين قد أُلغيت. تنطلق محولات التردد بثقة عند الحمل الكامل، ويطيل الإجهاد الحراري المنخفض عمر المعدات. تلتقي المنشأة بمعياري <strong class="font-semibold text-text-dark">GB/T 14549</strong> و<strong class="font-semibold text-text-dark">IEEE 519</strong>.</p>
<h2 id="engineering-deployment-checklist" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">قائمة التحقق من النشر الهندسي</h2>
<ol class="list-decimal list-inside space-y-2 mb-6 text-text-mid leading-relaxed"><li>قس THDv وTHDi وطيف التوافقيات الفردي عند PCC عبر دورة عمل كاملة — أسوأ الحالات، لا المتوسط.</li><li>احسب التردد الرنيني الموازي لكل بنك قائم مقابل محثية النظام قبل تشغيل أي شيء.</li><li>حدّد حجم SVG لتأرجح القدرة التفاعلية (هنا طلب 781 kvar مقابل سعة مركبة 800 kvar)، لا لمعامل القدرة المتوسط.</li><li>حدّد حجم AHF للتيارات التوافقية المهيمنة (الخامس 254 A، الحادي عشر 139 A) مع هامش لنمو الحمل.</li><li>تحقق من سعة النقطة المحايدة إذا وُجدت توافقيات ثلاثية.</li><li>أعد القياس بعد التشغيل مقابل حدود IEEE 519 وأكّد أن بنوك المكثفات تُشغّل دون انقطاع.</li></ol>
<h2 id="typical-application-profiles" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">ملامح التطبيق النموذجية</h2>
<ul class="list-disc list-inside space-y-2 mb-6 text-text-mid leading-relaxed"><li><strong class="font-semibold text-text-dark">معالجة النحاس والصلب</strong> — أفران الحث وVFD؛ يثبّت AHF + SVG ناقلًا غنيًا بالتوافقيات ويستعيد تشغيل المكثفات.</li><li><strong class="font-semibold text-text-dark">مصانع ببنوك مكثفات فاشلة</strong> — فشل المكثفات المتكرر هو عرض رنين لا مشكلة جودة مكثف؛ قِس قبل الاستبدال.</li><li><strong class="font-semibold text-text-dark">منشآت تواجه غرامات PF مع THDi مرتفع</strong> — لا تستطيع البنوك الثابتة تصحيح PF في هذا النظام؛ التعويض النشط يستطيع.</li><li><strong class="font-semibold text-text-dark">مواقع أحمال غير خطية مختلطة</strong> — عواكس ومحولات ولحامون على محول واحد؛ يعالج AHF + SVG المدمج التشوه وتأرجح القدرة معًا.</li></ul>
<h2 id="bottom-line" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">الخلاصة</h2>
<p class="text-text-mid text-lg leading-relaxed mb-6">لا تستطيع المكثفات تصحيح معامل القدرة في نظام غني بالتوافقيات — فهي تضخّم المشكلة وتفشل. يزيل ثنائي CHITEK AHF + SVG التوافقيات التي تُثير الرنين ويوفّر قدرة تفاعلية نظيفة باستمرار، ليعمل البنكان القائمان كما هو مقصود. ما قيمة THDi لمصنعك عند PCC — وهل انقطعت بنوك مكثفاتك يومًا عند التشغيل؟</p>
        </div>

        <!-- SEO Keywords -->
        <div class="mt-10 pt-6 border-t border-border-light">
