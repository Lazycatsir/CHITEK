const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p) => isLocal ? '/ar' + p : p;

const SHARE_URL = getHreflang('ar', Astro.url.pathname);
---
<BaseLayout
  title={`${article.title} | CHITEK INNOPOWER`}
  description={article.description}
  lang="ar"
  ogType="article"
  ogTitle={article.title}
  ogDescription={article.description}
  ogImage="https://ar.chitek-inno.com/assets/images/news/news-img-2.webp"
  alternateLangs={['zh', 'en', 'es', 'ar']}
>
  <!-- Schema.org Article Structured Data -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "لماذا تحتاج محطات شحن السيارات الكهربائية إلى AHF + SVG منخفض الجهد",
    "description": "كل شاحن سريع التيار المستمر حمل غير خطي. ومع تكاثر الشواحن على ناقل واحد تتراكم التشوهات. يشرح هذا المقال لماذا يعد AHF + SVG منخفض الجهد الحل الصحيح للتوافقيات واختلال التوازن وتأرجح القدرة غير الفاعلة في مراكز الشحن.",
    "image": "https://ar.chitek-inno.com/assets/images/news/news-img-2.webp",
    "author": {"@type": "Organization","name": "الفريق الفني لـ CHITEK"},
    "publisher": {"@type": "Organization","name": "CHITEK INNOPOWER","logo": {"@type": "ImageObject","url": "https://ar.chitek-inno.com/assets/images/logo.webp"}},
    "datePublished": "2026-07-21",
    "dateModified": "2026-07-21",
    "keywords": "شحن السيارات الكهربائية شاحن سريع DC التوافقيات AHF SVG جودة الطاقة"
  }
  </script>

  <Sidebar lang="ar" />

  <!-- Article Header -->
  <section class="pt-[72px] bg-bg-dark text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-orange/20 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 py-16 md:py-20">
      <a href={lp('/news')} class="inline-flex items-center text-brand-orange text-sm font-semibold mb-6 hover:underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 mr-2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        العودة إلى الأخبار
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold text-brand-orange bg-brand-orange/10 px-3 py-1 rounded-full">تقنية</span>
        <span class="text-xs text-gray-400">21 يوليو 2026</span>
        <span class="text-xs text-gray-400">&middot;</span>
        <span class="text-xs text-gray-400">5 دقائق قراءة</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-[family-name:var(--font-barlow-condensed)] tracking-tight max-w-4xl">
        لماذا تحتاج محطات شحن السيارات الكهربائية إلى AHF + SVG منخفض الجهد
      </h1>
    </div>
  </section>

  <!-- Article Content + Sidebar -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-12 flex flex-col lg:flex-row gap-10">

      <!-- Main Content -->
      <article class="flex-1 max-w-4xl">
        <!-- Featured Image -->
        <div class="w-full h-64 md:h-96 rounded-xl overflow-hidden mb-10 bg-gray-50">
          <img src="/assets/images/news/news-img-2.webp" alt="لماذا تحتاج محطات شحن السيارات الكهربائية إلى AHF + SVG منخفض الجهد" width="1983" height="793" class="w-full h-full object-cover" loading="eager" />
        </div>

        <div class="prose prose-lg max-w-none">
<p class="text-text-mid text-lg leading-relaxed mb-6">تنمو بنية شحن السيارات الكهربائية بسرعة —مواقف تجارية وأساطيل ومرائب حافلات ومحطات طرق سريعة. كل شاحن سريع التيار المستمر حمل غير خطي عالي القدرة، ومع تكاثر الشواحن على ناقل واحد تتراكم التشوهات. لم يعد ضبط التوافقيات اختيارياً؛ بل هو جزء من بناء محطة شحن موثوقة. يغطي هذا المقال الآلية والتكلفة ولماذا يعد AHF + SVG منخفض الجهد (LV) الحل الصحيح.</p>
<h2 id="why-chargers-distort-the-bus" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">لماذا تشوّه الشواحن الناقل</h2>
<p class="text-text-mid leading-relaxed mb-6">الشاحن السريع DC محوّل بوضع التبديل: ممر أمامي موجه + مرحلة DC/DC. وكأي VFD أو UPS أو عاكس PV، يسحب تياراً بنبضات مولداً توافقيات مميزة عند الرتب <strong>n = 6k ± 1</strong>: 5 و7 و11 و13. والأسوأ أن الشواحن غالباً ثلاثية لكن غير متوازنة (أعمدة أحادية الطور على طور واحد)، فتحقن تيار التتابع السالب ومحتوى محايد مضاعف ثلاثياً. دون معالجة، يبقى THDi على الناقل بين <strong>8% و30%</strong>، مقابل حد IEEE 519 <strong>THDi &lt; 5%</strong> عند PCC. وهو ديناميكي: مركز فيه شواحن سريعة كثيرة عند الذروة ضاغط خطير.</p>
<h2 id="what-uncontrolled-distortion-costs" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">تكلفة التشوه غير المنضبط</h2>
<p class="text-text-mid leading-relaxed mb-2">• <strong>احترار المحول</strong> وقصر العمر.</p>
<p class="text-text-mid leading-relaxed mb-2">• <strong>خسائر I²R أعلى في الكابلات</strong> وأجهزة حماية مجهدة.</p>
<p class="text-text-mid leading-relaxed mb-2">• <strong>رحلات وصل غير مرغوبة</strong>وموثوقية أقل.</p>
<p class="text-text-mid leading-relaxed mb-2">• <strong>عامل قدرة أقل</strong> → غرامات؛ كفاءة أقل.</p>
<p class="text-text-mid leading-relaxed mb-6">• <strong>انتشار الضغط</strong> إلى لوحات المفاتيح والقواطع ومجموعات المكثفات —مشكلة نظام.</p>
<h2 id="why-an-ahf-svg-not-a-fixed-filter" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">لماذا AHF + SVG لا مرشح ثابت</h2>
<p class="text-text-mid leading-relaxed mb-6">يأخذ مرشح الموجة النشط عينة من تيار الحمل، يفصل الأساسية عن التشوه ويحقن العكس: <strong>i_c* = i_L − i_s(الأساسية)</strong>. يُركّب بجسر يبدّل 15–20 kHz، يتتبع في <strong>&lt; 1 ms</strong> ويخفض THDi من <strong>30%+ إلى &lt; 5%</strong> عبر الرتب 5 إلى 25. مولد فار الساكن (SVG) يعالج تأرجح القدرة غير الفاعلة واختلال التوازن الثلاثي: استجابة دون دورة (&lt; 1 ms)، تنظيم مستمر ±1%، عامل قدرة <strong>0.99+</strong>، مقابل خطوة &gt;20 ms للمكثفات وفرط/نقص التعويض.</p>
<h2 id="igbt-vs-sic" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">IGBT مقابل SiC</h2>
<p class="text-text-mid leading-relaxed mb-6">تستخدم AHF/SVG LV التقليدية IGBT محدودة قرب 150°C، تبديل عادة تحت 20 kHz. الانتقال إلى SiC MOSFET (وصلة 200°C، حقل انهيار ~10×، تردد 2–3×، فقد ~50% أقل) يوسع النطاق ويصغر الخزانة —قيمة كبيرة في خزانة شحن مدمجة. هذا اتجاه منصة CHITEK LV AHF + SVG.</p>
<h2 id="what-engineers-should-measure-first" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">ماذا يقيس المهندس أولاً</h2>
<p class="text-text-mid leading-relaxed mb-2">• التشوه التوافقي الكلي (THD/TDD) عند PCC.</p>
<p class="text-text-mid leading-relaxed mb-2">• عدد وقدرة الشواحن؛ مزيج التيار المستمر/المتردد.</p>
<p class="text-text-mid leading-relaxed mb-2">• تغير الحمل زمنياً (ذروة/منخفض).</p>
<p class="text-text-mid leading-relaxed mb-2">• حجم وحرارة المحول.</p>
<p class="text-text-mid leading-relaxed mb-6">• مجموعات المكثفات الحالية وسعة المنبع.</p>
<h2 id="typical-application-profiles" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">ملفات تطبيق نموذجية</h2>
<p class="text-text-mid leading-relaxed mb-2">• <strong>شحن عام سريع:</strong> تباين يومي كبير؛ تعويض لحظي يحافظ على الاستقرار.</p>
<p class="text-text-mid leading-relaxed mb-2">• <strong>شحن مبانٍ تجارية:</strong> يضيف ضغطاً توافقياً لناقل مصاعد/HVAC؛ AHF يحميه.</p>
<p class="text-text-mid leading-relaxed mb-2">• <strong>مرائب حافلات/أساطيل:</strong> نوافذ شحن مركّزة → تشوه عالٍ؛ AHF + SVG يخففه.</p>
<p class="text-text-mid leading-relaxed mb-6">• <strong>مراكز لوجستية/صناعية:</strong> الشواحن فوق القيادات القائمة؛ الترشيح الديناميكي هو الطريق الموثوق.</p>
<h2 id="bottom-line" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">الخلاصة</h2>
<p class="text-text-mid leading-relaxed mb-6">الشواحن غير خطية وغير متوازنة بن design. ثنائي <strong>AHF + SVG</strong> منخفض الجهد يلغي التوافقيات ويعيد توازن الأطوار لحظياً —يحمي المحولات والكابلات والقواطع، ويتمدد مع الموقع. بنيت منصات CHITEK LV AHF + SVG بمبدأ القياس أولاً هذا.</p>
<p class="text-text-mid leading-relaxed mb-6">ما THDi واختلال التوازن الذي يضعه مركز شحنك على الناقل —وهل هو دون 5% عند PCC؟</p>
        </div>

        <!-- SEO Keywords -->
        <div class="mt-10 pt-6 border-t border-border-light">
          <div class="flex flex-wrap gap-2">
            {article.keywords.map((keyword) => (
              <span class="text-xs text-text-muted bg-gray-100 px-3 py-1 rounded-full">#{keyword}</span>
            ))}
          </div>
        </div>

        <!-- Author & Share -->
        <div class="mt-12 pt-8 border-t border-border-light">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-orange to-brand-orange-dark flex items-center justify-center text-white font-bold text-lg">C</div>
              <div>
                <p class="font-semibold text-text-dark">{article.author}</p>
                <p class="text-sm text-text-muted">نُشر {article.dateDisplay}</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm text-text-muted">مشاركة:</span>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(SHARE_URL)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
  <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
</a>
<a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(SHARE_URL)}&text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Twitter" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
  <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.05c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/></svg>
</a>
<a href="https://www.facebook.com/profile.php?id=61579260405315" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
  <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
</a>
            </div>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="lg:w-[320px] shrink-0">
        <div class="lg:sticky lg:top-[88px] space-y-4">

          <!-- Other Articles -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              المقالات
            </h3>
            <div class="space-y-2">
              {otherArticles.map((item) => (
                <a href={lp(item.href)} class="block p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="text-sm font-semibold text-text-dark leading-snug">{item.title}</div>
                </a>
              ))}
            </div>
          </div>

          <!-- Related Products -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
