            </h3>
            <div class="space-y-2">
              {relatedProducts.map((item) => (
                <a href={item.href} class="flex items-center gap-3 p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
