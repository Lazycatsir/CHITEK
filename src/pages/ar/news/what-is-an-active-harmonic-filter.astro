---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';

const article = {
  title: "ما هو مرشح الموجة النشط؟ المبادئ وأمر i_c* وجسر IGBT/SiC",
  category: "تقنية",
  date: "2026-07-22",
  dateDisplay: "22 يوليو 2026",
  author: "فريق CHITEK الفني",
  readTime: "5 دقائق قراءة",
  description: "يُلغي مرشح الموجة النشط (AHF) التيار التوافقي ويصحح القدرة غير الفاعلة في الوقت الحقيقي. يشرح هذا المقال المبدأ من الكشف إلى الحقن ولماذا يحدد مفتاح IGBT→SiC سقف الأداء.",
  keywords: [    "مرشح الموجة النشط",
      "AHF",
      "التوافقيات",
      "جودة الطاقة",
      "IGBT",
      "SiC",
      "القدرة غير الفاعلة",
      "THDi",
      "CHITEK"]
};

const otherArticles = [
    { title: "تعزيز موثوقية مرشح AHF بطلاء كونفورمال", category: "تقنية", href: "/news/conformal-coating-ahf-reliability", color: "orange" },
    { title: "مرشحات AHF مقابل مفاعلات الخط", category: "تقنية", href: "/news/blog-ahf-vs-line-reactors", color: "orange" },
    { title: "AHF لأنظمة VFD", category: "تقنية", href: "/news/blog-active-harmonic-filter-for-vfd-systems", color: "orange" }
];
const relatedProducts = [
    { name: "مرشح الموجة النشط AHF", href: "/products#ahf", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
    { name: "مولد فار الساكن SVG", href: "/products#svg", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
    { name: "سلسلة SiC-AHF/SVG عالية الكفاءة", href: "/products#sic", icon: "M13 10V3L4 14h7v7l9-11h-7z" }
];
const relatedCases = [
    { name: "مركز بيانات في البرازيل", industry: "مراكز البيانات" },
    { name: "مصنع صناعي في السعودية", industry: "التصنيع" },
    { name: "مزرعة طاقة شمسية 50 ميجاواط في دبي", industry: "الطاقة المتجددة" }
];

const lp = (p) => p;

---
<BaseLayout
  title={`${article.title} | CHITEK INNOPOWER`}
  description={article.description}
  lang="ar"
  ogType="article"
  ogTitle={article.title}
  ogDescription={article.description}
  ogImage="https://chitek-inno.com/assets/images/news/news-img-1.webp"
>
  <!-- Schema.org Article Structured Data -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "ما هو مرشح الموجة النشط؟ المبادئ وأمر i_c* وجسر IGBT/SiC",
    "description": "يُلغي مرشح الموجة النشط (AHF) التيار التوافقي ويصحح القدرة غير الفاعلة في الوقت الحقيقي. يشرح هذا المقال المبدأ من الكشف إلى الحقن ولماذا يحدد مفتاح IGBT→SiC سقف الأداء.",
    "image": "https://chitek-inno.com/assets/images/news/news-img-1.webp",
    "author": {"@type": "Organization","name": "فريق CHITEK الفني"},
    "publisher": {"@type": "Organization","name": "CHITEK INNOPOWER","logo": {"@type": "ImageObject","url": "https://chitek-inno.com/assets/images/logo.webp"}},
    "datePublished": "2026-07-22",
    "dateModified": "2026-07-22",
    "keywords": "مرشح الموجة النشط AHF التوافقيات جودة الطاقة IGBT SiC"
  }
  </script>

  <Sidebar lang="ar" />

  <!-- Article Header -->
  <section class="pt-[72px] bg-bg-dark text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-orange/20 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 py-16 md:py-20">
      <a href={lp('/news')} class="inline-flex items-center text-brand-orange text-sm font-semibold mb-6 hover:underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 mr-2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        العودة إلى الأخبار
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold text-brand-orange bg-brand-orange/10 px-3 py-1 rounded-full">تقنية</span>
        <span class="text-xs text-gray-400">22 يوليو 2026</span>
        <span class="text-xs text-gray-400">&middot;</span>
        <span class="text-xs text-gray-400">5 دقائق قراءة</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-[family-name:var(--font-barlow-condensed)] tracking-tight max-w-4xl">
        ما هو مرشح الموجة النشط؟ المبادئ وأمر i_c* وجسر IGBT/SiC
      </h1>
    </div>
  </section>

  <!-- Article Content + Sidebar -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-12 flex flex-col lg:flex-row gap-10">

      <!-- Main Content -->
      <article class="flex-1 max-w-4xl">
        <!-- Featured Image -->
        <div class="w-full h-64 md:h-96 rounded-xl overflow-hidden mb-10 bg-gray-50">
          <img src="/assets/images/news/news-img-1.webp" alt="ما هو مرشح الموجة النشط؟ المبادئ وأمر i_c* وجسر IGBT/SiC" class="w-full h-full object-cover" loading="eager" />
        </div>

        <div class="prose prose-lg max-w-none">
<p class="text-text-mid text-lg leading-relaxed mb-6">مرشح الموجة النشط (AHF) هو معوض إلكتروني للطاقة موصول بالتوازي يحسّن جودة الطاقة بإلغاء التيار التوافقي وتصحيح القدرة غير الفاعلة في الوقت الحقيقي. على عكس فخ LC السلبي، يتكيف مع الحمل المتغير ويتجنب الرنين مع معاوقة النظام. يشرح هذا المقال المبدأ من الكشف حتى الحقن ولماذا يحدد اختيار الموصل (IGBT مقابل SiC) سقف الأداء.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">ماذا يفعل الـ AHF</h2>
<p class="text-text-mid leading-relaxed mb-6">يتصل الـ AHF بالتوازي مع الناقل المشوّه ويقيس تيار الحمل باستمرار. يحسب تيار التعويض —مساوٍ في السعة ومعاكس في الطور للمحتوى التوافقي وغير الفاعل غير المرغوب— ويحقنه، تاركاً المصدر شبه جيبي وعامل قدرة مرتفع.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">المبدأ خطوة بخطوة</h2>
<p class="text-text-mid leading-relaxed mb-3"><strong>1. كشف وفصل التوافقيات.</strong> مجسات تيار عالية الدقة (تأثير هول، حتى ~50 رتبة) تأخذ عينة من تيار الحمل لحظياً. تُفكك الإشارة بطريقتين: نظرية القدرة التفاعلية اللحظية (p–q) تحوّل التيار ثلاثي الطور إلى مركبتين حقيقية وخيالية، وFFT تستخرج سعة وطور كل توافقي. النتيجة أمر تيار مرجعي مساوٍ في السعة ومعاكس في الطور —"التوافقي العكسي".</p>
<p class="text-text-mid leading-relaxed mb-3"><strong>2. توليد تيار التعويض.</strong> النواة عاكس بمصدر جهد (VSI) مبني على عناصر تبديل عالية التردد (IGBT أو SiC). يحقن تيار التعويض الذي يلتقي مع التيار التوافقي الأصلي فيلغيه.</p>
<p class="text-text-mid leading-relaxed mb-3"><strong>3. تعويض القدرة غير الفاعلة.</strong> نفس العاكس يوفر تياراً متقدماً أو متأخراً لموازنة مركبة الحمل غير الفاعلة، رافعاً عامل القدرة نحو الوحدة (هدف CHITEK LV AHF/SVG: <strong>0.99+</strong>).</p>
<p class="text-text-mid leading-relaxed mb-3"><strong>4. تحكم حلقي مغلق واستقرار.</strong> تُراقب تيارات الشبكة المعوَّضة وتُقارن بالمرجع؛ يُضبط خرج العاكس للحفاظ على الدقة.</p>
<p class="text-text-mid leading-relaxed mb-6"><strong>5. مقاومة الرنين وقابلية التكيف.</strong> يتجنب التحكم النشط تكوين دوائر رنين مع معاوقة الشبكة، ويعالج توافقيات النطاق العريض (3 و5 و7 وعالية)، ويدعم وحدات متوازية متعددة للتعويض الموزع.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">قانون التعويض</h2>
<blockquote class="border-l-4 border-brand-orange pl-4 italic text-text-mid my-6">i_c* = i_L − i_s(الأساسية)</blockquote>
<p class="text-text-mid leading-relaxed mb-6">يُركّب بجسر يبدّل عند 15–20 kHz، يتتبع التصحيح في <strong>&lt; 1 ms</strong> ويخفض THDi من <strong>30%+ إلى &lt; 5%</strong> عبر الرتب 5 إلى 25 في آن واحد —متابعاً الحمل كما يتغير. دون معالجة، يبقى THDi عند حمل غير خطي غالباً بين <strong>8% و30%</strong>، مقابل حد IEEE 519 <strong>THDi &lt; 5%</strong> عند نقطة الربط المشتركة PCC.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">عنق الزجاجة لأشباه الموصلات: IGBT مقابل SiC</h2>
<p class="text-text-mid leading-relaxed mb-3">IGBT: وصلة محدودة قرب <strong>150°C</strong>، تردد تبديل عادة <strong>أقل من 20 kHz</strong>.</p>
<p class="text-text-mid leading-relaxed mb-6">SiC MOSFET: فجوة النطاق <strong>3.26 eV مقابل 1.12 eV</strong>، وصلة <strong>200°C</strong>، مجال انهيار <strong>~10×</strong>، تردد تبديل <strong>2–3×</strong>، فقد تبديل <strong>~50% أقل</strong>. يوسّع SiC نطاق الإلغاء (يعالج الرتبة 13 فما فوق)، ويصغّر الخزانة، ويعمل ببرودة أكبر —وهو الاتجاه الذي بنيت عليه منصة CHITEK LV AHF.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">قائمة النشر الهندسي</h2>
<p class="text-text-mid leading-relaxed mb-2">1. <strong>القياس عند PCC</strong> بمحلل جودة طاقة عبر دورة تشغيل كاملة.</p>
<p class="text-text-mid leading-relaxed mb-2">2. <strong>ضع الـ AHF عند المصدر</strong> —على مغذي عنقود الحمل غير الخطي.</p>
<p class="text-text-mid leading-relaxed mb-2">3. <strong>راجع مجموعات المكثفات</strong> للرنين قبل التشغيل.</p>
<p class="text-text-mid leading-relaxed mb-2">4. <strong>الحجم حسب TDD المقاس</strong> بالنسبة للطلب الأقصى.</p>
<p class="text-text-mid leading-relaxed mb-6">5. <strong>اترك هامشاً</strong> (15–25%) للقيادات الإضافية.</p>
<h2 id="sec" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">الخلاصة</h2>
<p class="text-text-mid leading-relaxed mb-6">الـ AHF حلقة قياس→حساب→حقن تلغي التشويه ديناميكياً ودون رنين. المبدأ ثابت؛ والمفتاح يقرر النطاق والحجم. بنيت منصات CHITEK LV AHF حول مسار الترقية IGBT→SiC هذا، ومحددة من قياس حقيقي.</p>
<p class="text-text-mid leading-relaxed mb-6">ما الرتب التوافقية التي يلغيها AHF فعلاً —وهل مفتاحه مصنّف لأعلاها على ناقلك؟</p>
        </div>

        <!-- SEO Keywords -->
        <div class="mt-10 pt-6 border-t border-border-light">
          <div class="flex flex-wrap gap-2">
            {article.keywords.map((keyword) => (
              <span class="text-xs text-text-muted bg-gray-100 px-3 py-1 rounded-full">#{keyword}</span>
            ))}
          </div>
        </div>

        <!-- Author & Share -->
        <div class="mt-12 pt-8 border-t border-border-light">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-orange to-brand-orange-dark flex items-center justify-center text-white font-bold text-lg">C</div>
              <div>
                <p class="font-semibold text-text-dark">فريق CHITEK الفني</p>
                <p class="text-sm text-text-muted">5 دقائق قراءة</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm text-text-muted">مشاركة:</span>
              <button class="w-8 h-8 rounded-full bg-gray-100 hover:bg-brand-orange hover:text-white transition-colors flex items-center justify-center text-sm" aria-label="Share">&#x2197;</button>
            </div>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="lg:w-[320px] shrink-0">
        <div class="lg:sticky lg:top-[88px] space-y-4">

          <!-- Other Articles -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              المقالات
            </h3>
            <div class="space-y-2">
              {otherArticles.map((item) => (
                <a href={lp(item.href)} class="block p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="text-sm font-semibold text-text-dark leading-snug">{item.title}</div>
                </a>
              ))}
            </div>
          </div>

          <!-- Related Products -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
              المنتجات ذات الصلة
            </h3>
            <div class="space-y-2">
              {relatedProducts.map((item) => (
                <a href={item.href} class="flex items-center gap-3 p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange shrink-0"><path d="{item.icon}"/></svg>
                  <span class="text-sm font-semibold text-text-dark leading-snug">{item.name}</span>
                </a>
              ))}
            </div>
          </div>

          <!-- Customer Cases -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              حالات العملاء
            </h3>
            <div class="space-y-2">
              {relatedCases.map((item) => (
                <div class="p-2.5 bg-white rounded-lg border border-border-light">
                  <div class="text-sm font-semibold text-text-dark leading-snug">{item.name}</div>
                  <div class="text-xs text-text-muted mt-1">{item.industry}</div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </aside>

    </div>
  </section>
</BaseLayout>
