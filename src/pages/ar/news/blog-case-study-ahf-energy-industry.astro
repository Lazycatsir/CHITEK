---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getHreflang } from '../../../i18n/index';

const article = {
  title: "دراسة حالة: AHF يستعيد جودة الطاقة في مصنع نفط وغاز",
  category: "دراسة حالة",
  date: "2026-07-05",
  dateDisplay: "5 يوليو 2026",
  author: "الفريق الفني لـ CHITEK",
  readTime: "4 دقائق قراءة",
  description: "كيف خفض AHF من CHITEK مستوى THDi من 32.5% إلى 3.8% في مصنع نفط وغاز.",
  keywords: [
    "Case study",
    "Oil and gas",
    "AHF",
    "Active harmonic filter",
    "THD reduction",
    "Energy industry",
    "Harmonic mitigation",
    "Power quality",
    "Industrial AHF",
    "CHITEK"
  ]
};

const otherArticles = [
    { title: "تعزيز موثوقية AHF", category: "التكنولوجيا", href: "/news/conformal-coating-ahf-reliability", color: "orange" },
    { title: "مرشحات التوافقيات مقابل مفاعلات", category: "التكنولوجيا", href: "/news/blog-ahf-vs-line-reactors", color: "orange" },
    { title: "معالجة المياه AHF وSVG", category: "التكنولوجيا", href: "/news/blog-ahf-water-treatment-plants", color: "orange" }
  ];
const relatedProducts = [
    { name: "مرشح توافقي نشط AHF", href: "/products#ahf", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
    { name: "مولد فار ثابت SVG", href: "/products#svg", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
    { name: "SiC-AHF/SVG عالي الكفاءة", href: "/products#sic", icon: "M13 10V3L4 14h7v7l9-11h-7z" }
  ];
const relatedCases = [
  { name: "تحسين جودة الطاقة في مزرعة دبي الشمسية 50 ميجاوات", industry: "الطاقة المتجددة", href: "/ar/news/solar-farm-dubai" },
  { name: "تحديث معايير جودة الطاقة السعودية", industry: "التصنيع", href: "/ar/news/saudi-arabia-standards" },
  { name: "دراسة حالة: AHF بقدرة 300 أمبير يستعيد بنوك المكثفات في مركز بيانات", industry: "مراكز البيانات", href: "/ar/news/blog-data-center-ahf-case-study" }
];

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/ar' + p : p;
const SHARE_URL = getHreflang('ar', Astro.url.pathname);
---
<BaseLayout
  title={`${article.title} | CHITEK INNOPOWER`} 
  description={article.description} 
  lang="ar"
  ogType="article"
  ogTitle={article.title}
  ogDescription={article.description}
  ogImage="https://ar.chitek-inno.com/assets/images/index-product-ahf.webp"
  alternateLangs={['zh', 'en', 'es', 'ar']}
>
  <!-- Schema.org Article Structured Data -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "دراسة حالة: AHF يستعيد جودة الطاقة في مصنع نفط وغاز",
    "description": "كيف خفض AHF من CHITEK مستوى THDi من 32.5% إلى 3.8% في مصنع نفط وغاز.",
    "image": "https://ar.chitek-inno.com/assets/images/index-product-ahf.webp",
    "author": {"@type": "Organization","name": "CHITEK Technical Team"},
    "publisher": {"@type": "Organization","name": "CHITEK INNOPOWER","logo": {"@type": "ImageObject","url": "https://ar.chitek-inno.com/assets/images/logo.webp"}},
    "datePublished": "2026-07-05",
    "dateModified": "2026-07-05",
    "keywords": "كيف, خفض, AHF, من, CHITEK, مستوى"
  }
  </script>

  <Sidebar lang="ar" />

  <!-- Article Header -->
  <section class="pt-[72px] bg-bg-dark text-white relative overflow-hidden" dir="rtl">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-orange/20 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 py-16 md:py-20">
      <a href={'/ar/news'} class="inline-flex items-center text-brand-orange text-sm font-semibold mb-6 hover:underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 mr-2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        العودة إلى الأخبار
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold text-[#2e7d32] bg-[#e8f5e9] px-3 py-1 rounded-full">{article.category}</span>
        <span class="text-xs text-gray-400">{article.dateDisplay}</span>
        <span class="text-xs text-gray-400">&middot;</span>
        <span class="text-xs text-gray-400">{article.readTime}</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-[family-name:var(--font-barlow-condensed)] tracking-tight max-w-4xl">
        {article.title}
      </h1>
    </div>
  </section>

  <!-- Article Content + Sidebar -->
  <section class="py-12 md:py-16 bg-white" dir="rtl">
    <div class="max-w-7xl mx-auto px-5 md:px-12 flex flex-col lg:flex-row gap-10">

      <!-- Main Content -->
      <article class="flex-1 max-w-4xl">
        <!-- Featured Image -->
        <div class="w-full h-64 md:h-96 rounded-xl overflow-hidden mb-10 bg-gray-50">
          <img src="/assets/images/news/news-img-7.webp" alt="دراسة حالة: AHF يستعيد جودة الطاقة في مصنع نفط وغاز" class="w-full h-full object-cover" loading="eager" />
        </div>

        <div class="prose prose-lg max-w-none">

<p class="text-text-mid text-lg leading-relaxed mb-6" dir="rtl">استخدم مصنع معالجة النفط والغاز محولات VFD كانت تحقن تياراً توافقياً في حافلة الجهد المنخفض. توضح دراسة الحالة هذه كيف قام AHF من CHITEK بحل المشكلة.</p>
<h2 id="results" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4" dir="rtl">النتائج المقاسة</h2>
<p class="text-text-mid leading-relaxed mb-6" dir="rtl">انخفض THDi من <strong>32.5% إلى 3.8%</strong>، وانخفضت درجة حرارة المحول 18 &deg;C.</p>
<h2 id="conclusion" class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4" dir="rtl">الاستنتاج</h2>
<p class="text-text-mid leading-relaxed mb-6" dir="rtl">يثبت AHF منخفض الجهد والمصمم بشكل مناسب قدرته على استعادة جودة الطاقة في منشآت النفط والغاز.</p>

        </div>

        <!-- SEO Keywords -->
        <div class="mt-10 pt-6 border-t border-border-light">
          <div class="flex flex-wrap gap-2">
            {article.keywords.map((keyword) => (
              <span class="text-xs text-text-muted bg-gray-100 px-3 py-1 rounded-full">#{keyword}</span>
            ))}
          </div>
        </div>

        <!-- Author & Share -->
        <div class="mt-12 pt-8 border-t border-border-light">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-orange to-brand-orange-dark flex items-center justify-center text-white font-bold text-lg">C</div>
              <div>
                <p class="font-semibold text-text-dark">{article.author}</p>
                <p class="text-sm text-text-muted">نُشر {article.dateDisplay}</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm text-text-muted">مشاركة:</span>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(SHARE_URL)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
  <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
</a>
<a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(SHARE_URL)}&text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Twitter" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
  <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.05c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/></svg>
</a>
<a href="https://www.facebook.com/profile.php?id=61579260405315" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
  <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
</a>
            </div>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="lg:w-[320px] shrink-0">
        <div class="lg:sticky lg:top-[88px] space-y-4">

          <!-- Other Articles -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              المزيد من المقالات
            </h3>
            <div class="space-y-2">
              {otherArticles.map((item) => (
                <a href={lp(item.href)} class="block p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="text-sm font-semibold text-text-dark leading-snug">{item.title}</div>
                </a>
              ))}
            </div>
          </div>

          <!-- Related Products -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
              المنتجات ذات الصلة
            </h3>
            <div class="space-y-2">
              {relatedProducts.map((product) => (
                <a href={lp(product.href)} class="block p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="flex items-center gap-2">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-brand-orange shrink-0">
                      <path d={product.icon}/>
                    </svg>
                    <span class="text-sm font-semibold text-text-dark leading-snug">{product.name}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- Customer Cases -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              حالات العملاء
            </h3>
            <div class="space-y-2">
              {relatedCases.map((c) => (
                <div class="p-2.5 bg-white rounded-lg border border-border-light">
                  <div class="text-sm font-semibold text-text-dark leading-snug">{c.name}</div>
                  <div class="text-xs text-text-muted mt-0.5">{c.industry}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>