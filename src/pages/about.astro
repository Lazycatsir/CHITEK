---
import BaseLayout from '../layouts/BaseLayout.astro';

const meta = {
  title: '关于CHITEK – 电能质量企业简介与资质认证',
  description: 'CHITEK成立于2019年，是一家专注于电力电子研发、制造和服务的高新技术企业。ISO 9001认证，拥有20余项专利。',
};
---

<BaseLayout title={meta.title} description={meta.description} lang="zh">
  <!-- ABOUT -->
  <section class="about relative overflow-hidden bg-bg-mid text-white mt-[72px] min-h-[calc(100vh-72px)] flex flex-col justify-center py-10 scroll-mt-[72px]" id="about">
    <div class="absolute inset-0 bg-[url('/assets/images/about-bg-480w.webp')] md:bg-[url('/assets/images/about-bg-960w.webp')] xl:bg-[url('/assets/images/about-bg.webp')] bg-cover bg-center opacity-30 z-0"></div>
    <div class="absolute inset-0 bg-[rgba(7,16,30,0.7)] z-[1]"></div>

    <!-- 顶部标题区域 -->
    <div class="relative z-10 text-center px-5 pt-6 pb-4 max-w-[900px] mx-auto opacity-0 translate-y-6 transition-all duration-[600ms] ease fade-up">
      <h1 class="font-barlow-condensed text-[clamp(36px,5vw,72px)] font-bold uppercase tracking-[0.02em] mb-[clamp(8px,2vw,32px)] text-white leading-[1.1]">公司简介</h1>
    </div>

    <!-- 主体大框 (包含左右内容) -->
    <div class="relative z-10 flex flex-col md:flex-row w-[clamp(320px,90vw,1800px)] mx-auto max-md:mx-3 mb-[clamp(8px,1.5vw,32px)] bg-white/[0.03] border border-white/15 shadow-2xl opacity-0 translate-y-6 transition-all duration-[600ms] ease fade-up">
      <!-- 左侧 关于CHITEK 区域 -->
      <div class="flex-1 px-[clamp(12px,2vw,56px)] py-[clamp(16px,3vw,72px)] flex flex-col justify-center border-b md:border-b-0 md:border-r border-white/10">
        <h2 class="font-barlow-condensed text-[32px] font-bold leading-[1.2] mb-[clamp(12px,2vw,32px)] uppercase tracking-[0.02em] text-white">关于 <span class="text-brand-orange">CHITEK</span></h2>
        <div class="w-10 h-[3px] bg-brand-orange mb-[clamp(12px,2vw,32px)]"></div>
        <p class="text-[clamp(13px,0.9vw,16px)] leading-[1.8] text-white/75 mb-[clamp(16px,2.5vw,40px)]">
          深圳市启点新能源科技有限公司成立于2019年，总部位于深圳，是一家专注于电力电子产品研发、制造和销售服务的高新技术企业。致力于打造节能、绿色的未来。
        </p>
        <a href="#" class="inline-flex items-center gap-2.5 bg-brand-orange text-[#0f2040] text-[13px] font-bold tracking-[0.05em] uppercase px-7 py-3.5 rounded-sm no-underline transition-all duration-300 w-fit border-none hover:bg-white hover:-translate-y-0.5 hover:shadow-md">
          <svg viewBox="0 0 24 24" class="w-[18px] h-[18px] fill-current stroke-none">
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
          播放视频
        </a>
      </div>

      <!-- 右侧四大优势区域 -->
      <div class="flex-[1.2] grid grid-cols-2">
        <!-- 优势 1 -->
        <div class="px-[clamp(12px,2vw,40px)] py-[clamp(16px,3vw,56px)] flex flex-col items-center justify-center text-center border-r border-b border-white/10 hover:bg-[rgba(234,81,30,0.05)] transition-colors duration-300 relative">
          <div class="font-barlow-condensed text-[42px] font-bold leading-[1] text-brand-orange mb-3">60<sup class="text-[16px] align-super text-brand-orange">%</sup></div>
          <h3 class="text-[clamp(12px,1.1vw,17px)] font-bold text-white mb-2 leading-[1.4] uppercase tracking-[0.02em]">经验丰富的研发团队</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-[1.6] text-white max-w-[180px]">60%成员拥有硕士及以上学历，来自世界领先企业</p>
        </div>

        <!-- 优势 2 -->
        <div class="px-[clamp(12px,2vw,40px)] py-[clamp(16px,3vw,56px)] flex flex-col items-center justify-center text-center border-b border-white/10 hover:bg-[rgba(234,81,30,0.05)] transition-colors duration-300 relative">
          <div class="w-12 h-12 mb-4 text-brand-orange text-left">
            <svg viewBox="0 0 64 64" class="w-full h-full stroke-current stroke-[1.5] fill-none">
              <circle cx="32" cy="32" r="8" />
              <ellipse cx="32" cy="32" rx="24" ry="10" transform="rotate(0 32 32)" />
              <ellipse cx="32" cy="32" rx="24" ry="10" transform="rotate(60 32 32)" />
              <ellipse cx="32" cy="32" rx="24" ry="10" transform="rotate(120 32 32)" />
            </svg>
          </div>
          <h3 class="text-[clamp(12px,1.1vw,17px)] font-bold text-white mb-2 leading-[1.4] uppercase tracking-[0.02em]">自主研发设计</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-[1.6] text-white max-w-[180px]">20余项专利覆盖产品研发与制造</p>
        </div>

        <!-- 优势 3 -->
        <div class="px-[clamp(12px,2vw,40px)] py-[clamp(16px,3vw,56px)] flex flex-col items-center justify-center text-center border-r border-white/10 hover:bg-[rgba(234,81,30,0.05)] transition-colors duration-300 relative">
          <div class="w-12 h-12 mb-4 text-brand-orange text-left">
            <svg viewBox="0 0 64 64" class="w-full h-full stroke-current stroke-[1.5] fill-none">
              <path d="M20 20 L44 20 L44 44 L20 44 Z" stroke-linecap="round" />
              <circle cx="38" cy="38" r="10" stroke-linecap="round" />
              <line x1="42" y1="42" x2="48" y2="48" stroke-linecap="round" />
            </svg>
          </div>
          <h3 class="text-[clamp(12px,1.1vw,17px)] font-bold text-white mb-2 leading-[1.4] uppercase tracking-[0.02em]">多元化产品</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-[1.6] text-white max-w-[180px]">全系列产品覆盖不同客户应用场景</p>
        </div>

        <!-- 优势 4 -->
        <div class="px-[clamp(12px,2vw,40px)] py-[clamp(16px,3vw,56px)] flex flex-col items-center justify-center text-center hover:bg-[rgba(234,81,30,0.05)] transition-colors duration-300 relative">
          <div class="w-12 h-12 mb-4 text-brand-orange text-left">
            <svg viewBox="0 0 64 64" class="w-full h-full stroke-current stroke-[1.5] fill-none">
              <circle cx="32" cy="16" r="8" />
              <path d="M16 32 L48 32 L56 48 L8 48 Z" stroke-linecap="round" stroke-linejoin="round" />
              <polygon points="24,36 26,42 32,42 34,48 38,42 44,42 40,36" fill="currentColor" stroke="none" />
            </svg>
          </div>
          <h3 class="text-[clamp(12px,1.1vw,17px)] font-bold text-white mb-2 leading-[1.4] uppercase tracking-[0.02em]">品质保障</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-[1.6] text-white max-w-[180px]">ISO认证制造，确保最高质量标准</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 行业应用案例 -->
  <section class="relative w-full overflow-hidden bg-white" id="industry">
    <div class="relative z-10 w-full pt-12 max-md:pt-8">
      <div class="text-center mb-8 max-md:mb-5 fade-up">
        <h2 class="font-barlow-condensed text-[clamp(28px,3vw,52px)] font-bold text-text-dark uppercase tracking-wide">行业应用案例</h2>
        <div class="w-[60px] h-[3px] bg-brand-orange mx-auto mt-3"></div>
      </div>

      <div class="grid grid-cols-3 max-md:grid-cols-2 max-sm:grid-cols-1 fade-up">
        <a href="/solutions#industry" class="relative group block overflow-hidden aspect-[4/3]">
          <img src="/assets/images/about-industry-manufacturing.webp" srcset="/assets/images/about-industry-manufacturing-480w.webp 480w, /assets/images/about-industry-manufacturing-960w.webp 960w, /assets/images/about-industry-manufacturing.webp 1524w" sizes="100vw" alt="工业制造" width="1524" height="871" class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 transition-all duration-300 flex items-center justify-center max-md:bg-black/40 max-md:opacity-100">
            <span class="text-white text-[clamp(16px,1.5vw,24px)] max-md:text-[14px] font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-300 tracking-wide max-md:opacity-100">工业制造</span>
          </div>
        </a>
        <a href="/solutions#commercial" class="relative group block overflow-hidden aspect-[4/3]">
          <img src="/assets/images/about-industry-commercial-medical.webp" srcset="/assets/images/about-industry-commercial-medical-480w.webp 480w, /assets/images/about-industry-commercial-medical-960w.webp 960w, /assets/images/about-industry-commercial-medical.webp 1380w" sizes="100vw" alt="商业及医疗建筑" width="1380" height="920" class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 transition-all duration-300 flex items-center justify-center max-md:bg-black/40 max-md:opacity-100">
            <span class="text-white text-[clamp(16px,1.5vw,24px)] max-md:text-[14px] font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-300 tracking-wide max-md:opacity-100">商业及医疗建筑</span>
          </div>
        </a>
        <a href="/solutions#datacenter" class="relative group block overflow-hidden aspect-[4/3]">
          <img src="/assets/images/about-industry-datacenter.webp" srcset="/assets/images/about-industry-datacenter-480w.webp 480w, /assets/images/about-industry-datacenter-960w.webp 960w, /assets/images/about-industry-datacenter.webp 1504w" sizes="100vw" alt="数据中心与通信" width="1504" height="860" class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 transition-all duration-300 flex items-center justify-center max-md:bg-black/40 max-md:opacity-100">
            <span class="text-white text-[clamp(16px,1.5vw,24px)] max-md:text-[14px] font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-300 tracking-wide max-md:opacity-100">数据中心与通信</span>
          </div>
        </a>
        <a href="/solutions#renewable" class="relative group block overflow-hidden aspect-[4/3]">
          <img src="/assets/images/about-industry-renewable.webp" srcset="/assets/images/about-industry-renewable-480w.webp 480w, /assets/images/about-industry-renewable-960w.webp 960w, /assets/images/about-industry-renewable.webp 1535w" sizes="100vw" alt="新能源" width="1535" height="877" class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 transition-all duration-300 flex items-center justify-center max-md:bg-black/40 max-md:opacity-100">
            <span class="text-white text-[clamp(16px,1.5vw,24px)] max-md:text-[14px] font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-300 tracking-wide max-md:opacity-100">新能源</span>
          </div>
        </a>
        <a href="/solutions#rail" class="relative group block overflow-hidden aspect-[4/3]">
          <img src="/assets/images/about-industry-transportation.webp" srcset="/assets/images/about-industry-transportation-480w.webp 480w, /assets/images/about-industry-transportation-960w.webp 960w, /assets/images/about-industry-transportation.webp 1316w" sizes="100vw" alt="交通运输" width="1316" height="877" class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 transition-all duration-300 flex items-center justify-center max-md:bg-black/40 max-md:opacity-100">
            <span class="text-white text-[clamp(16px,1.5vw,24px)] max-md:text-[14px] font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-300 tracking-wide max-md:opacity-100">交通运输</span>
          </div>
        </a>
        <a href="/solutions#grid" class="relative group block overflow-hidden aspect-[4/3]">
          <img src="/assets/images/about-industry-power-grid.webp" srcset="/assets/images/about-industry-power-grid-480w.webp 480w, /assets/images/about-industry-power-grid-960w.webp 960w, /assets/images/about-industry-power-grid.webp 1276w" sizes="100vw" alt="电网与公用事业" width="1276" height="957" class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/60 transition-all duration-300 flex items-center justify-center max-md:bg-black/40 max-md:opacity-100">
            <span class="text-white text-[clamp(16px,1.5vw,24px)] max-md:text-[14px] font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-300 tracking-wide max-md:opacity-100">电网与公用事业</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 核心优势 -->
  <section class="core-advantages relative w-full min-h-[calc(100vh-72px)] flex items-center justify-center py-16 px-[clamp(24px,8vw,160px)] overflow-hidden" id="core-advantages">
    <div class="absolute inset-0 bg-[url('/assets/images/about-key-features-480w.webp')] md:bg-[url('/assets/images/about-key-features-960w.webp')] xl:bg-[url('/assets/images/about-key-features.webp')] bg-cover bg-center z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[rgba(10,20,40,0.65)] to-[rgba(10,20,40,0.82)] z-[1]"></div>

    <div class="relative z-10 w-full text-center">
      <div class="fade-up">
        <h2 class="font-barlow-condensed text-[clamp(28px,3vw,52px)] font-bold text-white uppercase tracking-wide mb-3">核心优势</h2>
        <div class="w-[60px] h-[3px] bg-brand-orange mx-auto mb-[50px]"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-[clamp(12px,3vw,48px)] w-full fade-up">
        <!-- 优势 1: 经验丰富的研发团队 -->
        <div class="ca-card bg-white/[0.06] border border-white/10 rounded p-[clamp(16px,3vw,48px)] backdrop-blur transition-all duration-[350ms] hover:bg-brand-orange/[0.1] hover:border-brand-orange hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(0,0,0,0.3)]">
          <div class="text-[42px] font-bold leading-none text-brand-orange mb-4 text-left">60<sup class="text-[clamp(13px,1.1vw,17px)] align-super text-brand-orange">%</sup></div>
          <h3 class="text-[clamp(13px,1.1vw,17px)] font-bold text-white mb-2.5 tracking-wide text-left">经验丰富的研发团队</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-relaxed text-white/70 text-left">团队成员来自世界领先企业，60%以上拥有硕士及以上学历，确保电力电子创新领域的深厚技术专长。</p>
        </div>

        <!-- 优势 2: 核心专利技术 -->
        <div class="ca-card bg-white/[0.06] border border-white/10 rounded p-[clamp(16px,3vw,48px)] backdrop-blur transition-all duration-[350ms] hover:bg-brand-orange/[0.1] hover:border-brand-orange hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(0,0,0,0.3)]">
          <div class="w-12 h-12 mb-4 text-brand-orange text-left">
            <svg viewBox="0 0 64 64" class="w-full h-full stroke-current stroke-[1.5] fill-none">
              <circle cx="32" cy="32" r="8" />
              <ellipse cx="32" cy="32" rx="24" ry="10" transform="rotate(0 32 32)" />
              <ellipse cx="32" cy="32" rx="24" ry="10" transform="rotate(60 32 32)" />
              <ellipse cx="32" cy="32" rx="24" ry="10" transform="rotate(120 32 32)" />
            </svg>
          </div>
          <h3 class="text-[clamp(13px,1.1vw,17px)] font-bold text-white mb-2.5 tracking-wide text-left">核心专利技术</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-relaxed text-white/70 text-left">独立知识产权覆盖研发、设计和制造，20余项专利保护我们的创新成果。</p>
        </div>

        <!-- 优势 3: 产品质量管控 -->
        <div class="ca-card bg-white/[0.06] border border-white/10 rounded p-[clamp(16px,3vw,48px)] backdrop-blur transition-all duration-[350ms] hover:bg-brand-orange/[0.1] hover:border-brand-orange hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(0,0,0,0.3)]">
          <div class="w-12 h-12 mb-4 text-brand-orange text-left">
            <svg viewBox="0 0 64 64" class="w-full h-full stroke-current stroke-[1.5] fill-none">
              <path d="M20 20 L44 20 L44 44 L20 44 Z" stroke-linecap="round" />
              <circle cx="38" cy="38" r="10" stroke-linecap="round" />
              <line x1="42" y1="42" x2="48" y2="48" stroke-linecap="round" />
              <polyline points="26,28 28,30 32,26" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="text-[clamp(13px,1.1vw,17px)] font-bold text-white mb-2.5 tracking-wide text-left">产品质量管控</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-relaxed text-white/70 text-left">所有产品通过CQC、CE和ISO 9001国际认证，确保全球市场的可靠性能和合规性。</p>
        </div>

        <!-- 优势 4: 全流程服务 -->
        <div class="ca-card bg-white/[0.06] border border-white/10 rounded p-[clamp(16px,3vw,48px)] backdrop-blur transition-all duration-[350ms] hover:bg-brand-orange/[0.1] hover:border-brand-orange hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(0,0,0,0.3)]">
          <div class="w-12 h-12 mb-4 text-brand-orange text-left">
            <svg viewBox="0 0 64 64" class="w-full h-full stroke-current stroke-[1.5] fill-none stroke-linecap-round stroke-linejoin-round">
              <circle cx="32" cy="20" r="8" />
              <polygon points="16,52 24,32 40,32 48,52" stroke-linejoin="round" />
              <line x1="32" y1="40" x2="32" y2="50" />
              <line x1="24" y1="44" x2="40" y2="44" />
              <circle cx="28" cy="36" r="1.5" fill="currentColor" stroke="none" />
              <circle cx="36" cy="36" r="1.5" fill="currentColor" stroke="none" />
            </svg>
          </div>
          <h3 class="text-[clamp(13px,1.1vw,17px)] font-bold text-white mb-2.5 tracking-wide text-left">全流程服务</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-relaxed text-white/70 text-left">覆盖设计、制造、运维和维护阶段的综合服务和定制化解决方案。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 资质认证与荣誉 -->
  <section class="relative overflow-hidden py-12 px-[clamp(24px,8vw,160px)] bg-white" id="certifications">
    <div>
      <!-- Section Header -->
      <div class="text-center mb-14 fade-up">
        <div class="inline-flex items-center gap-3 mb-4 justify-center">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 text-brand-orange"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          <span class="text-[clamp(10px,0.8vw,14px)] text-brand-orange tracking-[0.15em] uppercase">资质认证与荣誉</span>
        </div>
        <h2 class="font-barlow-condensed text-[clamp(28px,3vw,56px)] font-bold text-text-dark uppercase tracking-[0.02em]">全球品质保障</h2>
        <div class="w-[60px] h-[3px] bg-gradient-to-r from-transparent via-brand-orange to-transparent mx-auto mb-4"></div>
        <p class="text-[15px] text-text-secondary max-w-[600px] mx-auto leading-relaxed">国际认证的质量管理和产品安全标准，确保在所有市场的可靠性能。</p>
      </div>

      <!-- Carousel -->
      <div class="relative fade-up" id="certCarousel">
        <div id="certTrack" class="flex transition-transform duration-500 ease-out">
          <!-- Card 1: CE -->
          <div class="cert-card min-w-[33.333%] max-md:min-w-full px-2">
            <div class="bg-bg-card border border-border-card rounded p-4 h-full transition-all duration-[350ms] hover:border-brand-orange hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(0,0,0,0.08)] flex flex-col items-center">
              <div class="w-full h-[72px] mb-2.5 bg-brand-orange/10 rounded flex items-center justify-center overflow-hidden">
                <span class="text-[clamp(18px,1.4vw,24px)] font-bold text-brand-orange font-barlow-condensed">CE</span>
              </div>
              <h3 class="text-[clamp(13px,1.1vw,17px)] font-bold text-text-dark text-center font-barlow-condensed tracking-wide">CE认证</h3>
              <p class="text-[clamp(10px,0.8vw,14px)] text-text-secondary text-center mt-1 leading-relaxed">TÜV莱茵认证，欧盟合规</p>
            </div>
          </div>
          <!-- Card 2: UL -->
          <div class="cert-card min-w-[33.333%] max-md:min-w-full px-2">
            <div class="bg-bg-card border border-border-card rounded p-4 h-full transition-all duration-[350ms] hover:border-brand-orange hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(0,0,0,0.08)] flex flex-col items-center">
              <div class="w-full h-[72px] mb-2.5 bg-brand-orange/10 rounded flex items-center justify-center overflow-hidden">
                <span class="text-[clamp(18px,1.4vw,24px)] font-bold text-brand-orange font-barlow-condensed">UL</span>
              </div>
              <h3 class="text-[clamp(13px,1.1vw,17px)] font-bold text-text-dark text-center font-barlow-condensed tracking-wide">UL 508认证</h3>
              <p class="text-[clamp(10px,0.8vw,14px)] text-text-secondary text-center mt-1 leading-relaxed">北美安全认证</p>
            </div>
          </div>
          <!-- Card 3: ISO -->
