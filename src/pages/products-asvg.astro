---
import BaseLayout from '../layouts/BaseLayout.astro';

const meta = {
  title: 'CHITEK — 高级静止无功发生器（ASVG）| 功率因数校正',
  description: 'CHITEK 高级静止无功发生器（ASVG）为低压电网提供无级无功补偿与功率因数校正——涵盖壁挂式、分布式与 IP65 系列。',
};

// 中文站无语言前缀（/products-asvg 就是中文站），因此 lp() 直通；
// 英文站之所以拼 '/en' 前缀，只是为了让本地 dev 能命中 /en 路由。
const lp = (p: string) => p;
---

<BaseLayout lang="zh" title={meta.title} description={meta.description}>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://chitek-inno.com/products" },
      { "@type": "ListItem", "position": 3, "name": "Advanced Static Var Generator" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": "zh-CN",
    "mainEntity": [
      { "@type": "Question", "name": "Q1：ASVG 与电容器组有什么区别？", "acceptedAnswer": { "@type": "Answer", "text": "电容器组以固定分级投切，补偿总是在负载已经变化之后才到位，而且可能与电网产生谐振。ASVG 持续读取无功需求，并在该瞬间精确注入所需容量——专为波动剧烈、粗分级补偿来不及起作用的场合而设计。" } },
      { "@type": "Question", "name": "Q2：一台 ASVG 能跟随班次之间乃至秒级变化的负载吗？", "acceptedAnswer": { "@type": "Answer", "text": "可以。焊接、电机启动、冲压线和变频器升速每秒都会多次改变无功需求，装置逐周期跟踪这些变化，而不是以接触器分级方式响应。同一闭环既能覆盖缓慢的日周期变化，也能覆盖快速波动。" } },
      { "@type": "Question", "name": "Q3：ASVG 装置可以并联以获得更高容量吗？", "acceptedAnswer": { "@type": "Answer", "text": "可以。该系列采用模块化设计——并联运行既可满足单台壁挂式模块，也能覆盖大型工厂，不必让所有负载都通过一个超大柜体。" } },
      { "@type": "Question", "name": "Q4：ASVG 可以安装在户外或恶劣环境中吗？", "acceptedAnswer": { "@type": "Answer", "text": "可以。除室内柜体外，该系列还提供面向户外及多尘场所的 IP65 型号；当粉尘、腐蚀或噪声成为主要制约因素时，可选防污染型与无风扇低噪型。" } }
    ]
  }
  </script>
  <!-- Mirrors /en/products-svg (SVG listing) — Advanced Static Var Generator series. Cards reuse the existing product photos; only names and tags are ASVG-specific. -->

  <!-- Hero Section removed (2026-09-24, user request) -->
