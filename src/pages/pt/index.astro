          </div>
          <div class="bg-white p-[clamp(8px,1.5vw,32px)] cursor-pointer flex flex-col justify-start hover:bg-[#fff9f6] transition-colors duration-200 ps-card">
            <div class="text-[clamp(11px,1vw,15px)] font-semibold text-brand-orange mb-2">Expansível em Paralelo</div>
            <div class="w-6 h-0.5 bg-brand-orange mb-3"></div>
            <div class="text-[clamp(10px,0.9vw,14px)] text-text-muted leading-[1.6]">Módulos em paralelo sem limite prático — expanda a capacidade de compensação à medida que a carga cresce.</div>
          </div>
          <div class="bg-white p-[clamp(8px,1.5vw,32px)] cursor-pointer flex flex-col justify-start hover:bg-[#fff9f6] transition-colors duration-200 ps-card">
            <div class="text-[clamp(11px,1vw,15px)] font-semibold text-brand-orange mb-2">Manutenção Fácil</div>
            <div class="w-6 h-0.5 bg-brand-orange mb-3"></div>
            <div class="text-[clamp(10px,0.9vw,14px)] text-text-muted leading-[1.6]">Quando um módulo avaria, não afeta os outros circuitos. Manutenção rápida em menos de 5 minutos.</div>
          </div>
          <div class="bg-white p-[clamp(8px,1.5vw,32px)] cursor-pointer flex flex-col justify-start hover:bg-[#fff9f6] transition-colors duration-200 ps-card">
            <div class="text-[clamp(11px,1vw,15px)] font-semibold text-brand-orange mb-2">Seguro e Fiável</div>
            <div class="w-6 h-0.5 bg-brand-orange mb-3"></div>
            <div class="text-[clamp(10px,0.9vw,14px)] text-text-muted leading-[1.6]">Funções completas de proteção contra falhas, classificado Grau de Poluição III para ambientes industriais adversos.</div>
          </div>
        </div>

        <!-- 右侧：图片介绍（2026-10-12 用户要求：手机端不显示 → <1024px 整块隐藏，≥1024px 保持原 flex） -->
        <div class="hidden lg:flex items-center justify-end fade-up conv-right">
          <div class="w-[clamp(160px,25vw,340px)] h-[clamp(300px,34vw,460px)] rounded-sm relative overflow-hidden bg-contain bg-center bg-no-repeat bg-[url('/assets/images/index-product-ahf.webp')]" id="product-visual"></div>
        </div>
      </div>
    </div>
  </section>
  <script>
    const productData = {
      ahf: { visual: '/assets/images/index-product-ahf.webp', infoId: 'info-ahf' },
      svg: { visual: '/assets/images/index-product-svg.webp', infoId: 'info-svg' }
    };

    const tabs = document.querySelectorAll('.tab');
    const infoItems = document.querySelectorAll('.product-info-item');
    const productVisual = document.getElementById('product-visual');

    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        const key = this.getAttribute('data-product');
        const data = productData[key];

        // 1. 切换 Tab 样式
        tabs.forEach(t => t.classList.remove('active'));
        this.classList.add('active');

        // 2. 切换左侧文字
        infoItems.forEach(item => {
          item.classList.remove('active');
        });
        const target = document.getElementById(data.infoId);
        target.classList.add('active');

        // 3. 切换右侧图片
        productVisual.style.backgroundImage = `url('${data.visual}')`;
      });
    });

    // STATS 数字滚动动画（可重复播放）
    const statNumbers = document.querySelectorAll('.stat-number');
    if (statNumbers.length) {
      const animateCount = (el) => {
        const target = parseInt(el.getAttribute('data-target'), 10) || 0;
        const duration = parseInt(el.getAttribute('data-duration'), 10) || 1500;
        if (el._rafId) cancelAnimationFrame(el._rafId);
        const start = performance.now();
        const step = (now) => {
          const p = Math.min((now - start) / duration, 1);
          const eased = target <= 50 ? p : 1 - Math.pow(1 - p, 3);
          el.textContent = Math.floor(eased * target).toString();
          if (p < 1) {
            el._rafId = requestAnimationFrame(step);
          } else {
            el.textContent = target.toString();
            el._rafId = null;
          }
        };
        el._rafId = requestAnimationFrame(step);
      };
      const statsObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCount(entry.target);
          } else {
            // 离开视口时重置，便于下次重新播放
            if (entry.target._rafId) cancelAnimationFrame(entry.target._rafId);
            entry.target._rafId = null;
            entry.target.textContent = '0';
          }
        });
      }, { threshold: 0.4 });
      statNumbers.forEach((el) => statsObserver.observe(el));
    }

    // HERO 轮播
    const heroSlides = Array.from(document.querySelectorAll('.hero-slide'));
    const heroTexts = Array.from(document.querySelectorAll('.hero-text'));
    const heroDots = Array.from(document.querySelectorAll('.hero-dot'));
    if (heroSlides.length > 1) {
      let heroIdx = 0;
      let heroTimer = null;
      /* 2026-10-21 性能 P0-2：首屏只加载第 1 张轮播图（LCP），其余两张延迟注入。
         这 3 张是 absolute inset-0 叠在首屏里，始终在视口内 → loading="lazy" 不生效，
         只能用 data-hero-src + 手动注入。省首屏约 228KB（第 2 张 64KB + 第 3 张 164KB）。
         无 JS 时第 1 张仍正常显示，轮播本身也依赖 JS，属渐进增强。 */
      const heroEnsure = (img) => {
        if (img && img.dataset.heroSrc && !img.hasAttribute('src')) {
          /* 一并注入 srcset：手机轮播时不再下 2000px 原图 */
          if (img.dataset.heroSrcset) img.setAttribute('srcset', img.dataset.heroSrcset);
          img.src = img.dataset.heroSrc;
        }
      };
      const heroShow = (i) => {
        heroSlides[heroIdx].classList.remove('hero-slide-active');
        if (heroTexts[heroIdx]) heroTexts[heroIdx].classList.remove('hero-text-active');
        if (heroDots[heroIdx]) heroDots[heroIdx].classList.remove('hero-dot-active');
        heroIdx = (i + heroSlides.length) % heroSlides.length;
        heroEnsure(heroSlides[heroIdx]);
        heroSlides[heroIdx].classList.add('hero-slide-active');
        if (heroTexts[heroIdx]) heroTexts[heroIdx].classList.add('hero-text-active');
        if (heroDots[heroIdx]) heroDots[heroIdx].classList.add('hero-dot-active');
        heroEnsure(heroSlides[(heroIdx + 1) % heroSlides.length]);
      };
      /* 首屏（load）完成后再预热第 2 张，不和 LCP 抢带宽，也避免首次切换出现空白 */
      const heroWarm = () => {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => heroEnsure(heroSlides[1]), { timeout: 2000 });
        } else {
          setTimeout(() => heroEnsure(heroSlides[1]), 600);
        }
      };
      if (document.readyState === 'complete') {
        heroWarm();
      } else {
        window.addEventListener('load', heroWarm, { once: true });
      }
      const heroStart = () => { heroTimer = setInterval(() => heroShow(heroIdx + 1), 5000); };
      const heroStop = () => { if (heroTimer) { clearInterval(heroTimer); heroTimer = null; } };
      heroDots.forEach((dot, i) => {
        dot.addEventListener('click', () => { heroStop(); heroShow(i); heroStart(); });
      });
      heroStart();
    }

    // FEATURED PRODUCTS 轮播：每次滑动一张卡，到边界禁用对应箭头
    const fpViewport = document.querySelector('[data-fp-viewport]');
    const fpTrack = document.querySelector('[data-fp-track]');
    if (fpViewport && fpTrack) {
      const fpItems = Array.from(fpTrack.children);
      const fpPrev = document.querySelector('[data-fp-prev]');
      const fpNext = document.querySelector('[data-fp-next]');
      let fpIndex = 0;

      const fpStep = () => {
        if (fpItems.length < 2) return fpViewport.clientWidth;
        return fpItems[1].getBoundingClientRect().left - fpItems[0].getBoundingClientRect().left;
      };
      const fpVisible = () => {
        const step = fpStep();
        return step > 0 ? Math.max(1, Math.round(fpViewport.clientWidth / step)) : 1;
      };
      const fpMax = () => Math.max(0, fpItems.length - fpVisible());
      const fpUpdate = () => {
        fpIndex = Math.min(Math.max(fpIndex, 0), fpMax());
        fpTrack.style.transform = `translateX(${-fpIndex * fpStep()}px)`;
        if (fpPrev) fpPrev.disabled = fpIndex <= 0;
        if (fpNext) fpNext.disabled = fpIndex >= fpMax();
      };

      fpPrev?.addEventListener('click', () => { fpIndex -= 1; fpUpdate(); });
      fpNext?.addEventListener('click', () => { fpIndex += 1; fpUpdate(); });
      window.addEventListener('resize', fpUpdate);
      fpUpdate();
    }

    // 可反复触发入场：进视口加 .visible，出视口移除；滚动回来重新播放
    // 作用对象：Product Series 左右两栏 + Solution Insights 标题与三张卡片
    const revealEls = document.querySelectorAll('.conv-left, .conv-right, .insight-title, .insight-card, .ps-card');
    if (revealEls.length) {
      const insightCards = Array.from(document.querySelectorAll('.insight-card'));
      const psCards = Array.from(document.querySelectorAll('.ps-card'));
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const el = entry.target;
          if (entry.isIntersecting) {
            if (el.classList.contains('insight-card')) {
              const i = insightCards.indexOf(el);
              setTimeout(() => el.classList.add('visible'), i * 120);
            } else if (el.classList.contains('ps-card')) {
              const i = psCards.indexOf(el);
              setTimeout(() => el.classList.add('visible'), i * 90);
            } else {
              el.classList.add('visible');
            }
          } else {
            el.classList.remove('visible');
          }
        });
      }, { threshold: 0.12 });
      revealEls.forEach((el) => revealObserver.observe(el));
    }
  </script>

  <style>
    .tab.active {
      color: #EA511E;
      border-bottom-color: #EA511E;
    }
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    .product-info-item {
      display: none;
    }
    .product-info-item.active {
      display: block;
    }
    .stat-number {
      font-variant-numeric: tabular-nums;
    }

    /* ── Featured products 推荐区 ── */
    .fp-track {
      --fp-gap: clamp(10px, 1.2vw, 22px);
      display: flex;
      gap: var(--fp-gap);
      transition: transform 480ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    .fp-item { flex: 0 0 100%; }
    @media (min-width: 768px) {
      .fp-item { flex: 0 0 calc((100% - var(--fp-gap)) / 2); }
    }
    @media (min-width: 1024px) {
      .fp-item { flex: 0 0 calc((100% - 4 * var(--fp-gap)) / 5); }
    }
    .fp-stage {
      background: #ffffff;
      border: 1px solid var(--color-border-light);
      height: clamp(160px, 17vw, 236px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(12px, 1.6vw, 26px);
      transition: border-color 250ms ease, box-shadow 250ms ease;
    }
    .fp-card:hover .fp-stage {
      border-color: var(--color-brand-orange);
      box-shadow: 0 8px 22px rgba(15, 32, 64, 0.07);
    }
    .fp-name {
      margin-top: clamp(10px, 1.1vw, 16px);
      font-size: clamp(13px, 0.95vw, 15px);
      font-weight: 600;
      line-height: 1.45;
      color: var(--color-text-dark);
      transition: color 200ms ease;
    }
    .fp-card:hover .fp-name { color: var(--color-brand-orange); }
    /* 2026-10-12：电流规格后缀（如 (50-200A)），与主名之间留一段间距。
       8ch（= tab-size 默认 8，一个制表位）用户觉得偏大 → 14:30 收到 4ch（半个 tab）；整段不换行，避免括号内断开。 */
    .fp-name .fp-spec {
      margin-left: 4ch;
      white-space: nowrap;
    }
    /* 2026-10-12 15:14：手机端 Customer Favorites 卡片标题**不换行**（用户要求）。
       <768px 时 .fp-item 是 100%（每面 1 张），卡宽 = 父容器 90vw。
       最长标题「208V/400V/480V Anti-Pollution AHF/SVG(50-200A)」@13px 需要 380px（含 spec 的 4ch 间距 34px），
       390px 屏只有 351px → 会折 2 行。实测 need(px) ≈ 27.3 × font-size。
       做法：① spec 间距收到 1ch（省约 25px）② 字号改为随视口线性缩放 clamp(10px,3.15vw,13px)。
       需要 fs ≤ 0.9W/27.3 ≈ 3.3vw，取 3.15vw 留约 4% 余量；≥414px 时仍回到 13px 原值。 */
    @media (max-width: 767px) {
      .fp-name { font-size: clamp(10px, 3.15vw, 13px); }
      .fp-name .fp-spec { margin-left: 1ch; }
    }
    /* 2026-10-13：Distributed 卡标题强制单行（用户要求）。
       单行所需宽度（236px@13px）> 五列时卡宽（1024–1440 带宽 174–245px），
       故把名称↔规格间距收到 1ch，并在 ≥1024 让该卡字号随 vw 略收（clamp 下限 10px）塞进卡片。 */
    .fp-item--single .fp-name { white-space: nowrap; }
    .fp-item--single .fp-name .fp-spec { margin-left: 1ch; }
    @media (min-width: 1024px) {
      .fp-item--single .fp-name { font-size: clamp(10px, 0.95vw, 15px); }
    }
    .fp-arrow {
      width: 42px;
      height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      background: #ffffff;
      border: 1px solid var(--color-text-dark);
      border-radius: 2px;
      color: var(--color-text-dark);
      cursor: pointer;
      transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .fp-arrow:hover:not(:disabled) {
      background: var(--color-brand-orange);
      border-color: var(--color-brand-orange);
      color: #ffffff;
    }
    .fp-arrow:disabled { opacity: 0.3; cursor: default; }
    /* 翻页控制区：<768px 上下两行居中；≥768px 箭头居中 + All Products 贴右箭头右侧 */
    .fp-nav {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(14px, 1.6vw, 26px);
    }
    .fp-nav-arrows {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }
    @media (min-width: 768px) {
      /* minmax(0,1fr) 保证左右两列等宽 → 箭头严格居中，位置与改版前一致 */
      .fp-nav {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        gap: 0;
      }
      .fp-nav-arrows { grid-area: 1 / 2; justify-content: center; }
      .fp-nav .fp-all {
        grid-area: 1 / 3;
        justify-self: start;
        margin-left: 16px;
        white-space: nowrap;
      }
    }
    .fp-all {
      display: inline-block;
      padding: 12px 36px;
      border: 1px solid var(--color-text-dark);
      border-radius: 2px;
      color: var(--color-text-dark);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .fp-all:hover {
      background: var(--color-brand-orange);
      border-color: var(--color-brand-orange);
      color: #ffffff;
    }
    .hero-slide {
      opacity: 0;
      transition: opacity 1200ms ease-in-out;
    }
    .hero-slide.hero-slide-active {
      opacity: 1;
    }
    .hero-text {
      opacity: 0;
      pointer-events: none;
      transition: opacity 1200ms ease-in-out;
    }
    .hero-text.hero-text-active {
      opacity: 1;
      pointer-events: auto;
    }
    .hero-dot {
      position: relative;
      width: 12px;
      height: 12px;
      border-radius: 9999px;
      background: rgba(255,255,255,0.45);
      border: none;
      cursor: pointer;
      padding: 0;
      transition: background 250ms ease, width 250ms ease;
    }
    /* 2026-10-21 移动端：原视觉 10×10 且无热区，手机上几乎点不中。
       视觉略放大到 12px，用伪元素把可点区域扩到 30×30（不改变布局与间距）。 */
    .hero-dot::after {
      content: '';
      position: absolute;
      inset: -9px;
      border-radius: 9999px;
    }
    .hero-dot.hero-dot-active {
      background: #EA511E;
      width: 28px;
    }
    /* Product Series: left & right columns converge toward the center */
    @media (min-width: 1024px) {
      .fade-up.conv-left  { transform: translateX(-64px); }
      .fade-up.conv-right { transform: translateX(64px); }
    }
    .fade-up.conv-left.visible,
    .fade-up.conv-right.visible { transform: translateY(0); }
    .conv-left, .conv-right { transition-delay: 120ms; }

    /* Product Series 中间功能网格：6 张卡片自上而下错峰浮现，进出视口可反复触发 */
    .ps-card { opacity: 0; transform: translateY(36px); transition: opacity .55s ease, transform .55s ease, background-color 200ms ease, color 200ms ease; }
    .ps-card.visible { opacity: 1; transform: translateY(0); }

    /* Solution Insights: 大标题从左滑入；三张卡片自下而上（错峰），进出视口可反复触发 */
    @media (min-width: 1024px) {
      .insight-title { transform: translateX(-64px); }
    }
    .insight-title.visible { transform: translateX(0); }
    .insight-title { transition-delay: 80ms; }
    .insight-card { opacity: 0; transform: translateY(64px); }
    .insight-card.visible { opacity: 1; transform: translateY(0); }

    /* Hero 字号 = 唯一来源（2026-09-30 用户要求「标题大小统一、小描述增大」）
       - 标题：删掉原 @media (max-height:940px) 放大到 4vw 的跳档规则 ——
         它让同一页在 900px 高时标题 57.6px、1000px 高时 48.96px，看起来「不统一」。
         现在所有帧、所有视口高度同一档 clamp(30px,3.4vw,50px)。
       - 描述：2026-10-08 用户要求「hero 小字再增大些」→ clamp(16px,1.3vw,19px)；矮屏档同步 15px → 17px（上一版 clamp(14px,1.2vw,17px)）。
       - ≤820px 高（矮屏笔记本）保留一档等比缩小，三帧一致生效。 */
    .hero-text .hero-title {
      font-size: clamp(30px, 3.4vw, 50px);
    }
    .hero-text .hero-title ~ p {
      font-size: clamp(16px, 1.3vw, 19px);
    }
    /* 手机端 hero 高度减半（600 -> 300，2026-10-21）：文字必须同步压小。
       未压缩前实测 390x844 文字块 298px（贴死 300），320x568 高达 352px 会被裁掉 26px。
       标题 22px、描述 13px、左右内边距 20px、橙色分隔线上下收紧，三帧一致。 */
    @media (max-width: 767px) {
      #hero-section .hero-text { padding-left: 20px; padding-right: 20px; }
      .hero-text .hero-title { font-size: 22px; }
      .hero-text .hero-title ~ p { font-size: 13px; }
