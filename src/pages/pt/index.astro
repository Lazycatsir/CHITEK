---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = {
  title: 'CHITEK — Fabricante de AHF e SVG de Baixa Tensão | Qualidade de Energia',
  description: 'A CHITEK fabrica equipamentos de qualidade de energia de baixa tensão — Filtro Ativo de Harmônicos (AHF), Gerador Estático de Var (SVG) e AVR — para instalações industriais e comerciais.',
};
// 本地开发/预览用 /en 前缀；线上（子域名承载语言）保持根相对
const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/pt' + p : p;

// Featured products：8 张 AHF 系列卡。⚠️ 2026-09-24 用户要求首页单独改名（去掉 "Active Harmonic Filter"、以系列后缀收尾）→ **名称已与 /en/products 列表页不一致**，图 / 链接仍一致。2026-10-08 后缀由 AHF 改为 AHF/SVG。每面 5 张（≥1024px）；第一面固定为 208V / 690V-800V / SiC / Ultra-Slim / IP65 SiC-Fanless。
// 2026-10-12：8 张卡全部加电流规格后缀 spec，渲染时用 .fp-spec 与主名隔开一个 tab 的间距（样式见页面 <style>）。
// spec 依次为：(50-200A) / (50-200A) / (50-200A) / (8-20A) / (25A) / (30-50A) / (100-150A) / (50A)
const featuredProducts = [
  { name: '208V/400V/480V Anti-contaminação Filtro Ativo de Harmônicos', spec: '(50-200A)', href: '/en/products/anti-pollution-ahf', img: 'products-ahf-anti-pollution' },
  { name: '690V/800V Anti-contaminação Filtro Ativo de Harmônicos', spec: '(85-100A)', href: '/en/products/anti-pollution-ahf', img: 'products-ahf-anti-pollution-690v-800v-rackmount' },
  { name: 'MOSFET de Carbeto de Silício Filtro Ativo de Harmônicos SiC', spec: '(50-200A)', href: '/en/products/sic-ultra-ahf', img: 'products-ahf-sic' },
  { name: 'Ultrafino Filtro Ativo de Harmônicos', spec: '(8-20A)', href: '/en/products/ultra-slim-ahf', img: 'products-ahf-ultra-slim-rackmount' },
  { name: 'IP65 SiC-Fanless Filtro Harmônico AHF/SVG', spec: '(25A)', href: '/en/products/sic-fanless-ahf', img: 'products-ahf-ip65-fanless' },
  { name: 'Distribuído Filtro Ativo de Harmônicos', spec: '(30-50A)', href: '/en/products/distributed-ahf', img: 'products-ahf-distributed-rackmount', single: true },
  { name: 'IP65 Filtro Ativo de Harmônicos', spec: '(100-150A)', href: '/en/products/ip65-ahf', img: 'products-ahf-ip65' },
  { name: 'SiC- Low Noise Fan Filtro Harmônico AHF/SVG', spec: '(50A)', href: '/en/products/sic-fanless-ahf', img: 'products-ahf-sic-fanless' }
];
---

<BaseLayout lang="pt" title={meta.title} description={meta.description}>
  <!-- HERO -->
  <section id="hero-section" class="hero relative overflow-hidden mt-[72px] min-h-[calc((100vh-72px)*2/5)] max-lg:min-h-[560px] max-md:min-h-[300px] flex items-center">
    <div class="hero-carousel absolute inset-0 z-0 pointer-events-none">
      <picture class="contents">
        <source media="(min-width:1024px)" srcset="/assets/images/index-hero-lineup-wide-1440w.webp 1440w, /assets/images/index-hero-lineup-wide.webp 3924w" sizes="100vw" />
        <img src="/assets/images/index-hero-lineup.webp" srcset="/assets/images/index-hero-lineup-480w.webp 480w, /assets/images/index-hero-lineup-960w.webp 960w, /assets/images/index-hero-lineup.webp 2172w" sizes="100vw" alt="Gama de Produtos mais Completa — AHF, SVG e ASVG, 208V a 800V, IP20 a IP65" width="2172" height="654" class="hero-slide hero-slide-active absolute inset-0 w-full h-full object-cover object-[center_35%] max-lg:object-[center_25%] max-md:object-[center_15%]" fetchpriority="high" />
      </picture>
      <img data-hero-src="/assets/images/index-hero-bg.webp" data-hero-srcset="/assets/images/index-hero-bg-480w.webp 480w, /assets/images/index-hero-bg-960w.webp 960w, /assets/images/index-hero-bg.webp 2000w" sizes="100vw" alt="Engenheiro a cablar equipamento de qualidade de energia montado em rack numa sala de servidores" width="2000" height="655" class="hero-slide absolute inset-0 w-full h-full object-cover object-[center_35%] max-lg:object-[center_25%] max-md:object-[center_15%]" />
      <img data-hero-src="/assets/images/products-key-features.webp" data-hero-srcset="/assets/images/products-key-features-480w.webp 480w, /assets/images/products-key-features-960w.webp 960w, /assets/images/products-key-features.webp 1920w" sizes="100vw" alt="I&D e fabrico internos — equipamento de qualidade de energia CHITEK numa planta de produção" width="1920" height="1025" class="hero-slide absolute inset-0 w-full h-full object-cover object-[center_35%] max-lg:object-[center_25%] max-md:object-[center_15%]" />
    </div>

    <!-- 文字面板 0：产品主题（第 1 页，2026-09-28 与能源面板对调后升为首屏） -->
    <div class="hero-text hero-text-active absolute inset-0 z-10 flex flex-col justify-center px-[clamp(24px,8vw,160px)]">
      <h1 class="hero-title font-barlow-condensed font-bold leading-[1.06] text-white mb-2.5">
        Baixa Tensão AHF, SVG e ASVG Fabricante<br />
        para Qualidade de Energia Industrial e Comercial
      </h1>
      <div class="w-14 h-[3px] bg-brand-orange mt-1 mb-4" aria-hidden="true"></div>
      <p class="font-normal text-white/85 leading-[1.55] max-w-[620px]">
        208V to 800V, IP20 to IP65, IGBT and SiC — engineered and manufactured
        in our own plant. One focus, the widest range.
      </p>
    </div>

    <!-- 文字面板 1：Easy Installation & Wiring（第 2 页，2026-09-30 由 Fullest Product Range 换入） -->
    <div class="hero-text absolute inset-0 z-10 flex flex-col justify-center px-[clamp(24px,8vw,160px)]">
      <p class="hero-title font-barlow-condensed font-bold leading-[1.06] text-white mb-2.5">
        Fácil Instalação e Cablagem
      </p>
      <div class="w-14 h-[3px] bg-brand-orange mt-1 mb-4" aria-hidden="true"></div>
      <p class="font-normal text-white/85 leading-[1.55] max-w-[620px] mb-5">
        Plug-and-play · terminais à prova de erros · afinação automática
      </p>
    </div>

    <!-- 文字面板 2：In-house R&D & Manufacturing（第 3 页，2026-09-30 新增，主题=研发生产实力） -->
    <div class="hero-text absolute inset-0 z-10 flex flex-col justify-center px-[clamp(24px,8vw,160px)]">
      <p class="hero-title font-barlow-condensed font-bold leading-[1.06] text-white mb-2.5">
        I&amp;D Interna e Fabrico
      </p>
      <div class="w-14 h-[3px] bg-brand-orange mt-1 mb-4" aria-hidden="true"></div>
      <p class="font-normal text-white/85 leading-[1.55] max-w-[620px] mb-5">
        Equipa de I&D experiente · 30+ patentes · Todas as certificações necessárias obtidas
      </p>
    </div>

    <!-- HERO 轮播指示点 -->
    <div class="hero-dots absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex gap-2.5">
      <button type="button" class="hero-dot hero-dot-active" data-slide="0" aria-label="Mostrar diapositiva 1 — Qualidade de Energia"></button>
      <button type="button" class="hero-dot" data-slide="1" aria-label="Mostrar diapositiva 2 — Instalação e Cablagem Fáceis"></button>
      <button type="button" class="hero-dot" data-slide="2" aria-label="Mostrar diapositiva 3 — I&D Interna e Fabrico"></button>
    </div>
  </section>

  <!-- FEATURED PRODUCTS
       2026-09-28 间距调整（用户要求变紧凑）：
       原来 h2 用 `relative` + 负 top 硬拽出 padding → 上间距恒等于 32px、下间距被 padding 放大（1440 下 61px）。
       改为直接用 pt / mb 控制：pt = 标题离上边沿，mb = 标题到卡片的间距，两边独立可调。 -->
  <section id="featured-products" class="bg-bg-page px-[clamp(24px,8vw,160px)] pt-[clamp(12px,1.1vw,16px)] pb-[clamp(36px,4.5vw,72px)]">
    <div class="w-[clamp(320px,90vw,1800px)]">
      <h2 class="relative ml-[calc(40px_-_clamp(24px,8vw,160px))] font-barlow-condensed text-[clamp(20px,2vw,48px)] font-bold leading-[1.2] text-text-dark mb-[clamp(14px,1.6vw,24px)]">
        Favoritos dos Clientes
      </h2>

      <!-- 滑动视窗 -->
      <div class="overflow-hidden" data-fp-viewport>
        <ul class="fp-track list-none m-0 p-0" data-fp-track>
          {featuredProducts.map((p) => (
            <li class={`fp-item${p.single ? ' fp-item--single' : ''}`}>
              <a href={p.href} class="fp-card block no-underline">
                <div class="fp-stage">
                  <img src={`/assets/images/${p.img}.webp`} srcset={`/assets/images/${p.img}-480w.webp 480w, /assets/images/${p.img}-960w.webp 960w, /assets/images/${p.img}.webp 1200w`} sizes="(max-width: 640px) 46vw, (max-width: 1024px) 30vw, 300px" alt={p.name} width="1200" height="1200" loading="lazy" class="max-w-full max-h-full object-contain" />
                </div>
                <h3 class="fp-name">{p.name}{p.spec && <span class="fp-spec">{p.spec}</span>}</h3>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- 翻页控制 + 全部产品（2026-09-30：All Products 移到「右箭头」右侧；左右箭头仍保持居中不动）
           ≥768px：grid 三列 1fr/auto/1fr，箭头落中列（严格居中），All Products 放第三列左对齐 → 紧贴右箭头右侧。
           <768px：回落成上下两行居中，避免窄屏被挤出容器。 -->
      <div class="fp-nav mt-[clamp(16px,2vw,32px)]">
        <div class="fp-nav-arrows">
          <button type="button" class="fp-arrow" data-fp-prev aria-label="Previous products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
          </button>
          <button type="button" class="fp-arrow" data-fp-next aria-label="Next products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
          </button>
        </div>
        <a href={lp('/products')} class="fp-all"Todos os Produtos
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="relative overflow-hidden bg-bg-mid text-white min-h-[calc(100vh-72px)] flex flex-col justify-center py-14" id="about">
    <div class="absolute inset-0 bg-[url('/assets/images/about-bg.webp')] bg-cover bg-center bg-no-repeat opacity-30 z-0"></div>
    <div class="absolute inset-0 bg-[rgba(7,16,30,0.7)] z-[1]"></div>


    <!-- 主体大框 -->
    <div class="relative z-10 flex flex-col md:flex-row w-[clamp(320px,90vw,1800px)] mx-auto max-md:mx-3 mb-[clamp(8px,1.5vw,32px)] bg-white/[0.03] border border-white/15 shadow-2xl opacity-0 translate-y-6 transition-all duration-[600ms] ease fade-up">
      <!-- 左侧 About CHITEK 区域 -->
      <div class="flex-1 px-[clamp(12px,2vw,56px)] py-[clamp(16px,3vw,72px)] flex flex-col justify-center border-b md:border-b-0 md:border-r border-white/10">
        <h2 class="font-barlow-condensed text-[45px] font-bold leading-[1.2] mb-[clamp(12px,2vw,32px)] uppercase tracking-[0.02em] text-white">SOBRE <span class="text-brand-orange">CHITEK</span></h2>
        <div class="w-10 h-[3px] bg-brand-orange mb-[clamp(12px,2vw,32px)]"></div>
        <p class="text-[clamp(13px,0.9vw,16px)] leading-[1.8] text-white/75 mb-[clamp(16px,2.5vw,40px)]">A Shenzhen CHITEK New Energy Technology Co., Ltd., fundada em 2019 e com sede em Shenzhen, é uma empresa de alta tecnologia especializada na investigação, desenvolvimento, fabricação e serviço de produtos eletrónicos de potência. Comprometida em construir um futuro eficiente e verde.</p>
        <a href={lp('/about')} class="inline-flex items-center gap-2.5 bg-brand-orange text-[#0f2040] text-[13px] font-bold tracking-[0.05em] uppercase px-7 py-3.5 rounded-sm no-underline transition-all duration-300 w-fit border-none hover:bg-white hover:-translate-y-0.5 hover:shadow-md">
          <svg viewBox="0 0 24 24" class="w-[18px] h-[18px] fill-current stroke-none">
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
          Ver Vídeo
        </a>
      </div>

      <!-- 右侧四大优势区域 -->
      <div class="flex-[1.2] grid grid-cols-1 md:grid-cols-2">
        <!-- 优势 1 -->
        <div class="px-[clamp(12px,2vw,40px)] py-[clamp(12px,2vw,36px)] flex flex-col items-center justify-center text-center md:border-r border-b border-white/10 hover:bg-[rgba(234,81,30,0.05)] transition-colors duration-300 relative">
          <div class="font-barlow-condensed text-[42px] font-bold leading-[1] text-brand-orange mb-3">60<sup class="text-[16px] align-super text-brand-orange">%</sup></div>
          <h3 class="text-[clamp(12px,1.1vw,17px)] font-bold text-white mb-2 leading-[1.4] uppercase tracking-[0.02em]">Equipa de I&D Experiente</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-[1.6] text-white max-w-[180px]">Capacidade sólida apoiada por uma equipa bem formada e altamente experiente</p>
        </div>

        <!-- 优势 2 -->
        <div class="px-[clamp(12px,2vw,40px)] py-[clamp(12px,2vw,36px)] flex flex-col items-center justify-center text-center border-b border-white/10 hover:bg-[rgba(234,81,30,0.05)] transition-colors duration-300 relative">
          <div class="w-12 h-12 mb-4 text-brand-orange">
            <svg viewBox="0 0 64 64" class="w-full h-full stroke-current stroke-[1.5] fill-none">
              <circle cx="32" cy="32" r="8" />
              <ellipse cx="32" cy="32" rx="24" ry="10" transform="rotate(0 32 32)" />
              <ellipse cx="32" cy="32" rx="24" ry="10" transform="rotate(60 32 32)" />
              <ellipse cx="32" cy="32" rx="24" ry="10" transform="rotate(120 32 32)" />
            </svg>
          </div>
          <h3 class="text-[clamp(12px,1.1vw,17px)] font-bold text-white mb-2 leading-[1.4] uppercase tracking-[0.02em]">Design Próprio</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-[1.6] text-white max-w-[180px]">Mais de 30 propriedades intelectuais cobrindo o desenvolvimento e fabricação de produtos</p>
        </div>

        <!-- 优势 3 -->
        <div class="px-[clamp(12px,2vw,40px)] py-[clamp(12px,2vw,36px)] flex flex-col items-center justify-center text-center md:border-r border-b border-white/10 md:border-b-0 hover:bg-[rgba(234,81,30,0.05)] transition-colors duration-300 relative">
          <div class="w-12 h-12 mb-4 text-brand-orange">
            <svg viewBox="0 0 64 64" class="w-full h-full stroke-current stroke-[1.5] fill-none">
              <path d="M20 20 L44 20 L44 44 L20 44 Z" stroke-linecap="round" />
              <circle cx="38" cy="38" r="10" stroke-linecap="round" />
              <line x1="42" y1="42" x2="48" y2="48" stroke-linecap="round" />
            </svg>
          </div>
          <h3 class="text-[clamp(12px,1.1vw,17px)] font-bold text-white mb-2 leading-[1.4] uppercase tracking-[0.02em]">Produtos Diversificados</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-[1.6] text-white max-w-[180px]">Gama completa de produtos cobrindo diferentes aplicações de clientes</p>
        </div>

        <!-- 优势 4 -->
        <div class="px-[clamp(12px,2vw,40px)] py-[clamp(12px,2vw,36px)] flex flex-col items-center justify-center text-center hover:bg-[rgba(234,81,30,0.05)] transition-colors duration-300 relative">
          <div class="w-12 h-12 mb-4 text-brand-orange">
            <svg viewBox="0 0 64 64" class="w-full h-full stroke-current stroke-[1.5] fill-none">
              <circle cx="32" cy="16" r="8" />
              <path d="M16 32 L48 32 L56 48 L8 48 Z" stroke-linecap="round" stroke-linejoin="round" />
              <polygon points="24,36 26,42 32,42 34,48 38,42 44,42 40,36" fill="currentColor" stroke="none" />
            </svg>
          </div>
          <h3 class="text-[clamp(12px,1.1vw,17px)] font-bold text-white mb-2 leading-[1.4] uppercase tracking-[0.02em]">Qualidade Garantida</h3>
          <p class="text-[clamp(10px,0.8vw,14px)] leading-[1.6] text-white max-w-[180px]">Fabricação certificada ISO que assegura os mais altos padrões de qualidade</p>
        </div>
      </div>
    </div>

    <!-- 统计数字：整合进 Company Intro 区域，不再单独成区 -->
    <div class="relative z-10 w-[clamp(320px,90vw,1800px)] mx-auto grid grid-cols-2 md:grid-cols-4 gap-y-10 gap-x-4 text-center pt-[clamp(20px,3vw,48px)]">
      <div class="flex flex-col items-center">
        <div class="font-barlow-condensed text-[clamp(40px,5vw,64px)] font-bold leading-[1] text-brand-orange"><span class="stat-number" data-target="2019" data-duration="1600">0</span></div>
        <div class="mt-3 text-[clamp(12px,1vw,15px)] font-semibold uppercase tracking-[0.08em] text-white/85">Fundada em</div>
      </div>
      <div class="flex flex-col items-center">
        <div class="font-barlow-condensed text-[clamp(40px,5vw,64px)] font-bold leading-[1] text-brand-orange"><span class="stat-number" data-target="2700" data-duration="1800">0</span><span class="text-[clamp(28px,3vw,40px)]">+</span></div>
        <div class="mt-3 text-[clamp(12px,1vw,15px)] font-semibold uppercase tracking-[0.08em] text-white/85">Área da Empresa</div>
      </div>
      <div class="flex flex-col items-center">
        <div class="font-barlow-condensed text-[clamp(40px,5vw,64px)] font-bold leading-[1] text-brand-orange"><span class="stat-number" data-target="30" data-duration="2600">0</span><span class="text-[clamp(28px,3vw,40px)]">+</span></div>
        <div class="mt-3 text-[clamp(12px,1vw,15px)] font-semibold uppercase tracking-[0.08em] text-white/85">Propriedades Intelectuais</div>
      </div>
      <div class="flex flex-col items-center">
        <div class="font-barlow-condensed text-[clamp(40px,5vw,64px)] font-bold leading-[1] text-brand-orange"><span class="stat-number" data-target="20" data-duration="2600">0</span><span class="text-[clamp(28px,3vw,40px)]">+</span></div>
        <div class="mt-3 text-[clamp(12px,1vw,15px)] font-semibold uppercase tracking-[0.08em] text-white/85">Países de Exportação</div>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="min-h-[calc(100vh-72px)] px-[clamp(24px,8vw,160px)] bg-[url('/assets/images/index-products-bg.webp')] bg-cover bg-center bg-no-repeat relative flex flex-col justify-center py-12" id="products">
    <div class="relative z-10">
      <div class="text-center mb-[clamp(16px,3vw,48px)] opacity-0 translate-y-6 transition-all duration-[600ms] ease fade-up">
        <h2 class="font-barlow-condensed text-[clamp(36px,4vw,48px)] font-bold uppercase tracking-[0.01em] leading-[1.1] mb-[clamp(4px,2vw,32px)]">Séries de Produtos</h2>
        <div class="flex justify-center gap-1 mt-[clamp(8px,2vw,32px)] relative border-b border-border-light max-w-[740px] mx-auto overflow-x-auto max-md:justify-start">
          <div class="tab active text-[14px] font-medium text-text-muted px-5 py-2 cursor-pointer relative border-b-2 border-transparent mb-[-1px] transition-colors duration-200 hover:text-brand-orange whitespace-nowrap shrink-0" data-product="ahf">Filtro Ativo de Harmônicos</div>
          <div class="tab text-[14px] font-medium text-text-muted px-5 py-2 cursor-pointer relative border-b-2 border-transparent mb-[-1px] transition-colors duration-200 hover:text-brand-orange whitespace-nowrap shrink-0" data-product="svg">Gerador Estático de Var</div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr_1fr] gap-[clamp(12px,3vw,48px)] items-start">
        <!-- 左侧：文字介绍 -->
        <div class="min-h-[240px] relative fade-up conv-left">
          <div class="product-info-item active" id="info-ahf">
            <h3 class="font-barlow-condensed text-[clamp(20px,2vw,32px)] font-bold uppercase mb-2">AHF</h3>
            <div class="w-8 h-[3px] bg-brand-orange mb-4"></div>
            <p class="text-[13px] text-text-muted leading-[1.7] mb-6">
              Os Filtros Ativos de Harmônicos (AHF) cobrem de 208V a 800V, com uma eficiência de até 99%. Um AHF é um filtro ativo em tempo real, baseado em IGBT ou SiC, que deteta as correntes harmónicas consumidas por cargas não lineares e injeta correntes iguais e opostas para as cancelar na fonte — restaurando uma forma de onda sinusoidal limpa e corrigindo o fator de potência. Utilizado em instalações industriais, edifícios comerciais, centros de dados, hospitais, carga de VE e parques renováveis onde preocupam a distorção harmónica, as penalizações de FP ou a instabilidade da rede.</p>
            <a href={lp('/products')} class="text-[11px] font-semibold tracking-[0.1em] uppercase text-text-muted no-underline flex items-center gap-1.5 hover:text-brand-orange transition-colors duration-200">Série de Filtros Ativos de Harmônicos &rarr;</a>
          </div>
          <div class="product-info-item" id="info-svg">
            <h3 class="font-barlow-condensed text-[clamp(20px,2vw,32px)] font-bold uppercase mb-2">SVG</h3>
            <div class="w-8 h-[3px] bg-brand-orange mb-4"></div>
            <p class="text-[13px] text-text-muted leading-[1.7] mb-6">O Gerador Estático de Var (SVG) da CHITEK emprega comutação IGBT ou SiC avançada até 25.6kHz para regular com precisão a magnitude e fase do voltagem do inversor. Um SVG é um compensador de potência reativa em tempo real que injeta ou absorve corrente reativa para corrigir dinamicamente o fator de potência e estabilizar o voltagem — eliminando penalizações, quebras e cintilação. Utilizado em instalações industriais, edifícios comerciais, centros de dados, parques renováveis, hubs de carga de VE e redes de utilidade onde preocupam a potência reativa, a flutuação de voltagem ou o desequilíbrio de carga.</p>
            <a href={lp('/products-svg')} class="text-[11px] font-semibold tracking-[0.1em] uppercase text-text-muted no-underline flex items-center gap-1.5 hover:text-brand-orange transition-colors duration-200">Série de Geradores Estáticos de Var &rarr;</a>
