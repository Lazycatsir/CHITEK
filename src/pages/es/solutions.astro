---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dataMap, heroImages, industryTitles } from '../../data/esSolutions.js';
import { solutionMeta } from '../../data/esSolutionMeta.js';
import { SYMPTOM_ROUTES, DECISION_TREE, ROUTE_DEVICE_LABEL } from '../../data/esSolutionRouting.js';
import { LOCALE_DOMAIN } from '../../i18n/index';

// Render an equipment list as prose: "a, b, c y d".
const eqText = (arr) =>
  arr.length < 2 ? (arr[0] || '') : arr.slice(0, -1).join(', ') + ' y ' + arr[arr.length - 1];

const LANG = 'es';
const PREFIX = '/es';
const PRODUCTS_PREFIX = PREFIX;

const meta = {
  title: 'Soluciones de calidad de energía – Aplicaciones industriales y de servicios públicos | CHITEK',
  description:
    'CHITEK ofrece soluciones de calidad de energía para fabricación industrial, edificios comerciales, centros de datos, energías renovables, transporte y redes eléctricas.',
};

const HOST = LOCALE_DOMAIN[LANG];
const canonical = `${HOST}/solutions`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${HOST}/` },
    { '@type': 'ListItem', position: 2, name: 'Soluciones', item: canonical },
  ],
};

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Soluciones de calidad de energía por sector',
  itemListElement: solutionMeta.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.navLabel,
    url: `${HOST}/solutions/${m.slug}`,
  })),
};
---

<BaseLayout title={meta.title} description={meta.description} lang="es">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemList)} />

  <main class="mt-[72px]">

    <section class="relative min-h-[46vh] flex flex-col justify-end overflow-hidden">
      <div class="absolute inset-0">
        <img src="/assets/images/solutions-commercial-medical-hero-bg.webp" alt="" class="object-cover w-full h-full" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
      </div>
      <div class="relative z-10 w-full px-[clamp(24px,8vw,160px)] pb-10 pt-16">
        <nav class="text-white/70 text-[13px] tracking-[0.08em] mb-3" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/es/" class="hover:text-brand-orange">Inicio</a></li>
            <li class="text-white/40" aria-hidden="true">/</li>
            <li class="text-white font-medium" aria-current="page">Soluciones</li>
          </ol>
        </nav>
        <h1 class="text-[clamp(28px,3.5vw,56px)] font-bold leading-tight text-white font-barlow-condensed max-w-4xl">
          Soluciones de calidad de energía por sector
        </h1>
        <p class="mt-5 text-[clamp(14px,1.2vw,20px)] text-white/80 max-w-2xl leading-relaxed">
          Filtrado de armónicos y compensación de reactivo para seis sectores de aplicación. Cada página nombra el equipo que causa el problema — bancos de variadores, soldadoras, hornos de inducción, rectificadores de UPS, controladores LED, cargas de tracción — y el dispositivo que CHITEK instala para ello.
        </p>
      </div>
    </section>

    <section class="px-[clamp(24px,8vw,160px)] py-12 lg:py-16">
      <h2 class="text-[clamp(22px,2.4vw,40px)] font-bold text-brand-navy font-barlow-condensed">
        Elija su sector
      </h2>
      <div class="mt-3 mb-8 w-36 h-[3px] rounded-full bg-brand-orange/70"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[clamp(16px,2vw,32px)]">
        {solutionMeta.map((m) => (
          <a
            href={`${PREFIX}/solutions/${m.slug}`}
            class="group bg-bg-card border border-border-card rounded-xl overflow-hidden hover:border-brand-orange transition-colors"
          >
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={heroImages[m.id]}
                alt=""
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-[clamp(16px,1.6vw,24px)]">
              <h3 class="text-[clamp(16px,1.4vw,22px)] font-semibold text-text-primary font-barlow-condensed">
                {m.navLabel}
              </h3>
              <p class="mt-2 text-[13px] text-text-secondary leading-relaxed">
                {m.card.lead}{" "}
                <strong class="font-semibold text-text-primary">{eqText(m.card.equipment)}</strong>.
              </p>
              <p class="mt-4 inline-flex items-center gap-1.5 text-electric-orange font-medium text-[13px]">
                Ver soluciones
                <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="px-[clamp(24px,8vw,160px)] py-10 lg:py-14 bg-bg-alt-1">
      <h2 class="text-[clamp(22px,2.4vw,40px)] font-bold text-brand-navy font-barlow-condensed">
        Por dónde empieza todo
      </h2>
      <div class="mt-3 mb-8 w-36 h-[3px] rounded-full bg-brand-orange/70"></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[clamp(16px,2vw,32px)] max-w-5xl">
        <div>
          <h3 class="text-[16px] font-semibold text-text-primary font-barlow-condensed">1. Mida primero</h3>
          <p class="mt-2 text-[13px] text-text-secondary leading-relaxed">
            Una encuesta de calidad de energía en el punto de acoplamiento común: espectro armónico, perfil reactivo y ciclo de carga. Dimensionar solo por el kVA del transformador es la causa habitual de que la instalación quede pequeña.
          </p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold text-text-primary font-barlow-condensed">2. Dimensione al espectro</h3>
          <p class="mt-2 text-[13px] text-text-secondary leading-relaxed">
            La capacidad del AHF sigue la corriente armónica medida; la del SVG sigue el balanceo reactivo. Si ya hay un banco de condensadores, el control antirresonancia y la posición del TC deciden si puede mantenerse.
          </p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold text-text-primary font-barlow-condensed">3. Verifique en sitio</h3>
          <p class="mt-2 text-[13px] text-text-secondary leading-relaxed">
            La aceptación se mide tras la energización frente al límite aplicable, normalmente GB/T 14549 o IEEE 519 en el punto de acoplamiento común.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ A. Tabla síntoma -> dispositivo (GEO: "qué dispositivo para qué problema" extraíble) ═══ -->
    <section class="px-[clamp(24px,8vw,160px)] py-12 lg:py-16">
      <h2 class="text-[clamp(22px,2.4vw,40px)] font-bold text-brand-navy font-barlow-condensed">
        ¿Qué dispositivo corrige qué problema?
      </h2>
      <div class="mt-3 mb-4 w-36 h-[3px] rounded-full bg-brand-orange/70"></div>
      <p class="max-w-4xl text-[14px] text-text-secondary leading-relaxed mb-8">
        Dos familias de producto, y la división entre ellas no es preferencia — sigue de lo que muestre la medición. El AHF elimina la corriente armónica. El SVG suministra y absorbe potencia reactiva. La tabla siguiente parte del síntoma, da la lectura que lo confirma y nombra el dispositivo que lo trata. Cuando un sitio muestra ambos, se dimensionan por separado en lugar de elegir uno.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-[13px] min-w-[860px]">
          <caption class="sr-only">Síntoma, medición confirmatoria y dispositivo recomendado para problemas de calidad de energía en baja tensión</caption>
          <thead>
            <tr class="bg-bg-alt-1">
              <th scope="col" class="border border-border-card px-4 py-3 font-semibold text-text-primary font-barlow-condensed w-[26%]">Síntoma</th>
              <th scope="col" class="border border-border-card px-4 py-3 font-semibold text-text-primary font-barlow-condensed w-[26%]">Qué medir primero</th>
              <th scope="col" class="border border-border-card px-4 py-3 font-semibold text-text-primary font-barlow-condensed w-[14%]">Dispositivo</th>
              <th scope="col" class="border border-border-card px-4 py-3 font-semibold text-text-primary font-barlow-condensed">Por qué funciona</th>
            </tr>
          </thead>
          <tbody>
            {SYMPTOM_ROUTES.map((r) => (
              <tr>
                <th scope="row" class="border border-border-card px-4 py-3 font-medium text-text-primary align-top leading-relaxed">
                  {r.symptom}
                </th>
                <td class="border border-border-card px-4 py-3 text-text-secondary align-top leading-relaxed">{r.measure}</td>
                <td class="border border-border-card px-4 py-3 align-top">
                  <span
                    class:list={[
                      'route-badge',
                      'inline-flex px-2.5 py-1 rounded text-[11px] font-bold tracking-[0.06em] whitespace-nowrap',
                      r.device === 'ahf' && 'bg-brand-navy text-white',
                      r.device === 'svg' && 'bg-brand-orange text-white',
                      r.device === 'both' && 'bg-bg-alt-3 text-brand-navy border border-brand-orange',
                    ]}
                  >
                    {ROUTE_DEVICE_LABEL[r.device]}
                  </span>
                </td>
                <td class="border border-border-card px-4 py-3 text-text-secondary align-top leading-relaxed">
                  {r.why}
                  <span class="block mt-1.5 text-[12px] text-text-muted">{r.note}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={`${PRODUCTS_PREFIX}/products`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border-card bg-bg-card text-[13px] font-semibold text-text-primary hover:border-brand-orange transition-colors"
        >
          Explorar filtros activos de armónicos (AHF)
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={`${PRODUCTS_PREFIX}/products-svg`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border-card bg-bg-card text-[13px] font-semibold text-text-primary hover:border-brand-orange transition-colors"
        >
          Explorar generadores estáticos de var (SVG)
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={`${PRODUCTS_PREFIX}/products-asvg`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border-card bg-bg-card text-[13px] font-semibold text-text-primary hover:border-brand-orange transition-colors"
        >
          Explorar generadores avanzados de var estáticos (ASVG)
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- ═══ B. Árbol de decisión (AHF vs SVG) — renderizado en servidor, funciona sin JS ═══ -->
    <section class="px-[clamp(24px,8vw,160px)] py-10 lg:py-14 bg-bg-alt-1" id="device-selector">
      <h2 class="text-[clamp(22px,2.4vw,40px)] font-bold text-brand-navy font-barlow-condensed">
        ¿Qué dispositivo necesito?
      </h2>
      <div class="mt-3 mb-4 w-36 h-[3px] rounded-full bg-brand-orange/70"></div>
      <p class="max-w-4xl text-[14px] text-text-secondary leading-relaxed mb-8">
        Recorra las tres preguntas siguientes. Todo el árbol está en la página, así puede leer la ruta de principio a fin sin hacer clic en nada, o avanzar paso a paso si lo prefiere.
      </p>

      <div class="max-w-5xl" id="dq-widget" role="group" aria-label="Selector de dispositivo AHF o SVG">
        <div class="space-y-6">
          {Object.entries(DECISION_TREE).filter(([, node]) => node.options).map(([nodeId, node]) => (
            <div class="bg-bg-card border border-border-card rounded-xl p-[clamp(16px,2vw,28px)] dq-panel" data-node={nodeId}>
              <p class="text-[11px] font-bold tracking-[0.1em] text-text-muted uppercase">Paso</p>
              <h3 class="mt-1 text-[clamp(16px,1.5vw,22px)] font-semibold text-text-primary font-barlow-condensed">
                {node.question}
              </h3>
              <div class="mt-4 flex flex-wrap gap-2.5">
                {node.options.map((o) => (
                  <button
                    type="button"
                    class="dq-btn inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-border-card bg-bg-alt-1 text-[13px] font-medium text-text-primary text-left hover:border-brand-orange hover:text-brand-orange transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange"
                    data-next={o.next}
                  >
                    {o.label}
                    <span aria-hidden="true">&rarr;</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-6 space-y-4">
          {Object.entries(DECISION_TREE).filter(([, node]) => node.device).map(([nodeId, node]) => (
            <div class="dq-result hidden bg-bg-card border-l-[3px] border-brand-orange rounded-r-xl p-[clamp(16px,2vw,28px)]" data-result={nodeId} role="group" aria-live="polite" aria-label="Recomendación de dispositivo">
              <p class="text-[11px] font-bold tracking-[0.1em] uppercase text-electric-orange">
                Recomendación — {ROUTE_DEVICE_LABEL[node.device]}
              </p>
              <h3 class="mt-1.5 text-[clamp(17px,1.6vw,24px)] font-bold text-brand-navy font-barlow-condensed">
                {node.heading}
              </h3>
              <p class="mt-2.5 text-[14px] text-text-secondary leading-relaxed max-w-3xl">{node.body}</p>

              <h4 class="mt-5 text-[13px] font-bold text-brand-navy font-barlow-condensed tracking-[0.04em] uppercase">
                Qué hacer a continuación
              </h4>
              <ul class="mt-2 space-y-1.5">
                {node.nextSteps.map((s) => (
                  <li class="flex items-start gap-2 text-[13px] text-text-secondary leading-relaxed">
                    <span class="mt-[6px] w-1.5 h-1.5 rounded-full bg-brand-orange flex-shrink-0"></span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-5 flex flex-wrap gap-3">
                {
                  node.device === 'ahf' && (
                    <a href={`${PRODUCTS_PREFIX}/products`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-orange text-white text-[13px] font-semibold no-underline hover:bg-electric-orange transition-colors">
                      Ver modelos AHF
                    </a>
                  )
                }
                {
                  node.device === 'svg' && (
                    <a href={`${PRODUCTS_PREFIX}/products-svg`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-orange text-white text-[13px] font-semibold no-underline hover:bg-electric-orange transition-colors">
                      Ver modelos SVG
                    </a>
                  )
                }
                {
                  node.device === 'both' && (
                    <>
                      <a href={`${PRODUCTS_PREFIX}/products`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-orange text-white text-[13px] font-semibold no-underline hover:bg-electric-orange transition-colors">
                        Ver modelos AHF
                      </a>
                      <a href={`${PRODUCTS_PREFIX}/products-svg`} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-orange text-white text-[13px] font-semibold no-underline hover:bg-electric-orange transition-colors">
                        Ver modelos SVG
                      </a>
                    </>
                  )
                }
                <button type="button" class="dq-reset px-5 py-2.5 rounded-lg border border-border-card bg-bg-card text-[13px] font-semibold text-text-primary hover:border-brand-orange transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange">
                  Empezar de nuevo
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <details class="mt-8 max-w-5xl group">
        <summary class="cursor-pointer text-[14px] font-semibold text-text-primary hover:text-brand-orange">
          Mostrar la ruta de decisión completa como lista
        </summary>
        <ol class="mt-4 space-y-4 text-[13px] text-text-secondary leading-relaxed list-decimal pl-5">
          {Object.entries(DECISION_TREE).filter(([, node]) => node.options).map(([nodeId, node]) => (
            <li>
              <span class="font-semibold text-text-primary">{node.question}</span>
              <ul class="mt-1.5 space-y-1 list-none pl-0">
                {node.options.map((o) => (
                  <li>
                    &middot; {o.label} &rarr;{' '}
                    <span class="text-text-primary">
                      {DECISION_TREE[o.next].heading || DECISION_TREE[o.next].question}
                    </span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </details>
    </section>

    <section class="px-[clamp(24px,8vw,160px)] py-12 lg:py-16 text-center">
      <h2 class="text-[clamp(19px,1.8vw,28px)] font-bold text-brand-navy font-barlow-condensed">
        Obtenga una evaluación de calidad de energía para su sitio
      </h2>
      <p class="mt-3 text-[14px] text-text-secondary max-w-2xl mx-auto leading-relaxed">
        Envíenos su diagrama unifilar y lista de cargas y le diremos qué mediríamos primero.
      </p>
      <a
        href="/es/contact"
        class="inline-block mt-6 px-8 py-3 rounded-lg bg-brand-orange text-white font-semibold text-[15px] hover:bg-electric-orange transition-colors"
      >
        Contacte a nuestros ingenieros
      </a>
    </section>

  </main>
  <script>
    // ── Árbol de decisión AHF vs SVG ──
    // Mejora progresiva: todos los paneles ya están en el DOM y la ruta completa se
    // lista en <details>, así la sección se lee de principio a fin sin JS.
    (function () {
      'use strict';
      var root = document.getElementById('dq-widget');
      if (!root) return;
      if (root.getAttribute('data-dq-ready') === '1') return;
      root.setAttribute('data-dq-ready', '1');

      var panels = root.querySelectorAll('.dq-panel');
      var results = root.querySelectorAll('.dq-result');
      var resets = root.querySelectorAll('.dq-reset');

      function show(nodeId) {
        panels.forEach(function (p) {
          var match = p.getAttribute('data-node') === nodeId;
          p.classList.toggle('hidden', !match);
          if (match) p.closest('.space-y-6').style.setProperty('--dq-top', '0');
        });
        results.forEach(function (r) {
          r.classList.toggle('hidden', r.getAttribute('data-result') !== nodeId);
        });
        panels.forEach(function (p) {
          if (p.getAttribute('data-node') !== nodeId) p.classList.add('hidden');
        });
      }

      function showPanelsOnly() {
        panels.forEach(function (p) { p.classList.remove('hidden'); });
        results.forEach(function (r) { r.classList.add('hidden'); });
      }

      root.querySelectorAll('.dq-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var next = btn.getAttribute('data-next');
          show(next);
        });
      });

      resets.forEach(function (b) {
        b.addEventListener('click', function () {
          showPanelsOnly();
          var first = root.querySelector('.dq-panel');
          if (first) first.querySelector('.dq-btn').focus();
        });
      });

      showPanelsOnly();
    })();
  </script>
</BaseLayout>
