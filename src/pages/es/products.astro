---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = {
  title: 'Fabricante profesional de filtros activos de armónicos, fábrica en China-CHITEK',
  description: 'CHITEK ofrece Filtros Activos de Armónicos (AHF), Generadores Estáticos de Var (SVG), SiC AHF/SVG para corrección de calidad de energía de baja tensión.',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/es' + p : p;
---

<BaseLayout lang="es" title={meta.title} description={meta.description}>
  <!-- Structured data: BreadcrumbList + ItemList + FAQPage (category page, 2026-09-27) -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://en.chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "Productos", "item": "https://en.chitek-inno.com/products" },
      { "@type": "ListItem", "position": 3, "name": "Filtro Activo de Armónicos" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Serie de Filtros Activos de Armónicos (AHF)",
    "numberOfItems": 8,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "MOSFET de Carburo de Silicio Filtro Harmónico Activo SiC", "url": "https://en.chitek-inno.com/products/sic-ultra-ahf" },
      { "@type": "ListItem", "position": 2, "name": "208V/400V/480V Filtro Harmónico Activo Antipolución", "url": "https://en.chitek-inno.com/products/anti-pollution-ahf" },
      { "@type": "ListItem", "position": 3, "name": "690V/800V Filtro Harmónico Activo Antipolución", "url": "https://en.chitek-inno.com/products/anti-pollution-hv-ahf" },
      { "@type": "ListItem", "position": 4, "name": "Filtro Harmónico Activo Ultrafino", "url": "https://en.chitek-inno.com/products/ultra-slim-ahf" },
      { "@type": "ListItem", "position": 5, "name": "Filtro Harmónico Activo Distribuido", "url": "https://en.chitek-inno.com/products/distributed-ahf" },
      { "@type": "ListItem", "position": 6, "name": "IP65 SiC-Fanless Filtro Harmónico Activo 25A", "url": "https://en.chitek-inno.com/products/ip65-sic-fanless-ahf" },
      { "@type": "ListItem", "position": 7, "name": "IP65 Filtro Harmónico Activo", "url": "https://en.chitek-inno.com/products/ip65-ahf" },
      { "@type": "ListItem", "position": 8, "name": "IP65 SiC-Low Noise Fan Filtro Harmónico Activo 50A", "url": "https://en.chitek-inno.com/products/sic-fanless-ahf" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "P1: ¿En qué difieren los modelos de la gama AHF?", "acceptedAnswer": { "@type": "Answer", "text": "La gama varía en dos ejes — tecnología de conmutación (IGBT o SiC MOSFET) y formato mecánico (montaje en pared ultrafino, distribuido, antipolución, IP65 para exteriores y silencioso sin ventilador). Cada modelo aplica el mismo principio de compensación en tiempo real; difieren en eficiencia de conmutación, tamaño, grado de carcasa y ruido acústico." } },
      { "@type": "Question", "name": "P2: ¿Qué órdenes armónicos corrige la serie AHF?", "acceptedAnswer": { "@type": "Answer", "text": "Cada modelo de la gama compensa armónicos del 2.º al 50.º orden, y usted elige cuánto se corrige de cada orden individual. En lugar de ajustarse a una curva fija, la corriente de compensación sigue lo que la red produce en ese momento." } },
      { "@type": "Question", "name": "P3: ¿Se pueden combinar módulos AHF para alcanzar mayor capacidad?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. La gama es modular — los módulos se conectan en paralelo sin límite práctico, por lo que la misma plataforma cubre una sola unidad de pared y hasta instalaciones de 3000 A o más." } },
      { "@type": "Question", "name": "P4: ¿Se puede instalar el AHF en exteriores o entornos agresivos?", "acceptedAnswer": { "@type": "Answer", "text": "Sí. Además de carcasas IP20 e IP30/IP40 para salas de interruptores interiores, la gama incluye modelos IP65 para exteriores y sitios polvorientos, más versiones antipolución y silenciosas sin ventilador donde el polvo, la corrosión o el ruido acústico son la limitación." } }
    ]
  }
  </script>
  <!-- Sticky Tab Bar removed (2026-09-18: the AHF/SVG tab panels do not exist on the EN page, so the bar only added a floating strip on scroll) -->

