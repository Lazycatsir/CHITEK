        font-size: 14px; font-weight: 600; color: #fff; text-decoration: none;
        background: #EA511E; border: none; border-radius: 6px; padding: 8px 22px;
        transition: background .2s;
      }
      .my_more1:hover { background: #C43B13; }

      /* Download button (2026-09-28) — a real control in the same group as the List view icon:
         it shares .cbp-vm-icon (reset + hover + .cbp-vm-selected highlight) and only widens for text.
         margin-left: -.5rem cancels the parent gap so it sits flush against the list icon. */
      .cbp-vm-dl-hint {
        width: auto; min-width: 0; padding: 0 14px; margin-left: -.5rem;
        font-size: 13px; font-weight: 600; white-space: nowrap;
      }

      /* List-view action row: View More + Ficha técnica / Catálogo / Manual del dispositivo */
      .cbp-vm-actions {
        display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
        margin-top: auto;
      }
      .cbp-vm-dl { display: inline-flex; align-items: center; gap: .5rem; }
      /* Wrap instead of forcing the card wider (2026-10-12): without this the
         3-button group's inline-flex min-content width pinned the text column at
         374px and pushed Manual del dispositivo 19px outside the card at 640px. */
      .cbp-vm-view-list .cbp-vm-dl { flex-wrap: wrap; }
      .cbp-dl-btn {
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 13px; font-weight: 600; color: #ea580c; text-decoration: none;
        background: #fff7ed; border: 1px solid #fdba74; border-radius: 6px;
        padding: 7px 14px; white-space: nowrap; transition: all .2s;
      }
      .cbp-dl-btn:hover { background: #EA511E; border-color: #EA511E; color: #fff; }
      /* Manual del dispositivo 暂无文件：灰色占位（不可点 / 不可聚焦） */
      .cbp-dl-btn.is-off {
        color: #9ca3af; background: #f9fafb; border-color: #e5e7eb;
        cursor: default; pointer-events: none;
      }

      /* Mobile list view (2026-10-12).
         Measured at 390px before this block: the fixed 240x150 thumb left the text
         column 374px wide inside a 347px card (267px overflow) and pushed the
         Ficha técnica / Catálogo / Manual del dispositivo buttons 248px past the right edge,
         where overflow:hidden cut them off. Below 640px: shrink the thumb, tighten
         padding, and let all four action buttons flow as one wrapping row
         (.cbp-vm-dl -> display:contents so its buttons join the parent flex row). */
      @media (max-width: 639px) {
        .cbp-vm-view-list .cbp-vm-image {
          width: 104px; height: 104px; margin: .75rem 0 .75rem .75rem;
          align-self: flex-start; border-radius: .5rem;
        }
        .cbp-vm-view-list .cbp-vm-li .text { padding: .75rem; }
        .cbp-vm-view-list .cbp-vm-li .h4 { font-size: 15px; margin-bottom: .375rem; }
        .cbp-vm-view-list .tags_ul { gap: .25rem; margin-bottom: .5rem; }
        .cbp-vm-view-list .cbp-tag { font-size: 10px; padding: 1px 6px; }
        .cbp-vm-view-list .cbp-vm-actions { gap: .375rem; }
        .cbp-vm-view-list .cbp-vm-dl { display: contents; }
        .cbp-vm-view-list .my_more1 { font-size: 13px; padding: 7px 12px; }
        .cbp-vm-view-list .cbp-dl-btn { font-size: 12px; padding: 6px 10px; }

        /* Phone grid: 4:3 -> 3:2 + cover，只裁掉图框上下的纯白（2026-10-21 与英文站统一）。
           实测 8 张卡图（1:1 / 1200px 白底）非白像素：水平 3.3%~96.2%，竖直 24.3%~90.3%
           （顶最上 ip65，底最下 ip65-fanless）。cover 把图片放大到 345x345，3:2 图框的
           可视窗口是 [83,313]，正好包住上述范围（最紧两张各留 0.7px / 1.5px）=> 不切机身。
           #fefefe 是实测卡片底色 (254,254,254)，与白底图无缝。 */
        .cbp-vm-view-grid .cbp-vm-image { aspect-ratio: 3 / 2; background: #fefefe; }
        .cbp-vm-view-grid .cbp-vm-image img { object-fit: cover; object-position: center 72%; }
        /* 移动端图框按「产品实际高度 + 上下各 8px」逐张收紧（2026-10-26）。
           像素扫描 8 张卡图的非白 Y 范围：sic-r2 28~75、anti-pollution-r2 26.9~77.3、
           690v 22.5~80.3、ultra-slim 29~75.3、sic-fanless 26.4~75.7 —— 这 5 张在 3:2 + 72% 下
           底部各留 34~52px 空白，故单独收紧图框并重定位。
           ip65-fanless 24.8~90.3 / ip65 24.3~89.3 / distributed 26.6~90 本来就贴边（剩 1~5px），
           保持 3:2 + 72% 不动。桌面 1:1 方框不裁切，不受影响。 */
.cbp-vm-li:has(.cbp-vm-image img[src*="products-ahf-sic-r2"]) .cbp-vm-image     { aspect-ratio: 1.929; }
.cbp-vm-li:has(.cbp-vm-image img[src*="products-ahf-sic-r2"]) .cbp-vm-image img { object-position: center 53%; }
.cbp-vm-li:has(.cbp-vm-image img[src*="products-ahf-anti-pollution-r2"]) .cbp-vm-image     { aspect-ratio: 1.81; }
.cbp-vm-li:has(.cbp-vm-image img[src*="products-ahf-anti-pollution-r2"]) .cbp-vm-image img { object-position: center 55%; }
.cbp-vm-li:has(.cbp-vm-image img[src*="products-ahf-anti-pollution-690v-800v-rackmount-r3"]) .cbp-vm-image     { aspect-ratio: 1.597; }
.cbp-vm-li:has(.cbp-vm-image img[src*="products-ahf-anti-pollution-690v-800v-rackmount-r3"]) .cbp-vm-image img { object-position: center 54%; }
.cbp-vm-li:has(.cbp-vm-image img[src*="products-ahf-ultra-slim-rackmount-r2"]) .cbp-vm-image     { aspect-ratio: 1.956; }
.cbp-vm-li:has(.cbp-vm-image img[src*="products-ahf-ultra-slim-rackmount-r2"]) .cbp-vm-image img { object-position: center 54%; }
.cbp-vm-li:has(.cbp-vm-image img[src*="products-ahf-sic-fanless"]) .cbp-vm-image     { aspect-ratio: 1.847; }
.cbp-vm-li:has(.cbp-vm-image img[src*="products-ahf-sic-fanless"]) .cbp-vm-image img { object-position: center 52%; }
        .cbp-vm-li .h4 .cbp-spec { display: inline; margin-left: 4ch; white-space: nowrap; }
      }

      /* Filtrar card: checkbox styling */
      .filter_card input[type="checkbox"] {
        width: 16px; height: 16px; accent-color: #EA511E; cursor: pointer; flex-shrink: 0;
      }

    </style>

    <script>
      (function () {
        var container = document.getElementById('cbp-vm');
        if (!container) return;
        var opts = container.parentNode.querySelectorAll('.cbp-vm-options > .cbp-vm-icon');
        opts.forEach(function (el) {
          el.addEventListener('click', function (ev) {
            var view = el.getAttribute('data-view');
            container.classList.remove('cbp-vm-view-grid', 'cbp-vm-view-list');
            container.classList.add(view);
            // Highlight every control bound to the same view, so the icon and the
            // "Download" button light up together (2026-09-28)
            opts.forEach(function (o) {
              o.classList.toggle('cbp-vm-selected', o.getAttribute('data-view') === view);
            });
          });
        });
      })();

      // ----- Filtrar products by technology / voltage / current / IP / dimensions -----
      (function () {
        var boxes = document.querySelectorAll('.filter_card input[type="checkbox"]');
        var cards = document.querySelectorAll('#cbp-vm .cbp-vm-li');
        var summary = document.querySelector('[data-inquiry-summary]');
        if (!boxes.length || !cards.length) return;
        var labels = { t: 'Tecnología', v: 'Voltaje', a: 'Corriente', i: 'Grado de protección IP', s: 'Dimensiones' };
        function apply() {
          var active = { t: [], v: [], a: [], i: [], s: [] };
          boxes.forEach(function (cb) {
            if (cb.checked) {
              var g = cb.getAttribute('data-filter');
              if (active[g]) cb.value.split('|').forEach(function (x) { active[g].push(x); });
            }
          });
          cards.forEach(function (card) {
            var show = true;
            ['t', 'v', 'a', 'i', 's'].forEach(function (g) {
              if (active[g].length) {
                var vals = (card.getAttribute('data-' + g) || '').split(',');
                if (!active[g].some(function (x) { return vals.indexOf(x) > -1; })) show = false;
              }
            });
            card.style.display = show ? '' : 'none';
          });
          if (summary) {
            var lines = [];
            ['t', 'v', 'a', 'i', 's'].forEach(function (g) {
              if (active[g].length) lines.push(labels[g] + ': ' + active[g].join(', '));
            });
            summary.value = lines.join('\n');
          }
          // ---- 选项后的 (N)：命中该选项的型号数（本组按 OR 不算自己，其它组按已勾选过滤）----
          var GROUPS = ['t', 'v', 'a', 'i', 's'];
          function matchOthers(card, skipGroup) {
            for (var i = 0; i < GROUPS.length; i++) {
              var g2 = GROUPS[i];
              if (g2 === skipGroup || !active[g2].length) continue;
              var vals2 = (card.getAttribute('data-' + g2) || '').split(',');
              var hit2 = false;
              for (var j = 0; j < active[g2].length; j++) {
                if (vals2.indexOf(active[g2][j]) > -1) { hit2 = true; break; }
              }
              if (!hit2) return false;
            }
            return true;
          }
          boxes.forEach(function (cb) {
            var g = cb.getAttribute('data-filter');
            var mine = cb.value.split('|');
            var n = 0;
            cards.forEach(function (card) {
              if (!matchOthers(card, g)) return;
              var vals = (card.getAttribute('data-' + g) || '').split(',');
              for (var k = 0; k < mine.length; k++) {
                if (vals.indexOf(mine[k]) > -1) { n++; return; }
              }
            });
            var out = cb.parentNode.querySelector('[data-count]');
            if (out) out.textContent = '(' + n + ')';
          });
        }
        boxes.forEach(function (cb) { cb.addEventListener('change', apply); });
        apply();
      })();

      // Solicitar cotización (filter): carry the live selection summary into the contact form's Project Requirements
      (function () {
        var btn = document.getElementById('inquire-now-btn');
        if (!btn) return;
        btn.addEventListener('click', function (e) {
          var summary = document.querySelector('[data-inquiry-summary]');
          var val = summary ? (summary.value || '').trim() : '';
          if (!val) return; // nothing selected -> navigate to contact normally
          e.preventDefault();
          var base = btn.getAttribute('href') || '/contact';
          var sep = base.indexOf('?') > -1 ? '&' : '?';
          window.location.href = base + sep + 'inquiry=' + encodeURIComponent(val);
        });
      })();
    </script>
  </section>



  <script>
    // 移动端筛选抽屉（2026-10-21，与英文汇总页同一套）。只做开合与滚动锁定，不碰筛选逻辑。
    (function () {
      var panel = document.getElementById('pc-filter');
      var mask = document.getElementById('pc-filter-mask');
      var openBtn = document.getElementById('pc-filter-open');
      if (!panel || !openBtn) return;
      var closeBtn = panel.querySelector('[data-pc-filter-close]');
      var lastFocus = null;

      function isOpen() { return panel.classList.contains('is-open'); }
      function open() {
        lastFocus = document.activeElement;
        panel.classList.add('is-open');
        if (mask) mask.classList.add('is-open');
        openBtn.setAttribute('aria-expanded', 'true');
        document.documentElement.classList.add('pc-filter-locked');
        var first = panel.querySelector('input[type="checkbox"]');
        if (first) setTimeout(function () { try { first.focus({ preventScroll: true }); } catch (e) {} }, 300);
      }
      function close() {
        panel.classList.remove('is-open');
        if (mask) mask.classList.remove('is-open');
        openBtn.setAttribute('aria-expanded', 'false');
        document.documentElement.classList.remove('pc-filter-locked');
        if (lastFocus && lastFocus.focus) { try { lastFocus.focus({ preventScroll: true }); } catch (e) {} }
      }
      openBtn.addEventListener('click', function () { isOpen() ? close() : open(); });
      if (closeBtn) closeBtn.addEventListener('click', close);
      if (mask) mask.addEventListener('click', close);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isOpen()) close();
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth >= 1024 && isOpen()) close();
      });
    })();
  </script>

</BaseLayout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  /* HMI 左右两栏向中间靠拢加载（可重复触发） */
  .hmi-left, .hmi-right {
    opacity: 0;
    transition: opacity 0.7s ease, transform 0.7s ease;
    will-change: opacity, transform;
  }
  .hmi-left { transform: translateX(-64px); }
  .hmi-right { transform: translateX(64px); }
  .hmi-left.visible, .hmi-right.visible { opacity: 1; transform: translateX(0); }
  .reveal-x-left { opacity: 0; transform: translateX(-64px); transition: opacity 0.7s ease, transform 0.7s ease; will-change: opacity, transform; }
  .reveal-x-left.visible { opacity: 1; transform: translateX(0); }
  @media (prefers-reduced-motion: reduce) {
    .hmi-left, .hmi-right, .reveal-x-left, .feat-card { opacity: 1; transform: none; transition: none; }
  }
  .wizard-step:not(.active) {
    display: none;
  }
  .feat-card {
    opacity: 0;
    transform: translateX(-48px);
    transition: opacity 0.55s ease, transform 0.55s ease;
    will-change: opacity, transform;
  }
  .feat-card.visible {
    opacity: 1;
    transform: translateX(0);
  }
  /* 产品系列四张卡片弹出加载（可反复触发：首次进入 / 滚动重入 / 切换 Tab 均重放） */
  .ps-card { opacity: 0; will-change: transform, opacity; }
  .ps-card.popped {
    animation: psPopIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes psPopIn {
    0%   { opacity: 0; transform: scale(0.82) translateY(28px); }
    55%  { opacity: 1; transform: scale(1.03) translateY(-4px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ps-card { opacity: 1; }
    .ps-card.popped { animation: none; transform: none; }
  }
  .scrollbar-hide::-webkit-scrollbar { display: none !important; }
  .scrollbar-hide { -ms-overflow-style: none !important; scrollbar-width: none !important; }

  @keyframes decorIn {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<script>


    // ===== Value Proposition Canvas Waveform =====
    const vpCanvas = document.getElementById('vp-canvas');
    if (vpCanvas) {
      const vpCtx = vpCanvas.getContext('2d');
      let vpTime = 0;
      let vpRaf;

      function resizeVpCanvas() {
        const vp = document.getElementById('value-prop');
        vpCanvas.width = vp.offsetWidth;
        vpCanvas.height = vp.offsetHeight;
      }
      resizeVpCanvas();
      window.addEventListener('resize', resizeVpCanvas);

      function drawVpWaveform() {
        vpTime += 0.006;
        const w = vpCanvas.width, h = vpCanvas.height;
        vpCtx.clearRect(0, 0, w, h);

        // Grid
        vpCtx.strokeStyle = 'rgba(255, 77, 0, 0.03)';
        vpCtx.lineWidth = 1;
        const gs = 80;
        for (let x = 0; x < w; x += gs) { vpCtx.beginPath(); vpCtx.moveTo(x, 0); vpCtx.lineTo(x, h); vpCtx.stroke(); }
        for (let y = 0; y < h; y += gs) { vpCtx.beginPath(); vpCtx.moveTo(0, y); vpCtx.lineTo(w, y); vpCtx.stroke(); }

        // Waves
        const waves = [
          { freq: 1.2, amp: 30, speed: 0.8, alpha: 0.15, yOff: 0 },
          { freq: 2.0, amp: 18, speed: 1.1, alpha: 0.1, yOff: 60 },
          { freq: 0.6, amp: 40, speed: 0.5, alpha: 0.12, yOff: -50 },
        ];
        const cy = h * 0.5;
        waves.forEach(wave => {
          vpCtx.beginPath();
          vpCtx.strokeStyle = 'rgba(255, 77, 0, ' + wave.alpha + ')';
          vpCtx.lineWidth = 1.5;
          for (let x = 0; x < w; x += 2) {
            const y = cy + wave.yOff + Math.sin(x * wave.freq * 0.003 + vpTime * wave.speed) * wave.amp + Math.sin(x * 0.008 + vpTime * 0.5) * 8;
            if (x === 0) vpCtx.moveTo(x, y); else vpCtx.lineTo(x, y);
          }
          vpCtx.stroke();
        });

        vpRaf = requestAnimationFrame(drawVpWaveform);
      }
      vpRaf = requestAnimationFrame(drawVpWaveform);
    }

    // ===== Tab Switching =====
    document.querySelectorAll('.sticky-hero-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tab;

        // Update button styles
        document.querySelectorAll('.sticky-hero-tab').forEach(b => {
          if (b.dataset.tab === tab) {
            b.classList.remove('text-[#374151]', 'hover:text-brand-orange', 'hover:bg-orange-50');
            b.classList.add('text-white', 'bg-brand-orange', 'shadow-sm');
          } else {
            b.classList.remove('text-white', 'bg-brand-orange', 'shadow-sm');
            b.classList.add('text-[#374151]', 'hover:text-brand-orange', 'hover:bg-orange-50');
          }
        });

        // Toggle all tab-panels
        document.querySelectorAll('.tab-panel').forEach(panel => {
          if (panel.dataset.tab === tab) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });

        // Update matrix section title based on active tab
        const matrixTitles = ['AHF Product Selection Matrix', 'SVG Product Selection Matrix'];
        var matrixTitleEl = document.getElementById('matrix-title');
        if (matrixTitleEl) matrixTitleEl.textContent = matrixTitles[parseInt(tab)] || matrixTitles[0];
      });
    });

    // ===== Scroll Reveal =====
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          // Also reveal nested feat-cards
          entry.target.querySelectorAll('.feat-card').forEach((card, i) => {
            setTimeout(() => card.classList.add('visible'), i * 150);
          });
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

    // ===== HMI 左右两栏向中间靠拢（可重复触发） =====
    const hmiCols = document.querySelectorAll('.hmi-left, .hmi-right');
    if (hmiCols.length) {
      const hmiObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          } else {
            entry.target.classList.remove('visible');
          }
        });
      }, { threshold: 0.25 });
      hmiCols.forEach(el => hmiObserver.observe(el));
    }

    // ===== Four Product Series 标题：从左侧滑入（可重复触发） =====
    const xLeftEls = document.querySelectorAll('.reveal-x-left');
    if (xLeftEls.length) {
      const xLeftObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
          else entry.target.classList.remove('visible');
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -20% 0px' });
      xLeftEls.forEach(el => xLeftObserver.observe(el));
    }

    // ===== Core Tecnología Advantages 卡片：从左错峰滑入（可重复触发） =====
    document.querySelectorAll('.feat-grid').forEach(grid => {
      const cards = grid.querySelectorAll('.feat-card');
      const featObs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            cards.forEach((card, i) => setTimeout(() => card.classList.add('visible'), i * 150));
          } else {
            cards.forEach(card => card.classList.remove('visible'));
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -12% 0px' });
      featObs.observe(grid);
    });

    // ===== Roadmap Tooltip =====
    const tooltip = document.getElementById('roadmap-tooltip');
    document.querySelectorAll('.tooltip-trigger').forEach(el => {
      el.addEventListener('mouseenter', (e) => {
        const rect = e.currentTarget.getBoundingClientRect();
        tooltip.textContent = e.currentTarget.dataset.tip;
        tooltip.style.left = (rect.left + rect.width / 2) + 'px';
        tooltip.style.top = (rect.top - 10) + 'px';
        tooltip.style.transform = 'translate(-50%, -100%)';
        tooltip.classList.remove('hidden');
      });
      el.addEventListener('mouseleave', () => { tooltip.classList.add('hidden'); });
    });

    // ===== Product Matrix =====
    const seriesList = [
      { key: 'U', name: 'Ultra-Slim',      label: 'U-Series' },
      { key: 'D', name: 'Distributed',     label: 'D-Series' },
      { key: 'A', name: 'Anti-Pollution',  label: 'A-Series' },
      { key: 'C', name: 'SiC',             label: 'C-Series' },
      { key: 'L', name: 'Standard',        label: 'L-Series' },
    ];

    const voltColorMap = { '400V': '#3b82f6', '208V': '#eab308', '480V': '#f97316', '690V': '#ef4444' };
    const capacities = ['15A','30A','50A','75A','85A','100A','150A','200A'];

    const matrixData = {
      '400V': {
        U: ['15A'],
        D: ['30A','50A'],
        A: ['50A','75A','100A','150A','200A'],
        C: ['50A','75A','100A','150A'],
        L: ['50A','75A','100A','150A','200A'],
      },
      '208V': {
        U: [],
        D: [],
        A: ['50A','75A','100A','150A','200A'],
        C: ['50A','75A','100A','150A'],
        L: ['50A','75A','100A','150A','200A'],
      },
      '480V': {
        U: [],
        D: [],
        A: ['50A','75A','100A','150A','200A'],
        C: ['50A','75A','100A','150A'],
        L: ['50A','75A','100A','150A','200A'],
      },
      '690V': {
        U: [],
        D: [],
        A: ['85A','100A'],
        C: [],
        L: ['85A','100A'],
      },
    };

    const svgBySeries = {
      U: '10Kvar', D: '30~35Kvar', A: '35~150Kvar', C: '35~100Kvar', L: '35~150Kvar',
    };

    const specData = {
      'A-50A-400V':  { model:'AHF-A-050A-400',  current:'50A',  voltage:'380~415V', svg:'35Kvar',  weight:'25kg', harmonic:'2nd~50th', dimension:'440x176x380mm', monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'20kHz', ratedFreq:'50/60Hz' },
      'A-75A-400V':  { model:'AHF-A-075A-400',  current:'75A',  voltage:'380~415V', svg:'50Kvar',  weight:'32kg', harmonic:'2nd~50th', dimension:'440x221x380mm', monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'20kHz', ratedFreq:'50/60Hz' },
      'A-100A-400V': { model:'AHF-A-100A-400',  current:'100A', voltage:'380~415V', svg:'75Kvar',  weight:'40kg', harmonic:'2nd~50th', dimension:'440x266x380mm', monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'20kHz', ratedFreq:'50/60Hz' },
      'A-150A-400V': { model:'AHF-A-150A-400',  current:'150A', voltage:'380~415V', svg:'100Kvar', weight:'58kg', harmonic:'2nd~50th', dimension:'600x310x450mm', monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'20kHz', ratedFreq:'50/60Hz' },
      'A-200A-400V': { model:'AHF-A-200A-400',  current:'200A', voltage:'380~415V', svg:'150Kvar', weight:'75kg', harmonic:'2nd~50th', dimension:'600x400x450mm', monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'20kHz', ratedFreq:'50/60Hz' },
      'C-50A-400V':  { model:'AHF-C-050A-400',  current:'50A',  voltage:'380~415V', svg:'35Kvar',  weight:'16kg', harmonic:'2nd~50th', dimension:'440x88x380mm',  monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'30kHz', ratedFreq:'50/60Hz' },
      'C-75A-400V':  { model:'AHF-C-075A-400',  current:'75A',  voltage:'380~415V', svg:'50Kvar',  weight:'24kg', harmonic:'2nd~50th', dimension:'440x132x380mm', monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'30kHz', ratedFreq:'50/60Hz' },
      'C-100A-400V': { model:'AHF-C-100A-400',  current:'100A', voltage:'380~415V', svg:'75Kvar',  weight:'30kg', harmonic:'2nd~50th', dimension:'440x176x380mm', monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'30kHz', ratedFreq:'50/60Hz' },
      'C-150A-400V': { model:'AHF-C-150A-400',  current:'150A', voltage:'380~415V', svg:'100Kvar', weight:'48kg', harmonic:'2nd~50th', dimension:'600x221x450mm', monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'30kHz', ratedFreq:'50/60Hz' },
      'L-85A-690V':  { model:'AHF-L-085A-690',  current:'85A',  voltage:'690~800V', svg:'120Kvar', weight:'Contact us', harmonic:'2nd~50th', dimension:'Contact us', monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'20kHz', ratedFreq:'50/60Hz' },
      'L-100A-690V': { model:'AHF-L-100A-690',  current:'100A', voltage:'690~800V', svg:'120Kvar', weight:'Contact us', harmonic:'2nd~50th', dimension:'Contact us', monitoring:'7" HMI Touchscreen', wiring:'3P3W / 3P4W', freq:'20kHz', ratedFreq:'50/60Hz' },
    };

    function getSpec(series, cap, volt) {
      const key = series + '-' + cap + '-' + volt;
      if (specData[key]) return specData[key];
      const vLabel = volt === '400V' ? '380~415V' : volt === '208V' ? '200~240V' : volt === '480V' ? '460~500V' : '690~800V';
      return {
        model: 'AHF-' + series + '-' + cap.replace('A','').padStart(3,'0') + 'A-' + volt.replace('V',''),
        current: cap,
        voltage: vLabel,
        svg: svgBySeries[series] || 'Contact us',
        weight: 'Contact us',
        harmonic: '2nd~50th',
        dimension: 'Contact us',
        monitoring: '7" HMI Touchscreen',
        wiring: '3P3W / 3P4W',
        freq: (series === 'C' ? '30kHz' : '20kHz'),
        ratedFreq: '50/60Hz'
      };
    }

    let selectedVoltaje = '400V';
    let selectedCell = null;

    function renderMatrix() {
      const tbody = document.getElementById('matrix-tbody');
      // 英文列表页暂未包含「AHF Selection Matrix」区块（zh/es/ar/pt 均有），
      // 缺 tbody 时直接跳过，避免每次加载抛 "Cannot read properties of null (reading 'closest')"。
      if (!tbody) return;
      const table = tbody.closest('table');
      const data = matrixData[selectedVoltaje];
      const vColor = voltColorMap[selectedVoltaje];
      tbody.innerHTML = '';
      const lastCap = capacities[capacities.length - 1];
      capacities.forEach(cap => {
        const tr = document.createElement('tr');
        tr.className = 'border-t border-[#d1d5db] hover:bg-[#fafbfc]';
        if (cap === lastCap) tr.style.borderBottom = '1px solid #d1d5db';
        let html = '<td class="p-2 text-text-dark font-medium text-[clamp(12px,0.9vw,15px)] font-barlow-condensed">' + cap + '</td>';
        seriesList.forEach(s => {
          const avail = data[s.key] || [];
          const isAvail = avail.includes(cap);
          const isSel = selectedCell && selectedCell.series === s.key && selectedCell.capacity === cap;
          html += '<td class="p-2 text-center"><button class="matrix-cell w-8 h-8 rounded-full flex items-center justify-center mx-auto transition-all duration-200 ' + (isAvail ? (isSel ? 'bg-brand-orange text-white scale-110 shadow-[0_0_12px_rgba(234,81,30,0.3)]' : 'border-2 hover:border-brand-orange hover:scale-105') : 'opacity-15 pointer-events-none') + '" data-series="' + s.key + '" data-cap="' + cap + '" ' + (!isAvail ? 'disabled' : '') + ' style="' + (isAvail && !isSel ? 'border-color:' + vColor + '60' : '') + '"><span class="w-3 h-3 rounded-full ' + (isSel ? 'bg-white' : '') + '" style="' + (!isSel && isAvail ? 'background-color:' + vColor : '') + '"></span></button></td>';
        });
        tr.innerHTML = html;
        tbody.appendChild(tr);
      });
      table.style.borderBottom = '1px solid #d1d5db';
      document.querySelectorAll('.matrix-cell').forEach(btn => {
        btn.addEventListener('click', () => {
          const series = btn.dataset.series;
          const cap = btn.dataset.cap;
          if (selectedCell && selectedCell.series === series && selectedCell.capacity === cap) {
            selectedCell = null;
            document.getElementById('spec-panel').classList.add('hidden');
          } else {
            selectedCell = { series, capacity: cap };
            showSpecPanel();
          }
          renderMatrix();
        });
      });
    }

    function showSpecPanel() {
      const panel = document.getElementById('spec-panel');
      const content = document.getElementById('spec-panel-content');
      const spec = getSpec(selectedCell.series, selectedCell.capacity, selectedVoltaje);
      const sInfo = seriesList.find(s => s.key === selectedCell.series);
      const seriesDesc = sInfo ? sInfo.name : selectedCell.series;
      const modelParts = spec.model.split('-');
      modelParts[1] = seriesDesc;
      const displayTitle = modelParts.join('-');
      const inquiryText = displayTitle + '-' + spec.voltage.replace('V', '');
      content.innerHTML = '<div class="flex items-center justify-between mb-[clamp(12px,2vw,32px)]"><h4 class="text-[clamp(14px,1vw,17px)] font-semibold text-brand-orange font-barlow-condensed">' + displayTitle + '</h4><button onclick="closeSpecPanel()" class="w-8 h-8 rounded-full bg-[#f3f4f6] flex items-center justify-center hover:bg-[#e5e7eb] transition-colors"><svg class="w-4 h-4 text-text-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button></div><div class="space-y-1.5 mb-[clamp(12px,2vw,32px)]">' + [ ['Rated Corriente', spec.current], ['SVG Capacity', spec.svg], ['Voltaje', spec.voltage], ['Weight', spec.weight], ['Harmonic Filtraring range', spec.harmonic], ['Dimension', spec.dimension], ['Monitoring', spec.monitoring], ['Wiring method', spec.wiring], ['Switching frequency', spec.freq], ['Rated frequency', spec.ratedFreq] ].map(function(kv) { return '<div class="flex justify-between py-2 border-b border-[#f1f5f9]"><span class="text-[clamp(10px,0.8vw,12px)] text-text-muted">' + kv[0] + '</span><span class="text-[clamp(12px,0.9vw,15px)] text-text-dark font-barlow-condensed">' + kv[1] + '</span></div>'; }).join('') + '</div><button onclick="goToInquiry(\'' + inquiryText + '\')" class="w-full py-3 rounded-lg bg-brand-orange text-white text-[clamp(12px,0.9vw,15px)] font-medium hover:bg-brand-orange-dark transition-colors">Request Quote</button>';
      panel.classList.remove('hidden');
    }
    window.goToInquiry = function(inquiryText) {
      var path = window.location.pathname.replace(/\/products\/?$/, '/contact');
      window.location.href = path + '?inquiry=' + encodeURIComponent(inquiryText);
    };
    window.closeSpecPanel = function() {
      selectedCell = null;
      document.getElementById('spec-panel').classList.add('hidden');
      renderMatrix();
    };

    // Voltaje buttons
    document.querySelectorAll('.volt-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedVoltaje = btn.dataset.v;
        selectedCell = null;
        document.getElementById('spec-panel').classList.add('hidden');
        document.querySelectorAll('.volt-btn').forEach(b => {
          if (b.dataset.v === selectedVoltaje) {
            b.classList.add('border-brand-orange', 'bg-brand-orange', 'text-white');
            b.classList.remove('border-[#d1d5db]', 'text-text-dim');
          } else {
            b.classList.remove('border-brand-orange', 'bg-brand-orange', 'text-white');
            b.classList.add('border-[#d1d5db]', 'text-text-dim');
          }
        });
        renderMatrix();
        renderMobileWizard();
      });
    });

    renderMatrix();

    // ===== Mobile Wizard =====
    let wizStep = 'voltage';
    let wizSeries = null;

    function renderMobileWizard() {
      const vOpts = document.getElementById('wiz-voltage-options');
      if (!vOpts) return; // EN 列表页没有移动向导区块，避免 null 报错
      vOpts.innerHTML = Object.keys(matrixData).map(function(v) {
        const isSel = selectedVoltaje === v;
        const colors = { '400V': 'bg-blue-500', '208V': 'bg-yellow-500', '480V': 'bg-orange-500', '690V': 'bg-red-500' };
        return '<button onclick="selectWizVoltaje(\'' + v + '\')" class="w-full flex items-center gap-[clamp(8px,1.5vw,20px)] p-4 rounded-lg border transition-all text-left ' + (isSel ? 'border-brand-orange bg-brand-orange/5' : 'border-border-light bg-white hover:border-[#d1d5db]') + '"><span class="w-4 h-4 rounded-full ' + colors[v] + '"></span><div><p class="text-text-dark font-medium">' + v + '</p></div></button>';
      }).join('');
    }
    window.selectWizVoltaje = function(v) {
      selectedVoltaje = v;
      wizStep = 'series';
      updateWizard();
    };
    window.wizardBack = function(step) {
      wizStep = step;
      if (step === 'voltage') wizSeries = null;
      updateWizard();
    };
    function updateWizard() {
      const stepEl = document.getElementById('wiz-' + wizStep);
      if (!stepEl) return; // EN 列表页没有移动向导区块，避免 null 报错
      document.querySelectorAll('.wizard-step').forEach(s => s.classList.remove('active'));
      stepEl.classList.add('active');

      if (wizStep === 'series') {
        const sOpts = document.getElementById('wiz-series-options');
        const data = matrixData[selectedVoltaje];
        sOpts.innerHTML = seriesList.map(function(s) {
          const has = (data[s.key] || []).length > 0;
          return '<button onclick="' + (has ? 'selectWizSeries(\'' + s.key + '\')' : '') + '" class="w-full flex items-center gap-[clamp(8px,1.5vw,20px)] p-4 rounded-lg border transition-all text-left ' + (!has ? 'opacity-30 pointer-events-none border-border-light' : 'border-border-light bg-white hover:border-brand-orange') + '"><span class="w-8 h-8 rounded flex items-center justify-center text-[clamp(12px,0.9vw,15px)] font-bold text-brand-orange" style="background-color:' + voltColorMap[selectedVoltaje] + '15">' + s.key + '</span><div><p class="text-text-dark font-medium">' + s.name + '</p><p class="text-[clamp(10px,0.8vw,12px)] text-text-muted">' + s.label + '</p></div></button>';
        }).join('');
      }
      if (wizStep === 'capacity') {
        const cOpts = document.getElementById('wiz-capacity-options');
        const avail = matrixData[selectedVoltaje][wizSeries] || [];
        cOpts.innerHTML = capacities.map(function(cap) {
          const isAvail = avail.includes(cap);
          const isSel = selectedCell && selectedCell.series === wizSeries && selectedCell.capacity === cap;
          return '<button onclick="' + (isAvail ? 'selectWizCap(\'' + cap + '\')' : '') + '" class="p-4 rounded-lg border text-center transition-all ' + (!isAvail ? 'opacity-30 border-border-light bg-white' : (isSel ? 'border-brand-orange bg-brand-orange text-white' : 'border-border-light bg-white text-text-dark hover:border-brand-orange/50')) + '"><span class="text-[clamp(13px,1.1vw,17px)] font-medium font-barlow-condensed">' + cap + '</span></button>';
        }).join('');
      }
    }
    window.selectWizSeries = function(s) {
      wizSeries = s;
      wizStep = 'capacity';
      updateWizard();
    };
    window.selectWizCap = function(cap) {
      if (selectedCell && selectedCell.series === wizSeries && selectedCell.capacity === cap) {
        selectedCell = null;
        document.getElementById('mobile-spec').classList.add('hidden');
      } else {
        selectedCell = { series: wizSeries, capacity: cap };
        const spec = getSpec(wizSeries, cap, selectedVoltaje);
        const mSeriesDesc = seriesList.find(s => s.key === wizSeries)?.name || wizSeries;
        const mModelParts = spec.model.split('-');
        mModelParts[1] = mSeriesDesc;
        const mDisplayTitle = mModelParts.join('-');
        const mInquiryText = mDisplayTitle + '-' + spec.voltage.replace('V', '');
        document.getElementById('mobile-spec').innerHTML = '<div class="flex items-center justify-between mb-4"><h4 class="text-[clamp(14px,1vw,17px)] font-semibold text-brand-orange font-barlow-condensed">' + mDisplayTitle + '</h4><button onclick="closeMobileSpec()" class="w-7 h-7 rounded-full bg-[#f3f4f6] flex items-center justify-center"><svg class="w-3 h-3 text-text-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button></div><div class="grid grid-cols-2 gap-2 text-[clamp(10px,0.8vw,12px)] mb-4"><div class="bg-[#f9fafb] p-2 rounded border border-border-light"><span class="text-text-muted">Rated Corriente</span><span class="text-text-dark ml-1 font-barlow-condensed">' + spec.current + '</span></div><div class="bg-[#f9fafb] p-2 rounded border border-border-light"><span class="text-text-muted">SVG Capacity</span><span class="text-text-dark ml-1 font-barlow-condensed">' + spec.svg + '</span></div><div class="bg-[#f9fafb] p-2 rounded border border-border-light"><span class="text-text-muted">Voltaje</span><span class="text-text-dark ml-1 font-barlow-condensed">' + spec.voltage + '</span></div><div class="bg-[#f9fafb] p-2 rounded border border-border-light"><span class="text-text-muted">Weight</span><span class="text-text-dark ml-1 font-barlow-condensed">' + spec.weight + '</span></div><div class="bg-[#f9fafb] p-2 rounded border border-border-light"><span class="text-text-muted">Dimension</span><span class="text-text-dark ml-1 font-barlow-condensed">' + spec.dimension + '</span></div></div><button onclick="goToInquiry(\'' + mInquiryText + '\')" class="w-full py-2.5 rounded-lg bg-brand-orange text-white text-[clamp(12px,0.9vw,15px)] font-medium hover:bg-brand-orange-dark transition-colors">Request Quote</button>';
        document.getElementById('mobile-spec').classList.remove('hidden');
      }
      updateWizard();
    };
    window.closeMobileSpec = function() {
      selectedCell = null;
      document.getElementById('mobile-spec').classList.add('hidden');
      updateWizard();
    };
    renderMobileWizard();
    updateWizard();

    // ===== Resources =====
    const resources = [
      { title: 'AHF Product Specification v4.2', type: 'spec', size: '2.4 MB', date: '2025-03' },
      { title: 'AHF Installation Manual', type: 'spec', size: '5.1 MB', date: '2025-02' },
      { title: 'CE Certification', type: 'spec', size: '1.2 MB', date: '2025-01' },
      { title: 'UL Certification', type: 'spec', size: '1.8 MB', date: '2024-12' },
      { title: 'AHF Series CAD Drawings', type: 'cad', size: '12.6 MB', date: '2025-03' },
      { title: 'BIM Model Library', type: 'cad', size: '28.3 MB', date: '2025-01' },
      { title: 'Installation Tutorial Video', type: 'video', size: '156 MB', date: '2025-02' },
      { title: 'Centro de datos Case Video', type: 'video', size: '243 MB', date: '2024-11' },
    ];
    const typeIcons = {
      spec: '<svg class="w-5 h-5 text-brand-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>',
      cad: '<svg class="w-5 h-5 text-brand-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>',
      video: '<svg class="w-5 h-5 text-brand-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/><line x1="17" y1="7" x2="22" y2="7"/></svg>',
    };
    function renderResources(filter) {
      const list = document.getElementById('resource-list');
      if (!list) return; // EN 列表页没有资源下载区块，避免 null 报错
      const filtered = filter === 'all' ? resources : resources.filter(r => r.type === filter);
      list.innerHTML = filtered.map(function(r) {
        const isVideo = r.type === 'video';
        return '<div class="bg-white border border-border-light rounded-lg hover:border-brand-orange/40 transition-all duration-300 group shadow-sm relative p-5"><div class="flex items-center gap-3 mb-4"><div class="w-10 h-10 rounded-lg bg-brand-orange/10 flex items-center justify-center shrink-0">' + typeIcons[r.type] + '</div><h3 class="text-[clamp(12px,0.9vw,15px)] font-bold text-text-dark leading-snug">' + r.title + '</h3></div><div class="flex items-center gap-1.5 mb-1.5"><svg class="w-3 h-3 text-accent-blue shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg><span class="text-[clamp(10px,0.8vw,12px)] text-text-muted">' + r.size + ' · ' + r.date + '</span></div><div class="border-t border-border-light mt-4 pt-4"><button onclick="alert(\'Download: ' + r.title + '\')" class="w-full flex items-center justify-center gap-1.5 px-2 py-2 border border-brand-orange/30 bg-brand-orange/5 text-brand-orange text-[clamp(10px,0.8vw,12px)] font-medium rounded-md hover:bg-brand-orange/10 transition-all">' + (isVideo ? '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg><span>Play</span>' : '<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg><span>Download</span>') + '</button></div><div class="absolute top-[-1px] left-[-1px] w-4 h-4 border-t-2 border-l-2 border-brand-orange/30"></div><div class="absolute bottom-[-1px] right-[-1px] w-4 h-4 border-b-2 border-r-2 border-brand-orange/30"></div></div>';
      }).join('');
    }
    renderResources('all');
    document.querySelectorAll('.res-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.res-filter').forEach(b => {
          b.classList.remove('bg-brand-orange', 'text-white', 'border-brand-orange');
          b.classList.add('bg-white', 'border-[#d1d5db]', 'text-text-dim');
        });
        btn.classList.add('bg-brand-orange', 'text-white', 'border-brand-orange');
        btn.classList.remove('bg-white', 'border-[#d1d5db]', 'text-text-dim');
        renderResources(btn.dataset.filter);
      });
    });

    // ===== Case Carousel =====
    let caseIndex = 0;
    const caseTrack = document.getElementById('case-track');
    const caseSlides = document.querySelectorAll('#case-carousel .case-slide');
    const totalSlides = caseSlides.length;
    const dots = document.querySelectorAll('#case-dots .carousel-dot');

    function goToCase(idx) {
      if (!caseTrack || !caseSlides.length) return; // EN 列表页没有案例轮播，避免 null 报错
      caseIndex = idx;
      if (caseIndex < 0) caseIndex = totalSlides - 1;
      if (caseIndex >= totalSlides) caseIndex = 0;
      const slideWidth = caseSlides[0].offsetWidth;
      caseTrack.style.transform = 'translateX(-' + (caseIndex * slideWidth) + 'px)';
      dots.forEach((d, i) => {
        d.classList.toggle('active', i === caseIndex);
        if (i === caseIndex) {
          d.style.background = '#ff4d00';
          d.style.width = '24px';
          d.style.borderRadius = '4px';
        } else {
          d.style.background = '#d1d5db';
          d.style.width = '8px';
          d.style.borderRadius = '50%';
        }
      });
    }

    const casePrevBtn = document.getElementById('case-prev');
    const caseNextBtn = document.getElementById('case-next');
    if (casePrevBtn) casePrevBtn.addEventListener('click', () => goToCase(caseIndex - 1));
    if (caseNextBtn) caseNextBtn.addEventListener('click', () => goToCase(caseIndex + 1));
    dots.forEach(d => {
      d.addEventListener('click', () => goToCase(parseInt(d.dataset.slide)));
    });

    // Auto-play
    setInterval(() => goToCase(caseIndex + 1), 6000);

    // Touch swipe
    let touchStartX = 0;
    const carousel = document.getElementById('case-carousel');
    if (carousel) {
      carousel.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
      carousel.addEventListener('touchend', e => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) goToCase(diff > 0 ? caseIndex + 1 : caseIndex - 1);
      }, { passive: true });
    }

    window.addEventListener('resize', () => goToCase(caseIndex));

    // ===== SVG Case Carousel =====
    let svgCaseIndex = 0;
    const svgCaseTrack = document.getElementById('case-track-svg');
    const svgCaseSlides = document.querySelectorAll('#case-carousel-svg .case-slide');
    const svgTotalSlides = svgCaseSlides.length;
    const svgDots = document.querySelectorAll('#case-dots-svg .carousel-dot');

    function goToSvgCase(idx) {
      if (!svgCaseTrack || !svgCaseSlides.length) return; // EN 列表页没有 SVG 案例轮播，避免 null 报错
      svgCaseIndex = idx;
      if (svgCaseIndex < 0) svgCaseIndex = svgTotalSlides - 1;
      if (svgCaseIndex >= svgTotalSlides) svgCaseIndex = 0;
      const slideWidth = svgCaseSlides[0].offsetWidth;
      svgCaseTrack.style.transform = 'translateX(-' + (svgCaseIndex * slideWidth) + 'px)';
      svgDots.forEach((d, i) => {
        d.classList.toggle('active', i === svgCaseIndex);
        if (i === svgCaseIndex) {
          d.style.background = '#ff4d00';
          d.style.width = '24px';
          d.style.borderRadius = '4px';
        } else {
          d.style.background = '#d1d5db';
          d.style.width = '8px';
          d.style.borderRadius = '50%';
        }
      });
    }

    const casePrevSvgBtn = document.getElementById('case-prev-svg');
    const caseNextSvgBtn = document.getElementById('case-next-svg');
    if (casePrevSvgBtn) casePrevSvgBtn.addEventListener('click', () => goToSvgCase(svgCaseIndex - 1));
    if (caseNextSvgBtn) caseNextSvgBtn.addEventListener('click', () => goToSvgCase(svgCaseIndex + 1));
    svgDots.forEach(d => {
      d.addEventListener('click', () => goToSvgCase(parseInt(d.dataset.slide)));
    });

    setInterval(() => goToSvgCase(svgCaseIndex + 1), 6000);

    let svgTouchStartX = 0;
    const svgCarousel = document.getElementById('case-carousel-svg');
    if (svgCarousel) {
      svgCarousel.addEventListener('touchstart', e => { svgTouchStartX = e.touches[0].clientX; }, { passive: true });
      svgCarousel.addEventListener('touchend', e => {
        const diff = svgTouchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) goToSvgCase(diff > 0 ? svgCaseIndex + 1 : svgCaseIndex - 1);
      }, { passive: true });
    }

    window.addEventListener('resize', () => goToSvgCase(svgCaseIndex));

    // ===== FAQ Tab-Switch Navigation =====
    function initFaq(containerId, prefix) {
      const container = document.getElementById(containerId);
      if (!container) return;
      const navItems = container.querySelectorAll('.faq-nav-item');
      const faqFlex = container.closest('.faq-flex');
      if (!faqFlex) return;
      const panels = faqFlex.querySelectorAll('.faq-panel');

      navItems.forEach(item => {
        item.addEventListener('click', () => {
          const targetId = item.dataset.target;

          navItems.forEach(nav => {
            nav.classList.remove('active', 'bg-[#fff5f0]', 'border-l-brand-orange', 'text-brand-orange', 'font-semibold');
          });
          item.classList.add('active', 'bg-[#fff5f0]', 'border-l-brand-orange', 'text-brand-orange', 'font-semibold');

          panels.forEach(panel => {
            panel.classList.remove('active');
            panel.classList.add('hidden');
          });
          const panel = faqFlex.querySelector('#' + prefix + targetId);
          if (panel) {
            panel.classList.add('active');
            panel.classList.remove('hidden');
          }

          if (window.innerWidth <= 900) {
            const contentArea = faqFlex.querySelector('.flex-1.p-[clamp(16px,3vw,48px)]');
            if (contentArea) contentArea.scrollIntoView({ behavior: 'smooth' });
          }

          const currentQ = faqFlex.querySelector('.faq-current-question');
          if (currentQ) {
            currentQ.textContent = item.textContent;
          }
        });
      });
    }

    // FAQ Layout
    // Tab 0: AHF FAQ
    function setupFaqTab0() {
      const flex = document.querySelector('.tab-panel.faq-flex[data-tab="0"]');
      if (!flex) return;
      const navItems = flex.querySelectorAll('.faq-nav-item');
      const panels = flex.querySelectorAll('.faq-panel');

      // Init first item active
      navItems.forEach((item, i) => {
        if (i === 0) {
          item.classList.add('active', 'bg-[#fff5f0]', 'border-l-brand-orange', 'text-brand-orange', 'font-semibold');
        }
      });
      panels.forEach((panel, i) => {
        if (i === 0) {
          panel.classList.add('active');
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    // Tab 1: SVG FAQ
    function setupFaqTab1() {
      const flex = document.querySelector('.tab-panel.faq-flex[data-tab="1"]');
      if (!flex) return;
      const navItems = flex.querySelectorAll('.faq-nav-item');
      const panels = flex.querySelectorAll('.faq-panel');

      navItems.forEach((item, i) => {
        if (i === 0) {
          item.classList.add('active', 'bg-[#fff5f0]', 'border-l-brand-orange', 'text-brand-orange', 'font-semibold');
        }
      });
      panels.forEach((panel, i) => {
        if (i === 0) {
          panel.classList.add('active');
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    initFaq('faqNavList', 'faqPanel');
    initFaq('faqNavListSvg', 'faqPanelSvg');
    // Ensure first items are properly set up after DOM
    // ===== Hash-Based Navigation =====
    const productHashMap = { 'ahf': '0', 'svg': '1', 'sic': '0', 'high-protection': '0' };

    function navigateToProduct() {
      const hash = window.location.hash.replace('#', '');
      if (hash && productHashMap[hash]) {
        const tab = productHashMap[hash];
        // Click the matching tab button
        const btn = document.querySelector(`.sticky-hero-tab[data-tab="${tab}"]`);
        if (btn) btn.click();
        // Scroll to product-series section for specific product anchors
        if (hash === 'sic' || hash === 'high-protection') {
          setTimeout(() => {
            document.getElementById('product-series')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 150);
        }
      }
    }

    window.addEventListener('hashchange', navigateToProduct);
    // Check initial hash
    navigateToProduct();

    setTimeout(setupFaqTab0, 100);
    setTimeout(setupFaqTab1, 100);

    // ===== Four Product Series Carousel (Mobile) =====
    (function() {
      var tracks = document.querySelectorAll('[data-product-track]');
      tracks.forEach(function(track) {
        var panel = track.closest('.tab-panel');
        var dotsContainer = panel && panel.querySelector('[data-product-dots]');
        if (!dotsContainer) return;
        var dotItems = dotsContainer.querySelectorAll('.carousel-dot');
        if (!dotItems.length) return;
        var cards = track.children;
        if (!cards.length) return;
        var current = 0;

        function goTo(idx) {
          if (idx < 0) idx = cards.length - 1;
          if (idx >= cards.length) idx = 0;
          current = idx;
          var offset = cards[current].getBoundingClientRect().left - track.getBoundingClientRect().left;
          track.style.transform = 'translateX(-' + offset + 'px)';
          dotItems.forEach(function(d, i) {
            if (i === current) {
              d.style.background = '#ff4d00';
              d.style.width = '24px';
              d.style.borderRadius = '4px';
            } else {
              d.style.background = '#d1d5db';
              d.style.width = '8px';
              d.style.borderRadius = '50%';
            }
          });
        }

        dotItems.forEach(function(d) {
          d.addEventListener('click', function() { goTo(parseInt(d.getAttribute('data-slide'))); });
        });

        setInterval(function() {
          if (window.innerWidth < 640) goTo(current + 1);
        }, 5000);

        var container = track.parentElement;
        var startX = 0;
        container.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive: true });
        container.addEventListener('touchend', function(e) {
          var diff = startX - e.changedTouches[0].clientX;
          if (Math.abs(diff) > 50) goTo(diff > 0 ? current + 1 : current - 1);
        }, { passive: true });

        window.addEventListener('resize', function() {
          track.style.transform = '';
          goTo(current);
        });

        goTo(0);
      });
    })();

    // ===== 产品系列四张卡片弹出加载（可反复触发） =====
    var seriesSection = document.getElementById('product-series');
    if (seriesSection) {
      // 给两套面板（AHF / SVG）的卡片统一打标
      seriesSection.querySelectorAll('[data-product-track] > div').forEach(function (c) {
        c.classList.add('ps-card');
      });

      function activeSeriesPanel() {
        var t = document.querySelector('.sticky-hero-tab.bg-brand-orange');
        var tab = t ? t.dataset.tab : '0';
        return seriesSection.querySelector('.tab-panel[data-tab="' + tab + '"]');
      }

      function popSeriesCards(panel) {
        if (!panel) return;
        panel.querySelectorAll('[data-product-track] > div').forEach(function (card, i) {
          card.classList.remove('popped');
          void card.offsetWidth; // 强制回流以重启 CSS 动画
          card.style.animationDelay = (i * 90) + 'ms';
          card.classList.add('popped');
        });
      }

      // 进入视口即弹出；离开后再次进入可重复触发（沿用 HMI 的 add/remove 思路）
      var seriesObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            popSeriesCards(activeSeriesPanel());
          } else {
            var p = activeSeriesPanel();
            if (p) p.querySelectorAll('[data-product-track] > div').forEach(function (c) {
              c.classList.remove('popped');
            });
          }
        });
      }, { threshold: 0.2 });
      seriesObserver.observe(seriesSection);

      // 切换 AHF / SVG Tab 时重弹当前面板
      document.querySelectorAll('.sticky-hero-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var tab = btn.dataset.tab;
          if (tab === '0' || tab === '1') {
            requestAnimationFrame(function () { popSeriesCards(activeSeriesPanel()); });
          }
        });
      });
    }
</script>
