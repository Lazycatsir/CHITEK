        height: 38px; padding: 0 12px; flex-shrink: 0;
        border: 1px solid #e5e7eb; border-radius: 8px;
        background: #fff; color: #374151;
        font-size: 13px; font-weight: 600; font-family: inherit;
        cursor: pointer; appearance: none; -webkit-appearance: none;
      }
      .pc-filter-btn:hover { border-color: #fb923c; color: #ea580c; }
      .pc-filter-btn svg { width: 18px; height: 18px; }
      @media (max-width: 1023px) {
        .pc-filter-panel {
          position: fixed; top: 0; bottom: 0; left: 0;
          width: 86vw; max-width: 360px;
          z-index: 1200;
          overflow-y: auto; -webkit-overflow-scrolling: touch;
          background: #f3f4f6;
          padding: 12px 12px 16px;
          transform: translateX(-100%);
          visibility: hidden;
          transition: transform .28s ease, visibility .28s ease;
        }
        [dir="rtl"] .pc-filter-panel { left: auto; right: 0; transform: translateX(100%); }
        .pc-filter-panel.is-open { transform: translateX(0); visibility: visible; }
        .pc-filter-panel .filter_card { padding: 14px; }
