      .cbp-vm-grid-ul { list-style: none; margin: 0; padding: 0; }
      /* Row gap tightened 40px -> 24px (2026-09-28); column gap kept at 2.5rem */
      .cbp-vm-view-grid .cbp-vm-grid-ul { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); row-gap: 1.5rem; column-gap: 2.5rem; }
      @media (min-width: 640px)  { .cbp-vm-view-grid .cbp-vm-grid-ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (min-width: 768px)  { .cbp-vm-view-grid .cbp-vm-grid-ul { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
      @media (min-width: 1024px) { .cbp-vm-view-grid .cbp-vm-grid-ul { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

      /* Grid view: title + brief description only — hide tags and View More (shown in list view) */
