---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = {
  title: 'CHITEK — Generador Estático de Var de baja tensión (SVG) | Corrección del factor de potencia',
  description: 'El Generador Estático de Var (SVG) de CHITEK ofrece compensación continua de potencia reactiva y corrección del factor de potencia para redes de baja tensión — series de pared, rack, distribuida e IP65.',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/es' + p : p;
