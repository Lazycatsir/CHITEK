---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh" alternates={false} title="页面未找到 – CHITEK INNOPOWER" description="您访问的页面不存在。返回 CHITEK 主页或查看产品详情。">
  <section class="min-h-screen flex flex-col items-center justify-center text-center px-6 mt-[72px]">
    <h1 class="font-barlow-condensed text-[clamp(72px,12vw,160px)] font-bold text-brand-orange leading-[1] mb-4">404</h1>
    <p class="text-[clamp(16px,1.5vw,24px)] text-text-dark font-medium mb-8">页面未找到</p>
    <p class="text-text-muted max-w-md mb-10">您访问的页面可能已被移动或删除。让我们帮您回到正轨。</p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="/" class="bg-brand-orange text-white text-[13px] font-semibold tracking-[0.06em] uppercase px-7 py-3.5 rounded-sm no-underline hover:bg-brand-orange-dark transition-colors duration-200">返回主页</a>
      <a href="/products" class="bg-white text-brand-orange border border-brand-orange text-[13px] font-semibold tracking-[0.06em] uppercase px-7 py-3.5 rounded-sm no-underline hover:bg-brand-orange hover:text-white transition-colors duration-200">产品详情</a>
    </div>
  </section>
</BaseLayout>
