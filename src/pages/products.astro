            <div class="space-y-1 mb-3">
              <a href="https://wa.me/8618818994346" target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[13px] text-gray-700 hover:bg-orange-50 hover:text-brand-orange transition-colors">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                <span>WhatsApp</span>
              </a>
              <a href="mailto:leo.li@chitek-inno.com" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[13px] text-gray-700 hover:bg-orange-50 hover:text-brand-orange transition-colors">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
                <span>leo.li@chitek-inno.com</span>
              </a>
            </div>
          </div>
          <!-- Company card (2026-09-24) -->
          <div class="company_card bg-white border border-gray-200 rounded-xl overflow-hidden mb-6">
            <img src="/assets/images/about-bg.webp" alt="Shenzhen CHITEK New Energy Technology Co., Ltd." class="w-full aspect-[3/2] object-cover" loading="lazy" width="1155" height="770" />
            <div class="p-5">
              <p class="text-[13px] leading-relaxed text-gray-600">Shenzhen CHITEK New Energy Technology Co., Ltd., founded in 2019 and headquartered in Shenzhen, is a high-tech enterprise specializing in the research, development, manufacturing, and service of power electronic products. Committed to building an energy-efficient and green future.</p>
