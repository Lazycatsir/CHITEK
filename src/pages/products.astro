---
import BaseLayout from '../layouts/BaseLayout.astro';

const meta = {
  title: 'CHITEK — 低压AHF、SVG制造商 | 电能质量解决方案',
  description: 'CHITEK提供有源电力滤波器(AHF)、静止无功发生器(SVG)、SiC AHF/SVG，用于低压电能质量矫正。',
};

// 中文站无语言前缀（/products 就是中文站），因此 lp() 直通；
// 英文站之所以拼 '/en' 前缀，只是为了让本地 dev 能命中 /en 路由。
const lp = (p: string) => p;
---

<BaseLayout lang="zh" title={meta.title} description={meta.description}>
  <!-- Structured data: BreadcrumbList + ItemList + FAQPage (category page, 2026-09-27) -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://chitek-inno.com/products" },
      { "@type": "ListItem", "position": 3, "name": "Active Harmonic Filter" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Active Harmonic Filter (AHF) Series",
    "numberOfItems": 8,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Silicon Carbide MOSFET Active Harmonic Filter SiC AHF", "url": "https://en.chitek-inno.com/products/sic-ultra-ahf" },
      { "@type": "ListItem", "position": 2, "name": "208V/400V/480V Anti-Pollution Active Harmonic Filter AHF", "url": "https://en.chitek-inno.com/products/anti-pollution-ahf" },
      { "@type": "ListItem", "position": 3, "name": "690V/800V Anti-Pollution Active Harmonic Filter AHF", "url": "https://en.chitek-inno.com/products/anti-pollution-ahf" },
      { "@type": "ListItem", "position": 4, "name": "Ultra-slim Active Harmonic Filter AHF", "url": "https://en.chitek-inno.com/products/ultra-slim-ahf" },
      { "@type": "ListItem", "position": 5, "name": "Distributed Active Harmonic Filter AHF", "url": "https://en.chitek-inno.com/products/distributed-ahf" },
      { "@type": "ListItem", "position": 6, "name": "IP65 SiC-Fanless & Low Noise Active Harmonic Filter", "url": "https://en.chitek-inno.com/products/sic-fanless-ahf" },
      { "@type": "ListItem", "position": 7, "name": "IP65 Active Harmonic Filter", "url": "https://en.chitek-inno.com/products/ip65-ahf" },
      { "@type": "ListItem", "position": 8, "name": "SiC-Fanless & Low Noise Active Harmonic Filter", "url": "https://en.chitek-inno.com/products/sic-fanless-ahf" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": "zh-CN",
    "mainEntity": [
      { "@type": "Question", "name": "Q1：AHF 系列各型号之间有什么区别？", "acceptedAnswer": { "@type": "Answer", "text": "该系列沿两个维度区分——开关器件（IGBT 或 SiC MOSFET）与机械形态（超薄壁挂式、分布式、防污染型、IP65 户外型、无风扇低噪型）。所有型号都采用相同的实时补偿原理，差别在于开关效率、占用空间、防护等级与噪声水平。" } },
      { "@type": "Question", "name": "Q2：AHF 系列可以补偿哪些谐波次数？", "acceptedAnswer": { "@type": "Answer", "text": "该系列每个型号都可补偿 2 次至 50 次谐波，每个谐波次数的补偿量均可按需设定。补偿电流不是按固定曲线运行，而是实时跟随电网当下的谐波状态。" } },
      { "@type": "Question", "name": "Q3：AHF 模块可以并联以获得更高容量吗？", "acceptedAnswer": { "@type": "Answer", "text": "可以。该系列采用模块化设计——模块并联没有实际容量上限，同一平台既能覆盖单台壁挂式设备，也能覆盖 3000 A 及以上的大型装置。" } },
      { "@type": "Question", "name": "Q4：AHF 可以安装在户外或恶劣环境中吗？", "acceptedAnswer": { "@type": "Answer", "text": "可以。除适用于室内配电室的 IP20 与 IP30/IP40 柜体外，该系列还提供面向户外及多尘场所的 IP65 型号；当粉尘、腐蚀或噪声成为主要制约因素时，可选防污染型与无风扇低噪型。" } }
    ]
  }
  </script>
  <!-- Sticky Tab Bar removed (2026-09-18: the AHF/SVG tab panels do not exist on the EN page, so the bar only added a floating strip on scroll) -->

  <!-- Section: Active Harmonic Filter (AHF) Series -->
  <!-- ytelect-style product listing: left filter sidebar + right grid/list-switchable product grid -->
  <section id="product-series" class="pt-6 pb-16 bg-gray-50 mt-[72px]">
    <div class="pl-[clamp(12px,2vw,40px)] pr-[clamp(24px,8vw,160px)]">
      <!-- Breadcrumb -->
      <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href={lp('/')} class="hover:text-brand-orange">Home</a></li>
          <li class="text-gray-300">/</li>
          <li><a href={lp('/products')} class="hover:text-brand-orange">Products</a></li>
          <li class="text-gray-300">/</li>
          <li class="text-gray-700 font-medium" aria-current="page">Active Harmonic Filter</li>
        </ol>
      </nav>

      <!-- Two-column layout: left filter sidebar + right product area -->
      <div class="index_main flex flex-col lg:flex-row gap-8">

        <!-- LEFT COLUMN -->
        <aside class="n_left lg:w-[340px] lg:shrink-0">
          <div class="filter_card bg-white border border-gray-200 rounded-xl p-5 mb-6">
            <p class="left_h_bar h-[38px] flex items-center px-3 rounded-lg bg-gray-50 border border-gray-200 text-[15px] font-bold text-gray-900 mb-3 font-barlow-condensed">Filter</p>
            <div class="mb-4">
              <p class="text-[13px] font-semibold text-gray-800 mb-2">Technology</p>
              <div class="grid grid-cols-2 gap-x-2 gap-y-2">
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="t" value="IGBT" /> IGBT <span class="text-gray-400" data-count>(5)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="t" value="SiC" /> SiC <span class="text-gray-400" data-count>(4)</span></label>
              </div>
            </div>
            <div class="mb-4">
              <p class="text-[13px] font-semibold text-gray-800 mb-2">Voltage</p>
              <div class="grid grid-cols-2 gap-x-2 gap-y-2">
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="v" value="208V" /> 208V <span class="text-gray-400" data-count>(7)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="v" value="400V" /> 400V <span class="text-gray-400" data-count>(7)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="v" value="480V" /> 480V <span class="text-gray-400" data-count>(7)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="v" value="690V" /> 690V <span class="text-gray-400" data-count>(1)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="v" value="800V" /> 800V <span class="text-gray-400" data-count>(1)</span></label>
              </div>
            </div>
            <div class="mb-4">
              <p class="text-[13px] font-semibold text-gray-800 mb-2">Current</p>
              <div class="grid grid-cols-2 gap-x-2 gap-y-2">
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="a" value="8~20A" /> 8~20A <span class="text-gray-400" data-count>(1)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="a" value="30~50A" /> 30~50A <span class="text-gray-400" data-count>(3)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="a" value="50~200A" /> 50~200A <span class="text-gray-400" data-count>(4)</span></label>
              </div>
            </div>
            <div class="mb-4">
              <p class="text-[13px] font-semibold text-gray-800 mb-2">IP Rating</p>
              <div class="grid grid-cols-2 gap-x-2 gap-y-2">
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="i" value="IP20" /> IP20(standard) <span class="text-gray-400" data-count>(6)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="i" value="IP30|IP40" /> other/negotiable <span class="text-gray-400" data-count>(6)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="i" value="IP65" /> IP65 <span class="text-gray-400" data-count>(2)</span></label>
              </div>
            </div>
            <div>
              <p class="text-[13px] font-semibold text-gray-800 mb-2">Dimensions</p>
              <div class="grid grid-cols-2 gap-x-2 gap-y-2">
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="s" value="340*410*45mm" /> 340*410*45mm <span class="text-gray-400" data-count>(1)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="s" value="380*400*88mm" /> 380*400*88mm <span class="text-gray-400" data-count>(1)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="s" value="500*550*130mm" /> 500*550*130mm <span class="text-gray-400" data-count>(2)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="s" value="500*550*175mm" /> 500*550*175mm <span class="text-gray-400" data-count>(1)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="s" value="480*600*175mm" /> 480*600*175mm <span class="text-gray-400" data-count>(1)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="s" value="515*500*185mm" /> 515*500*185mm <span class="text-gray-400" data-count>(2)</span></label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="s" value="600*500*220mm" /> 600*500*220mm <span class="text-gray-400" data-count>(1)</span></label>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-200">
