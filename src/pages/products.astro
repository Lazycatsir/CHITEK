        model: 'AHF-' + series + '-' + cap.replace('A','').padStart(3,'0') + 'A-' + volt.replace('V',''),
        current: cap,
        voltage: vLabel,
        svg: svgBySeries[series] || 'Contact us',
        weight: 'Contact us',
        harmonic: '2nd~50th',
        dimension: 'Contact us',
        monitoring: '7" HMI Touchscreen',
        wiring: '3P3W / 3P4W',
        freq: (series === 'C' ? '30kHz' : '20kHz'),
        ratedFreq: '50/60Hz'
      };
    }

    let selectedVoltage = '400V';
    let selectedCell = null;

    function renderMatrix() {
      const tbody = document.getElementById('matrix-tbody');
      // 英文列表页暂未包含「AHF Selection Matrix」区块（zh/es/ar/pt 均有），
      // 缺 tbody 时直接跳过，避免每次加载抛 "Cannot read properties of null (reading 'closest')"。
      if (!tbody) return;
      const table = tbody.closest('table');
      const data = matrixData[selectedVoltage];
      const vColor = voltColorMap[selectedVoltage];
      tbody.innerHTML = '';
      const lastCap = capacities[capacities.length - 1];
      capacities.forEach(cap => {
        const tr = document.createElement('tr');
        tr.className = 'border-t border-[#d1d5db] hover:bg-[#fafbfc]';
        if (cap === lastCap) tr.style.borderBottom = '1px solid #d1d5db';
        let html = '<td class="p-2 text-text-dark font-medium text-[clamp(12px,0.9vw,15px)] font-barlow-condensed">' + cap + '</td>';
        seriesList.forEach(s => {
          const avail = data[s.key] || [];
          const isAvail = avail.includes(cap);
          const isSel = selectedCell && selectedCell.series === s.key && selectedCell.capacity === cap;
          html += '<td class="p-2 text-center"><button class="matrix-cell w-8 h-8 rounded-full flex items-center justify-center mx-auto transition-all duration-200 ' + (isAvail ? (isSel ? 'bg-brand-orange text-white scale-110 shadow-[0_0_12px_rgba(255,107,26,0.3)]' : 'border-2 hover:border-brand-orange hover:scale-105') : 'opacity-15 pointer-events-none') + '" data-series="' + s.key + '" data-cap="' + cap + '" ' + (!isAvail ? 'disabled' : '') + ' style="' + (isAvail && !isSel ? 'border-color:' + vColor + '60' : '') + '"><span class="w-3 h-3 rounded-full ' + (isSel ? 'bg-white' : '') + '" style="' + (!isSel && isAvail ? 'background-color:' + vColor : '') + '"></span></button></td>';
        });
        tr.innerHTML = html;
        tbody.appendChild(tr);
      });
      table.style.borderBottom = '1px solid #d1d5db';
      document.querySelectorAll('.matrix-cell').forEach(btn => {
        btn.addEventListener('click', () => {
          const series = btn.dataset.series;
          const cap = btn.dataset.cap;
          if (selectedCell && selectedCell.series === series && selectedCell.capacity === cap) {
            selectedCell = null;
            document.getElementById('spec-panel').classList.add('hidden');
          } else {
            selectedCell = { series, capacity: cap };
            showSpecPanel();
          }
          renderMatrix();
        });
      });
    }

    function showSpecPanel() {
      const panel = document.getElementById('spec-panel');
      const content = document.getElementById('spec-panel-content');
      const spec = getSpec(selectedCell.series, selectedCell.capacity, selectedVoltage);
      const sInfo = seriesList.find(s => s.key === selectedCell.series);
      const seriesDesc = sInfo ? sInfo.name : selectedCell.series;
      const modelParts = spec.model.split('-');
      modelParts[1] = seriesDesc;
      const displayTitle = modelParts.join('-');
      const inquiryText = displayTitle + '-' + spec.voltage.replace('V', '');
      content.innerHTML = '<div class="flex items-center justify-between mb-[clamp(12px,2vw,32px)]"><h4 class="text-[clamp(14px,1vw,17px)] font-semibold text-brand-orange font-barlow-condensed">' + displayTitle + '</h4><button onclick="closeSpecPanel()" class="w-8 h-8 rounded-full bg-[#f3f4f6] flex items-center justify-center hover:bg-[#e5e7eb] transition-colors"><svg class="w-4 h-4 text-text-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button></div><div class="space-y-1.5 mb-[clamp(12px,2vw,32px)]">' + [ ['Rated Current', spec.current], ['SVG Capacity', spec.svg], ['Voltage', spec.voltage], ['Weight', spec.weight], ['Harmonic Filtering range', spec.harmonic], ['Dimension', spec.dimension], ['Monitoring', spec.monitoring], ['Wiring method', spec.wiring], ['Switching frequency', spec.freq], ['Rated frequency', spec.ratedFreq] ].map(function(kv) { return '<div class="flex justify-between py-2 border-b border-[#f1f5f9]"><span class="text-[clamp(10px,0.8vw,12px)] text-text-muted">' + kv[0] + '</span><span class="text-[clamp(12px,0.9vw,15px)] text-text-dark font-barlow-condensed">' + kv[1] + '</span></div>'; }).join('') + '</div><button onclick="goToInquiry(\'' + inquiryText + '\')" class="w-full py-3 rounded-lg bg-brand-orange text-white text-[clamp(12px,0.9vw,15px)] font-medium hover:bg-brand-orange-dark transition-colors">Request Quote</button>';
      panel.classList.remove('hidden');
    }
    window.goToInquiry = function(inquiryText) {
      var path = window.location.pathname.replace(/\/products\/?$/, '/contact');
      window.location.href = path + '?inquiry=' + encodeURIComponent(inquiryText);
    };
    window.closeSpecPanel = function() {
      selectedCell = null;
      document.getElementById('spec-panel').classList.add('hidden');
      renderMatrix();
    };

    // Voltage buttons
    document.querySelectorAll('.volt-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedVoltage = btn.dataset.v;
        selectedCell = null;
        document.getElementById('spec-panel').classList.add('hidden');
        document.querySelectorAll('.volt-btn').forEach(b => {
          if (b.dataset.v === selectedVoltage) {
            b.classList.add('border-brand-orange', 'bg-brand-orange', 'text-white');
            b.classList.remove('border-[#d1d5db]', 'text-text-dim');
          } else {
            b.classList.remove('border-brand-orange', 'bg-brand-orange', 'text-white');
