---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getHreflang } from '../../../i18n/index';
import Sidebar from '../../../components/Sidebar.astro';

const article = {
  title: "SiC vs IGBT: The Future of Power Quality Equipment",
  category: "Technology",
  date: "2024-10-22",
  dateDisplay: "Oct 22, 2024",
  description: "Silicon Carbide technology is revolutionizing power quality equipment with higher efficiency, faster switching, and reduced thermal management requirements.",
  author: "CHITEK R&D Team",
  readTime: "7 min read"
,  keywords: ["SiC MOSFET","IGBT","silicon carbide","active harmonic filter","power quality","wide bandgap","harmonic mitigation","efficiency","CHITEK"]
};

const otherArticles = [
  { title: "Conformal Coating in Low-Voltage AHF Modules", category: "Technology", href: "/news/conformal-coating-ahf-reliability", color: "orange" },
  { title: "Active vs Passive Harmonic Filters", category: "Technology", href: "/news/active-vs-passive-harmonic-filters", color: "purple" },
  { title: "SiC Technology Redefines AHF", category: "Technology", href: "/news/sic-technology-redefines-ahf", color: "orange" },
];

const relatedProducts = [
  { name: "Active Harmonic Filter AHF", href: "/products", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
  { name: "Static Var Generator SVG", href: "/products-svg", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
  { name: "SiC-AHF/SVG High Efficiency", href: "/products-asvg", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
];

const relatedCases = [
  { name: "Harmonic Retrofit on a 550 A Plant Feeder — Electronics Manufacturer, Guangdong", industry: "Electronics Manufacturing", href: "/solutions/industrial" },
  { name: "Centralised Harmonic Mitigation Across Five 2,000 kVA Transformers — Optical Component Manufacturer, Dongguan", industry: "Precision Optics Manufacturing", href: "/solutions/industrial" },
  { name: "Resonance-Free Harmonic Control at a Large Livestock Farm, Anhui", industry: "Agri & Food Production", href: "/solutions/commercial" },
];

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/en' + p : p;
// 分享按钮用本页 canonical URL（与 <link rel="canonical"> 同源；10-08 P1-3 统一 host）
const SHARE_URL = getHreflang('en', Astro.url.pathname);
---
<BaseLayout title={`${article.title} | CHITEK INNOPOWER`} description="Silicon Carbide technology is revolutionizing power quality equipment with higher efficiency, faster switching, and reduced thermal management requirements." lang="en" ogType="article" ogTitle={article.title} ogDescription={article.description} ogImage="https://en.chitek-inno.com/assets/images/news/news-img-5.webp" alternateLangs={['zh', 'en', 'es', 'ar']}>
  <!-- Schema.org Article Structured Data -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "SiC vs IGBT: The Future of Power Quality Equipment",
    "description": "Silicon Carbide technology is revolutionizing power quality equipment with higher efficiency, faster switching, and reduced thermal management requirements.",
    "image": "https://en.chitek-inno.com/assets/images/news/news-img-5.webp",
    "author": {"@type": "Organization","name": "CHITEK R&D Team"},
    "publisher": {"@type": "Organization","name": "CHITEK INNOPOWER","logo": {"@type": "ImageObject","url": "https://en.chitek-inno.com/assets/images/logo.webp"}},
    "datePublished": "2024-10-22",
    "dateModified": "2024-10-22",
    "keywords": "SiC MOSFET IGBT silicon carbide active harmonic filter power quality wide bandgap harmonic mitigation efficiency CHITEK"
  }
  </script>
  <Sidebar lang="en" />

  <section class="pt-[72px] bg-bg-dark text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-orange/20 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 py-16 md:py-20">
      <a href={lp('/news')} class="inline-flex items-center text-brand-orange text-sm font-semibold mb-6 hover:underline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 mr-2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to News
      </a>
      <div class="flex items-center gap-3 mb-4">
        <span class="text-xs font-semibold text-brand-orange bg-brand-orange/20 px-3 py-1 rounded-full">{article.category}</span>
        <span class="text-xs text-gray-400">{article.dateDisplay}</span>
        <span class="text-xs text-gray-400">·</span>
        <span class="text-xs text-gray-400">{article.readTime}</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold font-[family-name:var(--font-barlow-condensed)] tracking-tight max-w-4xl">
        {article.title}
      </h1>
    </div>
  </section>

  <!-- Article Content + Sidebar -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-12 flex flex-col lg:flex-row gap-10">

      <!-- Main Content -->
      <article class="flex-1 max-w-4xl">
        <!-- Featured Image -->
        <div class="w-full h-64 md:h-96 rounded-xl overflow-hidden mb-10 bg-gray-50">
          <img src="/assets/images/news/news-img-5.webp" alt="SiC vs IGBT: The Future of Power Quality Equipment" class="w-full h-full object-cover" loading="eager" />
        </div>

        <!-- Article Body -->
        <div class="prose prose-lg max-w-none">
          <p class="text-text-mid text-lg leading-relaxed mb-6">
            Silicon Carbide (SiC) technology is transforming power quality equipment, offering significant advantages over traditional IGBT-based solutions. This article explores the technical differences and practical implications.
          </p>

          <h2 class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">
            Technology Comparison
          </h2>

          <div class="overflow-x-auto mb-8">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-gray-50">
                  <th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">Parameter</th>
                  <th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">SiC MOSFET</th>
                  <th class="text-left p-4 font-semibold text-text-dark border-b border-border-light">Traditional IGBT</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="p-4 border-b border-border-light text-text-mid">Switching Frequency</td>
                  <td class="p-4 border-b border-border-light text-text-mid font-semibold">Up to 50kHz</td>
                  <td class="p-4 border-b border-border-light text-text-mid">Typically 10-20kHz</td>
                </tr>
                <tr>
                  <td class="p-4 border-b border-border-light text-text-mid">Efficiency</td>
                  <td class="p-4 border-b border-border-light text-text-mid font-semibold">98.5%+</td>
                  <td class="p-4 border-b border-border-light text-text-mid">96-97%</td>
                </tr>
                <tr>
                  <td class="p-4 border-b border-border-light text-text-mid">Thermal Performance</td>
                  <td class="p-4 border-b border-border-light text-text-mid font-semibold">Excellent</td>
                  <td class="p-4 border-b border-border-light text-text-mid">Good</td>
                </tr>
                <tr>
                  <td class="p-4 border-b border-border-light text-text-mid">Power Density</td>
                  <td class="p-4 border-b border-border-light text-text-mid font-semibold">3-4x Higher</td>
                  <td class="p-4 border-b border-border-light text-text-mid">Baseline</td>
                </tr>
                <tr>
                  <td class="p-4 border-b border-border-light text-text-mid">Switching Losses</td>
                  <td class="p-4 border-b border-border-light text-text-mid font-semibold">Very Low</td>
                  <td class="p-4 border-b border-border-light text-text-mid">Moderate</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">
            Benefits of SiC in Power Quality Applications
          </h2>
          <p class="text-text-mid leading-relaxed mb-6">
            The advantages of SiC technology translate directly to better performance in active harmonic filters and static var generators:
          </p>
          <ul class="list-disc list-inside text-text-mid leading-relaxed mb-6 space-y-2">
            <li>Faster response time to load changes</li>
            <li>Better harmonic compensation at higher frequencies</li>
            <li>Reduced cooling requirements and smaller footprint</li>
            <li>Lower lifetime ownership costs</li>
            <li>Higher reliability in harsh environments</li>
          </ul>

          <h2 class="text-2xl font-bold font-[family-name:var(--font-barlow-condensed)] text-text-dark mt-10 mb-4">
            CHITEK's SiC Product Line
          </h2>
          <p class="text-text-mid leading-relaxed mb-6">
            CHITEK has been at the forefront of SiC adoption in power quality equipment, with our SiC-AHF and SiC-SVG series offering industry-leading performance metrics. Our R&D team continues to push the boundaries of what's possible with this technology.
          </p>

          <!-- SEO Keywords -->
          <div class="mt-10 pt-6 border-t border-border-light">
            <div class="flex flex-wrap gap-2">
              {article.keywords.map((keyword) => (
                <span class="text-xs text-text-muted bg-gray-100 px-3 py-1 rounded-full">#{keyword}</span>
              ))}
            </div>
          </div>

          <!-- Author & Navigation -->
          <div class="flex flex-col md:flex-row items-center justify-between mt-16 pt-8 border-t border-border-light">
            <div class="flex items-center gap-4 mb-4 md:mb-0">
              <div class="w-12 h-12 bg-brand-orange/10 rounded-full flex items-center justify-center">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6 text-brand-orange">
                  <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-text-dark">CHITEK R&D Team</div>
                <div class="text-sm text-text-muted">Published {article.dateDisplay}</div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-sm text-text-muted">Share:</span>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(SHARE_URL)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
              <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(SHARE_URL)}&text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Twitter" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.05c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/></svg>
              </a>
              <a href="https://www.facebook.com/profile.php?id=61579260405315" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded border border-border-light flex items-center justify-center hover:border-brand-orange hover:text-brand-orange transition-colors">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="lg:w-[320px] shrink-0">
        <div class="lg:sticky lg:top-[88px] space-y-4">

          <!-- Other Articles -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              More Articles
            </h3>
            <div class="space-y-2">
              {otherArticles.map((item) => (
                <a href={lp(item.href)} class="block p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="text-sm font-semibold text-text-dark leading-snug">{item.title}</div>
                </a>
              ))}
            </div>
          </div>

          <!-- Related Products -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
              Related Products
            </h3>
            <div class="space-y-2">
              {relatedProducts.map((product) => (
                <a href={lp(product.href)} class="flex items-center gap-2.5 p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="w-8 h-8 bg-brand-orange/10 rounded-lg flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 text-brand-orange">
                      <path d={product.icon}/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-text-dark truncate">{product.name}</div>
                  </div>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-text-muted shrink-0">
                    <path d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              ))}
            </div>
          </div>

          <!-- Related Cases -->
          <div class="bg-gray-50 rounded-xl p-4">
            <h3 class="font-bold text-text-dark mb-3 flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 text-brand-orange">
                <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              Customer Cases
            </h3>
            <div class="space-y-2">
              {relatedCases.map((c) => (
                <a href={lp(c.href)} class="block p-2.5 bg-white rounded-lg border border-border-light hover:border-brand-orange hover:shadow-sm transition-all no-underline">
                  <div class="text-sm font-semibold text-text-dark leading-snug">{c.name}</div>
                  <div class="text-xs text-text-muted mt-0.5">{c.industry}</div>
                </a>
              ))}
            </div>
          </div>

        </div>
      </aside>

    </div>
  </section>
</BaseLayout>
