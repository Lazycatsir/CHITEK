---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FlyerSpread from '../../../components/flyer/FlyerSpread.astro';
import spread from '../../../components/flyer/datacenter-solution.html?raw';

const article = {
  title: "Datacenter Cooling Harmonic Control — SiC AHF Solution Brochure",
  category: "Product Update",
  date: "2026-11-18",
  dateDisplay: "Nov 18, 2026",
  author: "CHITEK INNOPOWER",
  description: "CHITEK two-page datacenter brochure: harmonic control for CRAC, CDU and chiller loads with SiC AHF, ultra slim 8-20A and distributed 30-50A models, THDi below 5% and resonance damping.",
  cardImage: "/assets/images/news/flyer-datacenter-solution.webp",
  keywords: "datacenter harmonic control, SiC AHF, CRAC harmonic filter, CDU power quality, chiller harmonic mitigation, ultra slim AHF, distributed AHF, THDi 5%, CHITEK brochure"
};

const ogImage = 'https://en.chitek-inno.com/assets/images/news/flyer-datacenter-solution-960w.webp';
---
<BaseLayout
  title={`${article.title} | CHITEK INNOPOWER`}
  description={article.description}
  lang="en"
  ogType="article"
  ogTitle={article.title}
  ogDescription={article.description}
  ogImage={ogImage}
  alternates={false}
>
  <script type="application/ld+json" slot="head">
{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Datacenter Cooling Harmonic Control — SiC AHF Solution Brochure",
    "description": "CHITEK two-page datacenter brochure: harmonic control for CRAC, CDU and chiller loads with SiC AHF, ultra slim 8-20A and distributed 30-50A models, THDi below 5% and resonance damping.",
    "image": "https://en.chitek-inno.com/assets/images/news/flyer-datacenter-solution-960w.webp",
    "author": {
        "@type": "Organization",
        "name": "CHITEK INNOPOWER"
    },
    "publisher": {
        "@type": "Organization",
        "name": "CHITEK INNOPOWER",
        "logo": {
            "@type": "ImageObject",
            "url": "https://en.chitek-inno.com/assets/images/logo.webp"
        }
    },
    "datePublished": "2026-11-18",
    "dateModified": "2026-11-18",
    "keywords": "datacenter harmonic control, SiC AHF, CRAC harmonic filter, CDU power quality, chiller harmonic mitigation, ultra slim AHF, distributed AHF, THDi 5%, CHITEK brochure"
}
  </script>

  <h1 class="sr-only">{article.title}</h1>
  <section class="mt-[72px] bg-[#f4f4f4]">
    <div class="px-4 md:px-6 py-6 md:py-10">
      <FlyerSpread spread={spread} />
    </div>
  </section>
</BaseLayout>
