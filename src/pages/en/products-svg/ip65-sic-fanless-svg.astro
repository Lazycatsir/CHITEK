              <div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
                  <div>
                    <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-text-muted mb-2">Wiring</p>
                    <div class="flex flex-wrap gap-2">
                      <label class="inline-flex items-center rounded-md border border-border-light bg-white px-3.5 py-2.5 text-[16px] font-medium text-text-mid cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="c" data-val="3P3W" /> 3P3W</label>                <label class="inline-flex items-center rounded-md border border-border-light bg-white px-3.5 py-2.5 text-[16px] font-medium text-text-mid cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="c" data-val="3P4W" /> 3P4W</label>
