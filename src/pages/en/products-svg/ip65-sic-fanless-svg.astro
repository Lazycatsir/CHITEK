          <p class="text-[clamp(12px,1.05vw,15px)] text-text-mid leading-[1.7] mb-5 uppercase">
            <strong class="text-text-dark font-bold normal-case">Tags</strong>
            <a href={lp('/')} class="text-[#0000EE] hover:underline">IP65 SiC SVG</a>,
            <a href={lp('/')} class="text-[#0000EE] hover:underline">low-noise static var generator</a>,
            <a href={lp('/')} class="text-[#0000EE] hover:underline">outdoor IP65 SVG module</a>,
            <a href={lp('/')} class="text-[#0000EE] hover:underline">IP65 fanless static var generator</a>,
            <a href={lp('/')} class="text-[#0000EE] hover:underline">weatherproof SiC SVG</a>,
