                <a href="/assets/pdf/ip65-sic-fanless-ahf-datasheet.pdf" data-doc-link="datasheet" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-[14px] font-semibold text-brand-orange hover:underline whitespace-nowrap">Download</a>
