  <!-- PAGE GUIDE scroll spy: highlight the sidebar item of the section you are reading -->
  <script>
    (function () {
      var links = Array.prototype.slice.call(document.querySelectorAll('.js-secnav'));
      if (!links.length) return;

      // 从 DOM 顺序建立「链接 ↔ 分节」配对，缺元素的直接跳过
      var pairs = [];
      links.forEach(function (a) {
        var id = (a.getAttribute('href') || '').slice(1);
        var el = id ? document.getElementById(id) : null;
        if (el) pairs.push({ link: a, el: el });
      });
      if (!pairs.length) return;

      var NAV_H = 72;   // 固定顶栏高度
      var BUFFER = 120; // 判定线再往下留一点，避免刚好压线时来回跳
      var current = null;
      var ticking = false;

      function pick() {
        // 判定线以下的第一个分节不算；取「顶部已越过判定线」的最后一个分节
        var best = null;
        for (var i = 0; i < pairs.length; i++) {
          if (pairs[i].el.getBoundingClientRect().top - (NAV_H + BUFFER) <= 0) best = pairs[i];
          else break;
        }
        // 滚到页面底部时强制选中最后一节（末节常常永远到不了判定线）
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
          best = pairs[pairs.length - 1];
        }
        return best;
      }

      function render() {
        var best = pick();
        if (best === current) return;
        current = best;
        pairs.forEach(function (p) { p.link.classList.toggle('is-active', p === best); });
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { ticking = false; render(); });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      render();
    })();
  </script>

  <style>
    /* 当前所在分节对应的侧栏条目高亮（scoped，特异性高于 Tailwind 单类工具）
       用 :global 是因为 JS 是运行时加类，Astro 的编译期作用域也能匹配到，
       但显式写 :global 可避免将来把这段样式搬到别处时失效。 */
    :global(.js-secnav.is-active) {
      color: var(--color-brand-orange, #ff6b1a);
      border-left-color: var(--color-brand-orange, #ff6b1a);
      background-color: rgba(255, 107, 26, 0.08);
      font-weight: 600;
    }
    /* Product gallery: active thumbnail ring (runtime class -> :global) */
    :global(.gallery-thumb) { cursor: pointer; transition: border-color .15s, box-shadow .15s; }
    :global(.gallery-thumb.is-active) {
      border-color: var(--color-brand-orange, #ff6b1a);
      box-shadow: 0 0 0 2px var(--color-brand-orange, #ff6b1a);
    }
    /* Related products carousel: autoplay wraps around, so arrows stay usable at both ends */
  </style>
  <!-- Configurator summary: SKU line auto-fill -->
  <script is:inline>
    (function () {
      var boxes = Array.prototype.slice.call(document.querySelectorAll('[data-inquiry-summary]'));
      if (!boxes.length) return;
      var inputs = document.querySelectorAll('input[type="checkbox"][data-group]');
      // placeholder specs keyed by current rating (depth mm, weight kg); W x H fixed 500 x 550
      var SPECS = {
        'Unlimited': { d: 135, kg: 27 }, // parallel (up to 16 modules): base module spec as placeholder
        '50A':  { d: 150, kg: 21 },
        '75A':  { d: 142, kg: 24 },
        '100A': { d: 135, kg: 27 },
        '150A': { d: 100, kg: 31 },
        '200A': { d: 118, kg: 38 }
      };
      var DEF = { v: '400V', a: '100A', i: 'Rack', p: 'IP20' };
      function pick(g) {
        var vals = [];
        inputs.forEach(function (inp) {
          if (inp.getAttribute('data-group') === g && inp.checked) vals.push(inp.getAttribute('data-val'));
        });
        return vals;
      }
      function build() {
        var v = pick('v')[0] || DEF.v;
        var a = pick('a')[0] || DEF.a;
        var i = pick('i')[0] || DEF.i;
        var p = pick('p')[0] || DEF.p;
        var spec = SPECS[a] || { d: 135, kg: 27 };
        var partNo = 'IP65_SIC_FANLESS_SVG_' + a + '-' + v + '-' + i + '-' + p;
        var sku = 'SKU: ' + partNo + ' · 500 × 550 × ' + spec.d + ' mm · ' + spec.kg + ' kg · 1300$(EXW)';
        boxes.forEach(function (b) { b.value = sku; });
        // Summary bar: the value lives in a hidden field; the visible line is rebuilt as
        // spans so "SKU:" stays muted while the rest is orange and the price is bold.
        var view = document.querySelector('[data-summary-view]');
        if (view) {
          var t1 = document.createElement('span'); t1.className = 'text-text-mid'; t1.textContent = 'SKU: ';
          var t2 = document.createElement('span');
          t2.textContent = partNo + ' · 500 × 550 × ' + spec.d + ' mm · ' + spec.kg + ' kg · ';
          var t3 = document.createElement('span'); t3.className = 'font-bold'; t3.textContent = '1300$(EXW)';
          view.textContent = '';
          view.appendChild(t1); view.appendChild(t2); view.appendChild(t3);
        }
        // header chip shows the short part number only
        var chip = document.querySelector('[data-sku-chip-val]');
        // part number only (prefix differs per page) -> take the first field of the SKU line
        if (chip) chip.textContent = sku.replace(/^SKU:\s*/, '').split('\u00b7')[0].trim();
      }
      inputs.forEach(function (inp) { inp.addEventListener('change', build); });
      build();
      // Pre-fill the lead form's message field with the SKU line so the sales team
      // receives the exact configuration the visitor selected.
      var msg = document.querySelector('form[data-lead-form] [name="message"]');
      if (msg) {
        boxes.forEach(function (b) {
          b.addEventListener('change', function () { /* value already synced by build() */ });
        });
        var origBuild = build;
        build = function () {
          origBuild();
          msg.value = document.querySelector('[data-inquiry-summary]').value;
        };
        var boxesNow = document.querySelectorAll('[data-inquiry-summary]');
        if (boxesNow.length) msg.value = boxesNow[0].value;
      }
    })();
  </script>

  <!-- Quote form: analytics.js calls form.reset() on success, which would blank the
       read-only SKU textarea. Keep re-filling it briefly so the visitor can still see
       the configuration they just requested. Attached before analytics.js binds. -->
  <script is:inline>
    (function () {
      var form = document.querySelector('form[name="quote"]');
      var ta = form && form.querySelector('[name="message"]');
      if (!form || !ta) return;
      form.addEventListener('submit', function () {
        var snapshot = ta.value;
        if (!snapshot) return;
        // form.reset() only runs after the POST resolves, so poll for a moment
        // rather than trusting a single 0ms timer.
        var tries = 0;
        var iv = setInterval(function () {
          if (ta.value !== snapshot) ta.value = snapshot;
          if (++tries > 100) clearInterval(iv);   // 最多约 10 秒
        }, 100);
      });
    })();
  </script>

  <!-- Product gallery: thumbnail click swaps the main image -->
  <script is:inline>
    (function () {
      var main = document.querySelector('[data-gallery-main]');
      var thumbs = Array.prototype.slice.call(document.querySelectorAll('[data-gallery-thumb]'));
      if (!main || !thumbs.length) return;
      thumbs.forEach(function (t) {
        t.addEventListener('click', function () {
          main.src = t.getAttribute('data-src');
          main.alt = t.getAttribute('data-alt') || main.alt;
          thumbs.forEach(function (o) { o.classList.toggle('is-active', o === t); });
        });
      });
    })();
  </script>

  <!-- Related products: 4-up carousel (9 slides = the same 9 products as the /products grid) -->
  <script is:inline>
    (function () {
      var track = document.querySelector('[data-rel-track]');
      var vp = document.querySelector('[data-rel-viewport]');
      var prev = document.querySelector('[data-rel-prev]');
      var next = document.querySelector('[data-rel-next]');
      if (!track || !vp || !prev || !next) return;
      var cards = Array.prototype.slice.call(track.querySelectorAll('.rel-card'));
      var i = 0;

      function step() {
        if (cards.length < 2) return cards[0].getBoundingClientRect().width;
        return cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left;
      }
      // how many cards are fully visible right now: 1 on phones, 4 on desktop
      function visibleCount() {
        if (cards.length < 2) return 1;
        var s = step();
        if (s <= 0) return 1;
        var a = cards[0].getBoundingClientRect();
        var b = cards[1].getBoundingClientRect();
        var gap = Math.max(0, b.left - a.right);
        return Math.max(1, Math.round((vp.getBoundingClientRect().width + gap) / s));
      }
      function maxIndex() { return Math.max(0, cards.length - visibleCount()); }
      function go() {
        if (i > maxIndex()) i = maxIndex();
        track.style.transform = 'translateX(' + (-i * step()) + 'px)';
        prev.disabled = i === 0;
        next.disabled = i >= maxIndex();
      }
      function sync() {
        go();
      }
      prev.addEventListener('click', function () { if (i > 0) { i--; go(); } restart(); });
      next.addEventListener('click', function () { if (i < maxIndex()) { i++; go(); } restart(); });

      // drag / swipe
      var x0 = null;
      vp.addEventListener('pointerdown', function (e) { x0 = e.clientX; });
      vp.addEventListener('pointercancel', function () { x0 = null; });
      vp.addEventListener('dragstart', function (e) { e.preventDefault(); });
      window.addEventListener('pointerup', function (e) {
        if (x0 === null) return;
        var dx = e.clientX - x0; x0 = null;
        if (dx < -40 && i < maxIndex()) { i++; go(); }
        else if (dx > 40 && i > 0) { i--; go(); }
        else return;
        restart();
      });

      // ---- autoplay: advance every 6s, loop back to the start ----
      var DELAY = 6000;
      var timer = null;
      var paused = false;
      function tick() {
        if (paused) return;
        i = (i >= maxIndex()) ? 0 : i + 1;   // wrap around to the first slide
        go();
      }
      function restart() {
        if (timer) clearInterval(timer);
        timer = setInterval(tick, DELAY);
      }
      // pause while the pointer is over the carousel or a slide has focus
      var root = vp.parentNode;
      root.addEventListener('mouseenter', function () { paused = true; });
      root.addEventListener('mouseleave', function () { paused = false; });
      root.addEventListener('focusin', function () { paused = true; });
      root.addEventListener('focusout', function () { paused = false; });
      // pause when scrolled out of view so we do not animate off-screen
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          paused = !entries[0].isIntersecting;
        }, { threshold: 0.15 }).observe(vp);
      } else {
        // fallback: pause when the document is hidden
        document.addEventListener('visibilitychange', function () {
          paused = document.hidden;
        });
      }

      window.addEventListener('resize', sync);
      sync();
      restart();
    })();
  </script>

