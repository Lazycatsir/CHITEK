---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const meta = {
  title: 'IP65 SiC-Fanless & Low Noise Static Var Generator | Static Var Generator | CHITEK',
  description: 'CHITEK IP65 SiC-Fanless & Low Noise Static Var Generator — silicon-carbide (SiC) MOSFET static var generator (SVG). Power factor held at your target, 208-690V, 8 A – 20 A per module (parallel expandable, unlimited).',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/en' + p : p;
---

<BaseLayout title={meta.title} description={meta.description} lang="en" alternates={false}>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <!-- SVG series detail page (2026-09-27). Structure ported from src/pages/en/products/ip65-sic-fanless-ahf.astro with AHF to SVG wording. TODO technical sign-off: Compensation Performance 97%, Compensation Range, Power Factor row, and the three application cases (numbers carried over unchanged). -->

  <!-- Structured data: BreadcrumbList + Product -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://en.chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "Static Var Generator", "item": "https://en.chitek-inno.com/products-svg" },
      { "@type": "ListItem", "position": 3, "name": "IP65 SiC-Fanless & Low Noise Static Var Generator", "item": "https://en.chitek-inno.com/products-svg/ip65-sic-fanless-svg" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "CHITEK IP65 SiC-Fanless & Low Noise Static Var Generator",
    "brand": { "@type": "Brand", "name": "CHITEK INNOPOWER" },
    "description": "CHITEK IP65 SiC-Fanless & Low Noise Static Var Generator (silicon-carbide (SiC) MOSFET static var generator (SVG)) delivering real-time reactive power compensation, power factor correction and load balancing with power factor held at your target across a 208–690V, 8 A – 20 A per module (parallel expandable, unlimited) range.",
    "category": "Power Quality / Reactive Power Compensation",
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "Rated Voltage", "value": "208-690V" },
      { "@type": "PropertyValue", "name": "Rated Capacity", "value": "8 A – 20 A per module (parallel expandable, unlimited)" },
      { "@type": "PropertyValue", "name": "Frequency", "value": "50/60 Hz" },
      { "@type": "PropertyValue", "name": "Wiring", "value": "3P3W / 3P4W" },
      { "@type": "PropertyValue", "name": "Compensation Range", "value": "Continuous, inductive and capacitive (inject or absorb)" },
      { "@type": "PropertyValue", "name": "Full Response Time", "value": "<50 us" },
      { "@type": "PropertyValue", "name": "Switching Frequency", "value": "up to 40 kHz (SiC)" },
      { "@type": "PropertyValue", "name": "Efficiency", "value": ">=98%" },
      { "@type": "PropertyValue", "name": "Power Factor", "value": "Held at the target you set (closed loop)" },
      { "@type": "PropertyValue", "name": "Topology", "value": "3-level NPC, SiC MOSFET" },
      { "@type": "PropertyValue", "name": "Standard", "value": "IEC 61000 / IEC 62477" },
      { "@type": "PropertyValue", "name": "Communication", "value": "MODBUS / optional Ethernet" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is a SiC MOSFET static var generator?", "acceptedAnswer": { "@type": "Answer", "text": "A SiC static var generator replaces the conventional silicon IGBT bridge with silicon-carbide power devices. SiC switches faster with lower loss, so the unit achieves higher efficiency, higher power density and lower heat rejection while still tracking the network's reactive demand continuously and holding power factor at the target you set." } },
      { "@type": "Question", "name": "Why choose silicon carbide instead of IGBT?", "acceptedAnswer": { "@type": "Answer", "text": "SiC MOSFETs tolerate higher switching frequencies (up to 40 kHz), which shrinks the magnetics, raises efficiency to 98% or more and reduces thermal loss by roughly a third — a smaller cabinet for the same capacity, less cooling and longer device life." } },
      { "@type": "Question", "name": "How does the Ultra SVG work?", "acceptedAnswer": { "@type": "Answer", "text": "An external CT samples the load current; a DSP/FPGA separates the reactive component and the phase imbalance in real time; the SiC bridge then injects or absorbs an equal and opposite-phase compensation current, so the utility sees only the fundamental and the power factor stays at target." } },
      { "@type": "Question", "name": "What capacity and voltage range is available?", "acceptedAnswer": { "@type": "Answer", "text": "208–690V, 3P3W/3P4W, 50A to 200A per module. Modules parallel without a practical limit to reach 3000 A and beyond for large plants." } },
      { "@type": "Question", "name": "Can it hold power factor and balance loads at the same time?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A selectable priority function covers reactive power compensation, power factor correction and three-phase balancing. In 3P4W mode it also cancels the accumulated neutral current." } },
      { "@type": "Question", "name": "How do I confirm the right model for my site?", "acceptedAnswer": { "@type": "Answer", "text": "Send us the load profile, voltage class and your target power factor. CHITEK supplies a selection matrix by voltage class, series and capacity, plus a sizing calculation on request." } }
    ]
  }
  </script>

  <!-- Breadcrumb (full width, above the sidebar so it is never overlapped) -->
