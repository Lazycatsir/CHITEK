      <a href={lp('/')} class="hover:text-brand-orange transition-colors">Home</a>
      <span class="mx-2 text-border-light">/</span>
      <a href={lp('/products-svg')} class="hover:text-brand-orange transition-colors">Static Var Generator</a>
      <span class="mx-2 text-border-light">/</span>
      <span class="text-text-dark font-medium">IP65 SiC-Fanless &amp; Low Noise Static Var Generator</span>
    </div>
  </nav>

  <!-- Left section navigation (desktop sticky sidebar) + content column -->
  <div class="lg:flex">
    <aside class="hidden lg:block lg:w-[140px] shrink-0 border-r border-border-light">
      <nav class="sticky top-[72px] max-h-[calc(100vh-72px)] overflow-y-auto py-8 px-2" aria-label="Section navigation">
        <p class="px-2 mb-3 text-[12px] font-semibold uppercase tracking-[0.15em] text-text-muted">PAGE GUIDE</p>
          <a href="#overview" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] leading-snug font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Overview</a>
          <a href="#description" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Product Description</a>
          <a href="#parameters" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Technical Parameters</a>
          <a href="#why" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Why CHITEK</a>
          <a href="#manufacturing" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Manufacturing &amp; QA</a>
          <a href="#faq" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">FAQ</a>
          <a href="#application" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Application</a>
      </nav>
    </aside>
    <div class="flex-1 min-w-0">

  <!-- Product top: description (left) + product image (right). No background image. -->
