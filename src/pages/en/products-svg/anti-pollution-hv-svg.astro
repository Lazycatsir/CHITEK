      var hwEnd = row.querySelector('[data-easy-install-hw-end]');
      var swStart = row.querySelector('[data-easy-install-sw-start]');
      if (!media || !card || !hwStart || !hwEnd || !swStart) return;

      function sync() {
        var c = card.getBoundingClientRect();
        var hwTop = hwStart.getBoundingClientRect().top;
        var hwBottom = hwEnd.getBoundingClientRect().bottom;
        var swTop = swStart.getBoundingClientRect().top;
        media.style.setProperty('--ei-hw-top', Math.round(hwTop - c.top) + 'px');
        media.style.setProperty('--ei-hw-h', Math.round(hwBottom - hwTop) + 'px');
        media.style.setProperty('--ei-hw-sw-gap', Math.round(swTop - hwBottom) + 'px');
      }
      sync();
      window.addEventListener('resize', sync);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(sync);
    })();
  </script>
