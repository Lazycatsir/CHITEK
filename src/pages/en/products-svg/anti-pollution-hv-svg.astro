---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const meta = {
  title: '690V/800V Anti-Pollution Static Var Generator SVG | Static Var Generator | CHITEK',
  description: 'CHITEK 690V/800V Anti-Pollution Static Var Generator SVG — IGBT static var generator (SVG). Power factor held at your target, 690-800V, 50 A – 200 A per module (parallel expandable, unlimited).',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/en' + p : p;
