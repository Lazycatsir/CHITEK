  <!-- Related products: 4-up carousel (9 slides = the same 9 products as the /products grid) -->
  <script is:inline>
    (function () {
      var track = document.querySelector('[data-rel-track]');
      var vp = document.querySelector('[data-rel-viewport]');
      var prev = document.querySelector('[data-rel-prev]');
      var next = document.querySelector('[data-rel-next]');
      if (!track || !vp || !prev || !next) return;
      var cards = Array.prototype.slice.call(track.querySelectorAll('.rel-card'));
      var i = 0;

      function step() {
        if (cards.length < 2) return cards[0].getBoundingClientRect().width;
        return cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left;
      }
      // how many cards are fully visible right now: 1 on phones, 4 on desktop
      function visibleCount() {
        if (cards.length < 2) return 1;
        var s = step();
        if (s <= 0) return 1;
        var a = cards[0].getBoundingClientRect();
        var b = cards[1].getBoundingClientRect();
        var gap = Math.max(0, b.left - a.right);
        return Math.max(1, Math.round((vp.getBoundingClientRect().width + gap) / s));
      }
      function maxIndex() { return Math.max(0, cards.length - visibleCount()); }
      function go() {
        if (i > maxIndex()) i = maxIndex();
        track.style.transform = 'translateX(' + (-i * step()) + 'px)';
        prev.disabled = i === 0;
        next.disabled = i >= maxIndex();
      }
      function sync() {
        go();
      }
      prev.addEventListener('click', function () { if (i > 0) { i--; go(); } restart(); });
      next.addEventListener('click', function () { if (i < maxIndex()) { i++; go(); } restart(); });

      // drag / swipe
      var x0 = null;
      vp.addEventListener('pointerdown', function (e) { x0 = e.clientX; });
      vp.addEventListener('pointercancel', function () { x0 = null; });
      vp.addEventListener('dragstart', function (e) { e.preventDefault(); });
      window.addEventListener('pointerup', function (e) {
        if (x0 === null) return;
        var dx = e.clientX - x0; x0 = null;
        if (dx < -40 && i < maxIndex()) { i++; go(); }
        else if (dx > 40 && i > 0) { i--; go(); }
        else return;
        restart();
      });

      // ---- autoplay: advance every 6s, loop back to the start ----
      var DELAY = 6000;
      var timer = null;
      var paused = false;
      function tick() {
        if (paused) return;
        i = (i >= maxIndex()) ? 0 : i + 1;   // wrap around to the first slide
        go();
      }
      function restart() {
        if (timer) clearInterval(timer);
        timer = setInterval(tick, DELAY);
      }
      // pause while the pointer is over the carousel or a slide has focus
      var root = vp.parentNode;
      root.addEventListener('mouseenter', function () { paused = true; });
      root.addEventListener('mouseleave', function () { paused = false; });
      root.addEventListener('focusin', function () { paused = true; });
      root.addEventListener('focusout', function () { paused = false; });
      // pause when scrolled out of view so we do not animate off-screen
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          paused = !entries[0].isIntersecting;
        }, { threshold: 0.15 }).observe(vp);
      } else {
        // fallback: pause when the document is hidden
        document.addEventListener('visibilitychange', function () {
          paused = document.hidden;
        });
      }

      window.addEventListener('resize', sync);
      sync();
      restart();
    })();
  </script>

  <!-- Parameters table: everything below "Target power factor" sits behind a toggle -->
  <script>
    (function () {
      var btns = Array.prototype.slice.call(document.querySelectorAll('[data-param-toggle]'));
      if (!btns.length) return;
      btns.forEach(function (btn) {
        var panel = document.getElementById(btn.getAttribute('aria-controls'));
        if (!panel) return;
        var label = btn.querySelector('[data-param-toggle-label]');
        var icon = btn.querySelector('[data-param-toggle-icon]');
        function isOpen() { return !panel.hasAttribute('hidden'); }
        function render() {
          var open = isOpen();
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (label) label.textContent = open ? 'Show fewer parameters' : 'Show all parameters';
          if (icon) icon.classList.toggle('rotate-180', open);
        }
        btn.addEventListener('click', function () {
          if (isOpen()) panel.setAttribute('hidden', '');
          else panel.removeAttribute('hidden');
          render();
        });
        render();
      });
    })();
  </script>
</BaseLayout>
