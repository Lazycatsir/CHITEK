  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "CHITEK 690V/800V Anti-Pollution Static Var Generator SVG",
    "brand": { "@type": "Brand", "name": "CHITEK INNOPOWER" },
    "description": "CHITEK 690V/800V Anti-Pollution Static Var Generator SVG (IGBT static var generator (SVG)) delivering real-time reactive power compensation, power factor correction and load balancing with power factor held at your target across a 690–800V, 50 A – 200 A per module (parallel expandable, unlimited) range.",
    "category": "Power Quality / Reactive Power Compensation",
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "Rated Voltage", "value": "690-800V" },
      { "@type": "PropertyValue", "name": "Rated Capacity", "value": "50 A – 200 A per module (parallel expandable, unlimited)" },
      { "@type": "PropertyValue", "name": "Frequency", "value": "50/60 Hz" },
      { "@type": "PropertyValue", "name": "Wiring", "value": "3P3W / 3P4W" },
      { "@type": "PropertyValue", "name": "Compensation Range", "value": "Continuous, inductive and capacitive (inject or absorb)" },
      { "@type": "PropertyValue", "name": "Full Response Time", "value": "<50 us" },
      { "@type": "PropertyValue", "name": "Switching Frequency", "value": "up to 20 kHz (IGBT)" },
      { "@type": "PropertyValue", "name": "Efficiency", "value": ">=98%" },
      { "@type": "PropertyValue", "name": "Power Factor", "value": "Held at the target you set (closed loop)" },
      { "@type": "PropertyValue", "name": "Topology", "value": "3-level NPC, IGBT" },
      { "@type": "PropertyValue", "name": "Standard", "value": "IEC 61000 / IEC 62477" },
      { "@type": "PropertyValue", "name": "Communication", "value": "MODBUS / optional Ethernet" }
    ]
  }
  </script>
    <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is an static var generator (SVG)?", "acceptedAnswer": { "@type": "Answer", "text": "A static var generator is a power-electronics device that measures the load current with an external CT, separates the reactive component from the active current with a DSP, and injects or absorbs the compensation current through a fast inverter bridge. The utility then sees only the fundamental, with the power factor at the level you set." } },
      { "@type": "Question", "name": "How does the SVG work?", "acceptedAnswer": { "@type": "Answer", "text": "An external CT samples the load current; a DSP/FPGA separates the reactive component and the phase imbalance in real time; the inverter bridge then injects or absorbs the compensation current continuously rather than in switched steps. The result is a stepless correction that holds power factor at target at the point of common coupling." } },
      { "@type": "Question", "name": "What capacity and voltage range is available?", "acceptedAnswer": { "@type": "Answer", "text": "50 A – 200 A per module (parallel expandable, unlimited), 3P3W/3P4W, covering 690–800V. Modules parallel without a practical limit to reach 3000 A and beyond for large plants." } },
      { "@type": "Question", "name": "Can it hold power factor and balance loads at the same time?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A selectable priority function covers reactive power compensation, power factor correction and three-phase balancing. In 3P4W mode it also cancels the accumulated neutral current." } },
      { "@type": "Question", "name": "How is it installed and what protection rating does it have?", "acceptedAnswer": { "@type": "Answer", "text": "Installed as wall-mounted or rack / cabinet type; rated IP20, IP30 (customizable). The enclosure is built for the duty cycle of industrial switchrooms and can be customized for harsher or outdoor sites." } },
      { "@type": "Question", "name": "How do I confirm the right model for my site?", "acceptedAnswer": { "@type": "Answer", "text": "Send us the load profile, voltage class and your target power factor. CHITEK supplies a selection matrix by voltage class, series and capacity, plus a sizing calculation on request." } }
    ]
  }
