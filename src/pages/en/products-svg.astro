  description: 'CHITEK Static Var Generator (SVG) delivers stepless reactive power compensation and power factor correction for low-voltage networks — wall, rack, distributed and IP65 series.',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/en' + p : p;
