  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the difference between an SVG and a capacitor bank?", "acceptedAnswer": { "@type": "Answer", "text": "A static var generator (SVG) is an active, stepless compensator that reads the reactive demand continuously and injects exactly what the network needs, so correction tracks the load in real time. A capacitor or reactor bank switches in fixed steps, which means jumps in power factor, possible resonance and regular maintenance. The two differ across response time, output, power factor correction, design and sizing, resonance, overloading, footprint and installation, expansion, and maintenance and lifetime." } },
      { "@type": "Question", "name": "Can one SVG follow a fluctuating load?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, and that is where it beats a switched bank. Welding, motor starts and drive ramps change the reactive demand many times a second. The generator tracks those changes cycle by cycle, so it also covers the fast swings a contactor-based bank never sees." } },
      { "@type": "Question", "name": "Can SVG units be combined for a higher capacity?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The range is modular, so units can be paralleled to cover anything from a single wall-mounted module to a large plant, instead of forcing everything through one oversized cabinet." } },
      { "@type": "Question", "name": "Can SVG be installed outdoors or in harsh environments?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Alongside indoor enclosures, the range includes IP65 models for outdoor and dusty sites, plus anti-pollution and fanless low-noise versions for switchrooms where dust, corrosion or acoustic noise is the constraint." } }
    ]
  }
  </script>
