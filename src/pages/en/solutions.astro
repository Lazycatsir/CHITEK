---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dataMap, heroImages, industryTitles } from '../../data/enSolutions.js';
import { solutionMeta } from '../../data/enSolutionMeta.js';
import { SYMPTOM_ROUTES, DECISION_TREE, ROUTE_DEVICE_LABEL } from '../../data/enSolutionRouting.js';

// Render an equipment list as prose: "a, b, c and d".
const eqText = (arr) =>
  arr.length < 2 ? (arr[0] || '') : arr.slice(0, -1).join(', ') + ' and ' + arr[arr.length - 1];

const meta = {
  title: 'Power Quality Solutions – Industrial & Utility Applications | CHITEK',
  description:
    'CHITEK provides power quality solutions for Industrial Manufacturing, Commercial Buildings, Data Centers, Renewable Energy, Transportation, and Power Grid applications.',
};

const HOST = 'https://en.chitek-inno.com';
const canonical = `${HOST}/solutions`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${HOST}/` },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: canonical },
  ],
};

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Power quality solutions by industry',
  itemListElement: solutionMeta.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.navLabel,
    url: `${HOST}/solutions/${m.slug}`,
  })),
};
---

<BaseLayout title={meta.title} description={meta.description} lang="en" alternates={false}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemList)} />

  <main class="mt-[72px]">

    <section class="relative min-h-[46vh] flex flex-col justify-end overflow-hidden">
      <div class="absolute inset-0">
        <img src="/assets/images/solutions-commercial-medical-hero-bg.webp" alt="" class="object-cover w-full h-full" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
      </div>
      <div class="relative z-10 w-full px-[clamp(24px,8vw,160px)] pb-10 pt-16">
        <nav class="text-white/70 text-[13px] tracking-[0.08em] mb-3" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/en/" class="hover:text-brand-orange">Home</a></li>
            <li class="text-white/40" aria-hidden="true">/</li>
            <li class="text-white font-medium" aria-current="page">Solutions</li>
          </ol>
        </nav>
        <h1 class="text-[clamp(28px,3.5vw,56px)] font-bold leading-tight text-white font-barlow-condensed max-w-4xl">
          Power Quality Solutions by Industry
        </h1>
        <p class="mt-5 text-[clamp(14px,1.2vw,20px)] text-white/80 max-w-2xl leading-relaxed">
          Harmonic filtering and reactive compensation for six application sectors. Each page names the equipment that
          causes the problem — VFD banks, welding sets, induction furnaces, UPS rectifiers, LED drivers, traction
          loads, inverter clusters — and the device CHITEK installs for it.
        </p>
      </div>
    </section>

    <section class="px-[clamp(24px,8vw,160px)] py-12 lg:py-16">
      <h2 class="text-[clamp(22px,2.4vw,40px)] font-bold text-brand-navy font-barlow-condensed">
        Choose your industry
      </h2>
      <div class="mt-3 mb-8 w-36 h-[3px] rounded-full bg-brand-orange/70"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[clamp(16px,2vw,32px)]">
        {solutionMeta.map((m) => (
          <a
            href={`/en/solutions/${m.slug}`}
            class="group bg-bg-card border border-border-card rounded-xl overflow-hidden hover:border-brand-orange transition-colors"
          >
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={heroImages[m.id]}
                alt=""
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-[clamp(16px,1.6vw,24px)]">
              <h3 class="text-[clamp(16px,1.4vw,22px)] font-semibold text-text-primary font-barlow-condensed">
                {m.navLabel}
              </h3>
              <p class="mt-2 text-[13px] text-text-secondary leading-relaxed">
                {m.card.lead}{" "}
                <strong class="font-semibold text-text-primary">{eqText(m.card.equipment)}</strong>.
              </p>
              <p class="mt-4 inline-flex items-center gap-1.5 text-electric-orange font-medium text-[13px]">
                View solutions
                <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="px-[clamp(24px,8vw,160px)] py-10 lg:py-14 bg-bg-alt-1">
      <h2 class="text-[clamp(22px,2.4vw,40px)] font-bold text-brand-navy font-barlow-condensed">
        What every project starts with
      </h2>
      <div class="mt-3 mb-8 w-36 h-[3px] rounded-full bg-brand-orange/70"></div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[clamp(16px,2vw,32px)] max-w-5xl">
        <div>
          <h3 class="text-[16px] font-semibold text-text-primary font-barlow-condensed">1. Measure first</h3>
          <p class="mt-2 text-[13px] text-text-secondary leading-relaxed">
            A power quality survey at the point of common coupling: harmonic spectrum, reactive profile and load cycle.
            Sizing from transformer kVA alone is the usual reason an installation ends up undersized.
          </p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold text-text-primary font-barlow-condensed">2. Size to the spectrum</h3>
          <p class="mt-2 text-[13px] text-text-secondary leading-relaxed">
            AHF capacity follows the measured harmonic current; SVG capacity follows the reactive swing. Where a
            capacitor bank is already installed, anti-resonance control and CT placement decide whether it can stay.
          </p>
        </div>
        <div>
          <h3 class="text-[16px] font-semibold text-text-primary font-barlow-condensed">3. Verify on site</h3>
          <p class="mt-2 text-[13px] text-text-secondary leading-relaxed">
            Acceptance is measured after energisation against the applicable limit, normally GB/T 14549 or IEEE 519 at
            the point of common coupling.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ A. Symptom -> device routing table (GEO: extractable "which device for which problem") ═══ -->
    <section class="px-[clamp(24px,8vw,160px)] py-12 lg:py-16">
      <h2 class="text-[clamp(22px,2.4vw,40px)] font-bold text-brand-navy font-barlow-condensed">
        Which device fixes which problem?
      </h2>
      <div class="mt-3 mb-4 w-36 h-[3px] rounded-full bg-brand-orange/70"></div>
      <p class="max-w-4xl text-[14px] text-text-secondary leading-relaxed mb-8">
        Two product families, and the split between them is not a preference — it follows from what the
        measurement shows. AHF removes harmonic current. SVG supplies and absorbs reactive power. The table
        below starts from the symptom, gives the reading that confirms it, and names the device that addresses it.
        Where a site shows both, the two are rated separately rather than sized as alternatives.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left text-[13px] min-w-[860px]">
          <caption class="sr-only">Symptom, confirming measurement and recommended device for low-voltage power quality problems</caption>
          <thead>
            <tr class="bg-bg-alt-1">
              <th scope="col" class="border border-border-card px-4 py-3 font-semibold text-text-primary font-barlow-condensed w-[26%]">Symptom</th>
              <th scope="col" class="border border-border-card px-4 py-3 font-semibold text-text-primary font-barlow-condensed w-[26%]">What to measure first</th>
              <th scope="col" class="border border-border-card px-4 py-3 font-semibold text-text-primary font-barlow-condensed w-[14%]">Device</th>
              <th scope="col" class="border border-border-card px-4 py-3 font-semibold text-text-primary font-barlow-condensed">Why it works</th>
            </tr>
          </thead>
          <tbody>
            {SYMPTOM_ROUTES.map((r) => (
              <tr>
                <th scope="row" class="border border-border-card px-4 py-3 font-medium text-text-primary align-top leading-relaxed">
                  {r.symptom}
                </th>
                <td class="border border-border-card px-4 py-3 text-text-secondary align-top leading-relaxed">{r.measure}</td>
                <td class="border border-border-card px-4 py-3 align-top">
                  <span
                    class:list={[
                      'route-badge',
                      'inline-flex px-2.5 py-1 rounded text-[11px] font-bold tracking-[0.06em] whitespace-nowrap',
                      r.device === 'ahf' && 'bg-brand-navy text-white',
                      r.device === 'svg' && 'bg-brand-orange text-white',
                      r.device === 'both' && 'bg-bg-alt-3 text-brand-navy border border-brand-orange',
                    ]}
                  >
                    {ROUTE_DEVICE_LABEL[r.device]}
                  </span>
                </td>
                <td class="border border-border-card px-4 py-3 text-text-secondary align-top leading-relaxed">
                  {r.why}
                  <span class="block mt-1.5 text-[12px] text-text-muted">{r.note}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href="/en/products"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border-card bg-bg-card text-[13px] font-semibold text-text-primary hover:border-brand-orange transition-colors"
        >
          Browse active harmonic filters (AHF)
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href="/en/products-svg"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border-card bg-bg-card text-[13px] font-semibold text-text-primary hover:border-brand-orange transition-colors"
        >
          Browse static var generators (SVG)
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href="/en/products-asvg"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border-card bg-bg-card text-[13px] font-semibold text-text-primary hover:border-brand-orange transition-colors"
        >
          Browse advanced static var generators (ASVG)
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- ═══ B. Decision tree (AHF vs SVG) — server-rendered, works with JS disabled ═══ -->
    <section class="px-[clamp(24px,8vw,160px)] py-10 lg:py-14 bg-bg-alt-1" id="device-selector">
      <h2 class="text-[clamp(22px,2.4vw,40px)] font-bold text-brand-navy font-barlow-condensed">
        Which device do I need?
      </h2>
      <div class="mt-3 mb-4 w-36 h-[3px] rounded-full bg-brand-orange/70"></div>
      <p class="max-w-4xl text-[14px] text-text-secondary leading-relaxed mb-8">
        Walk the three questions below. The whole tree is on the page, so you can read the path end to end
        without clicking anything — or step through it if you prefer.
      </p>

      <div class="max-w-5xl" id="dq-widget" role="group" aria-label="AHF or SVG device selector">
        <!-- Question panels -->
        <div class="space-y-6">
          {Object.entries(DECISION_TREE).filter(([, node]) => node.options).map(([nodeId, node]) => (
            <div class="bg-bg-card border border-border-card rounded-xl p-[clamp(16px,2vw,28px)] dq-panel" data-node={nodeId}>
              <p class="text-[11px] font-bold tracking-[0.1em] text-text-muted uppercase">Step</p>
              <h3 class="mt-1 text-[clamp(16px,1.5vw,22px)] font-semibold text-text-primary font-barlow-condensed">
                {node.question}
              </h3>
              <div class="mt-4 flex flex-wrap gap-2.5">
                {node.options.map((o) => (
                  <button
                    type="button"
                    class="dq-btn inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-border-card bg-bg-alt-1 text-[13px] font-medium text-text-primary text-left hover:border-brand-orange hover:text-brand-orange transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange"
                    data-next={o.next}
                  >
                    {o.label}
                    <span aria-hidden="true">&rarr;</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- Outcome panels -->
        <div class="mt-6 space-y-4">
          {Object.entries(DECISION_TREE).filter(([, node]) => node.device).map(([nodeId, node]) => (
            <div class="dq-result hidden bg-bg-card border-l-[3px] border-brand-orange rounded-r-xl p-[clamp(16px,2vw,28px)]" data-result={nodeId} role="group" aria-live="polite" aria-label="Device recommendation">
              <p class="text-[11px] font-bold tracking-[0.1em] uppercase text-electric-orange">
                Recommendation &mdash; {ROUTE_DEVICE_LABEL[node.device]}
              </p>
              <h3 class="mt-1.5 text-[clamp(17px,1.6vw,24px)] font-bold text-brand-navy font-barlow-condensed">
                {node.heading}
              </h3>
              <p class="mt-2.5 text-[14px] text-text-secondary leading-relaxed max-w-3xl">{node.body}</p>

              <h4 class="mt-5 text-[13px] font-bold text-brand-navy font-barlow-condensed tracking-[0.04em] uppercase">
                What to do next
              </h4>
              <ul class="mt-2 space-y-1.5">
                {node.nextSteps.map((s) => (
                  <li class="flex items-start gap-2 text-[13px] text-text-secondary leading-relaxed">
                    <span class="mt-[6px] w-1.5 h-1.5 rounded-full bg-brand-orange flex-shrink-0"></span>
                    <span>{s}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-5 flex flex-wrap gap-3">
                {
                  node.device === 'ahf' && (
                    <a href="/en/products" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-orange text-white text-[13px] font-semibold no-underline hover:bg-electric-orange transition-colors">
                      See AHF models
                    </a>
                  )
                }
                {
                  node.device === 'svg' && (
                    <a href="/en/products-svg" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-orange text-white text-[13px] font-semibold no-underline hover:bg-electric-orange transition-colors">
                      See SVG models
                    </a>
                  )
                }
                {
                  node.device === 'both' && (
                    <>
                      <a href="/en/products" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-orange text-white text-[13px] font-semibold no-underline hover:bg-electric-orange transition-colors">
                        See AHF models
                      </a>
                      <a href="/en/products-svg" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-orange text-white text-[13px] font-semibold no-underline hover:bg-electric-orange transition-colors">
                        See SVG models
                      </a>
                    </>
                  )
                }
                <button type="button" class="dq-reset px-5 py-2.5 rounded-lg border border-border-card bg-bg-card text-[13px] font-semibold text-text-primary hover:border-brand-orange transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-orange">
                  Start over
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Full tree, always readable (also the no-JS fallback) -->
      <details class="mt-8 max-w-5xl group">
        <summary class="cursor-pointer text-[14px] font-semibold text-text-primary hover:text-brand-orange">
          Show the full decision path as a list
        </summary>
        <ol class="mt-4 space-y-4 text-[13px] text-text-secondary leading-relaxed list-decimal pl-5">
          {Object.entries(DECISION_TREE).filter(([, node]) => node.options).map(([nodeId, node]) => (
            <li>
              <span class="font-semibold text-text-primary">{node.question}</span>
              <ul class="mt-1.5 space-y-1 list-none pl-0">
                {node.options.map((o) => (
                  <li>
                    &middot; {o.label} &rarr;{' '}
                    <span class="text-text-primary">
                      {DECISION_TREE[o.next].heading || DECISION_TREE[o.next].question}
                    </span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </details>
    </section>

    <section class="px-[clamp(24px,8vw,160px)] py-12 lg:py-16 text-center">
      <h2 class="text-[clamp(19px,1.8vw,28px)] font-bold text-brand-navy font-barlow-condensed">
        Get a power quality assessment for your site
      </h2>
      <p class="mt-3 text-[14px] text-text-secondary max-w-2xl mx-auto leading-relaxed">
        Send us your single-line diagram and load list and we will tell you what we would measure first.
      </p>
      <a
        href="/en/contact"
        class="inline-block mt-6 px-8 py-3 rounded-lg bg-brand-orange text-white font-semibold text-[15px] hover:bg-electric-orange transition-colors"
      >
        Contact our engineers
      </a>
    </section>

  </main>
  <script>
    // ── AHF vs SVG decision tree ──
    // Progressive enhancement: every panel is already in the DOM and the full
    // path is listed in <details>, so the section reads end to end with JS off.
    (function () {
      'use strict';
      var root = document.getElementById('dq-widget');
      if (!root) return;
      if (root.getAttribute('data-dq-ready') === '1') return;
      root.setAttribute('data-dq-ready', '1');

      var panels = root.querySelectorAll('.dq-panel');
      var results = root.querySelectorAll('.dq-result');
      var resets = root.querySelectorAll('.dq-reset');

      function show(nodeId) {
        panels.forEach(function (p) {
          var match = p.getAttribute('data-node') === nodeId;
          p.classList.toggle('hidden', !match);
          if (match) p.closest('.space-y-6').style.setProperty('--dq-top', '0');
        });
        // Hide every sibling panel block once a result is reached
        results.forEach(function (r) {
          r.classList.toggle('hidden', r.getAttribute('data-result') !== nodeId);
        });
        // Panels outside the current path are hidden by the loop above only for
        // the matched node; hide the rest explicitly.
        panels.forEach(function (p) {
          if (p.getAttribute('data-node') !== nodeId) p.classList.add('hidden');
        });
      }

      function showPanelsOnly() {
        panels.forEach(function (p) { p.classList.remove('hidden'); });
        results.forEach(function (r) { r.classList.add('hidden'); });
      }

      root.querySelectorAll('.dq-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var next = btn.getAttribute('data-next');
          show(next);
        });
      });

      resets.forEach(function (b) {
        b.addEventListener('click', function () {
          showPanelsOnly();
          var first = root.querySelector('.dq-panel');
          if (first) first.querySelector('.dq-btn').focus();
        });
      });

      // Nothing hidden by default: the panels are the starting state.
      showPanelsOnly();
    })();
  </script>
</BaseLayout>
