---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = {
  title: 'CHITEK — Advanced Static Var Generator (ASVG) | Power Factor Correction',
  description: 'CHITEK Advanced Static Var Generator (ASVG) delivers stepless reactive power compensation and power factor correction for low-voltage networks — wall-mounted, distributed and IP65 series.',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/en' + p : p;
---

<BaseLayout title={meta.title} description={meta.description}>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://en.chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://en.chitek-inno.com/products" },
      { "@type": "ListItem", "position": 3, "name": "Advanced Static Var Generator" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Advanced Static Var Generator (ASVG) Series",
    "numberOfItems": 8,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Silicon Carbide MOSFET Advanced Static Var Generator SiC", "url": "https://en.chitek-inno.com/products-asvg/sic-ultra-asvg" },
      { "@type": "ListItem", "position": 2, "name": "208V/400V/480V Anti-Pollution Advanced Static Var Generator", "url": "https://en.chitek-inno.com/products-asvg/anti-pollution-asvg" },
      { "@type": "ListItem", "position": 3, "name": "690V/800V Anti-Pollution Advanced Static Var Generator", "url": "https://en.chitek-inno.com/products-asvg/anti-pollution-hv-asvg" },
      { "@type": "ListItem", "position": 4, "name": "Ultra-slim Advanced Static Var Generator", "url": "https://en.chitek-inno.com/products-asvg/ultra-slim-asvg" },
      { "@type": "ListItem", "position": 5, "name": "Distributed Advanced Static Var Generator", "url": "https://en.chitek-inno.com/products-asvg/distributed-asvg" },
      { "@type": "ListItem", "position": 6, "name": "IP65 SiC-Fanless Advanced Static Var Generator 25A", "url": "https://en.chitek-inno.com/products-asvg/ip65-sic-fanless-asvg" },
      { "@type": "ListItem", "position": 7, "name": "IP65 Advanced Static Var Generator", "url": "https://en.chitek-inno.com/products-asvg/ip65-asvg" },
      { "@type": "ListItem", "position": 8, "name": "IP65 SiC-Low Noise Fan Advanced Static Var Generator 50A", "url": "https://en.chitek-inno.com/products-asvg/sic-fanless-asvg" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How does an ASVG differ from a capacitor bank?", "acceptedAnswer": { "@type": "Answer", "text": "A capacitor bank switches in fixed steps, so its correction arrives after the load has already moved and it can resonate with the network. An ASVG reads the reactive demand continuously and injects exactly what is needed at that moment — specified for sites where the swings are sharp enough that coarse compensation arrives too late." } },
      { "@type": "Question", "name": "Can one ASVG follow a load that changes between shifts and within seconds?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Welding, motor starts, press lines and drive ramps change the reactive demand many times a second, and the unit tracks those changes cycle by cycle rather than in contactor steps. The same closed loop covers both the slow daily pattern and the fast swings." } },
      { "@type": "Question", "name": "Can ASVG units be combined for a higher capacity?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The range is modular — units parallel to cover a single wall-mounted module or a large plant rather than forcing everything through one oversized cabinet." } },
      { "@type": "Question", "name": "Can ASVG be installed outdoors or in harsh environments?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Besides indoor enclosures, the range includes IP65 models for outdoor and dusty sites, plus anti-pollution and fanless low-noise versions where dust, corrosion or acoustic noise is the constraint." } }
    ]
  }
  </script>
