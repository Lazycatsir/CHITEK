---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = {
  title: 'CHITEK — Advanced Static Var Generator (ASVG) | Power Factor Correction',
  description: 'CHITEK Advanced Static Var Generator (ASVG) delivers stepless reactive power compensation and power factor correction for low-voltage networks — wall-mounted, distributed and IP65 series.',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/en' + p : p;
---

<BaseLayout title={meta.title} description={meta.description}>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://en.chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://en.chitek-inno.com/products" },
      { "@type": "ListItem", "position": 3, "name": "Advanced Static Var Generator" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Advanced Static Var Generator (ASVG) Series",
    "numberOfItems": 8,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Silicon Carbide MOSFET Advanced Static Var Generator SiC ASVG", "url": "https://en.chitek-inno.com/products-asvg/sic-ultra-asvg" },
      { "@type": "ListItem", "position": 2, "name": "208V/400V/480V Anti-Pollution Advanced Static Var Generator ASVG", "url": "https://en.chitek-inno.com/products-asvg/anti-pollution-asvg" },
      { "@type": "ListItem", "position": 3, "name": "690V/800V Anti-Pollution Advanced Static Var Generator ASVG", "url": "https://en.chitek-inno.com/products-asvg/anti-pollution-hv-asvg" },
