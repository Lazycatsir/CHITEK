  <!-- Section nav scroll spy: highlight the tab of the section you are reading -->
  <script>
    (function () {
      var bar = document.querySelector('nav[data-secnavbar]');
      var links = Array.prototype.slice.call(document.querySelectorAll('.js-secnav'));
      if (!links.length && !bar) return;

      // 顶部栏：只有越过首屏（一屏高）才滑入；回到首屏内立即收起
      function syncBar() {
        if (!bar) return;
        bar.classList.toggle('is-shown', window.scrollY > window.innerHeight);
      }
      syncBar();

      // 从 DOM 顺序建立「链接 ↔ 分节」配对，缺元素的直接跳过
      var pairs = [];
      links.forEach(function (a) {
        var id = (a.getAttribute('href') || '').slice(1);
        var el = id ? document.getElementById(id) : null;
        if (el) pairs.push({ link: a, el: el });
      });
      if (!pairs.length) return;

      var NAV_H = 72;   // 固定顶栏高度
      var BUFFER = 120; // 判定线再往下留一点，避免刚好压线时来回跳
      var current = null;
      var ticking = false;

      function pick() {
        // 判定线以下的第一个分节不算；取「顶部已越过判定线」的最后一个分节
        var best = null;
        for (var i = 0; i < pairs.length; i++) {
          if (pairs[i].el.getBoundingClientRect().top - (NAV_H + BUFFER) <= 0) best = pairs[i];
          else break;
        }
        // 滚到页面底部时强制选中最后一节（末节常常永远到不了判定线）
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
          best = pairs[pairs.length - 1];
        }
        return best;
      }

      function render() {
        var best = pick();
        if (best === current) return;
        current = best;
        pairs.forEach(function (p) { p.link.classList.toggle('is-active', p === best); });
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          ticking = false;
          syncBar();
          render();
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      render();
    })();
  </script>

