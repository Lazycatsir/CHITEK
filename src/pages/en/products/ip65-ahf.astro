---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const meta = {
  title: 'IP65 Active Harmonic Filter | Active Harmonic Filter | CHITEK',
  description: 'CHITEK IP65 Active Harmonic Filter — IGBT active harmonic filter (AHF). THDi < 5% per IEEE 519, 208-690V, 8 A – 20 A per module (parallel expandable, unlimited).',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/en' + p : p;
---

<BaseLayout title={meta.title} description={meta.description} lang="en" alternates={false}>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Structured data: BreadcrumbList + Product -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://en.chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://en.chitek-inno.com/products" },
      { "@type": "ListItem", "position": 3, "name": "IP65 Active Harmonic Filter", "item": "https://en.chitek-inno.com/products/ip65-ahf" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "CHITEK IP65 Active Harmonic Filter",
    "brand": { "@type": "Brand", "name": "CHITEK INNOPOWER" },
    "description": "CHITEK IP65 Active Harmonic Filter (IGBT active harmonic filter (AHF)) delivering real-time harmonic cancellation, reactive compensation and load balancing with THDi held below 5% per IEEE 519 across a 208–690V, 8 A – 20 A per module (parallel expandable, unlimited) range.",
    "category": "Power Quality / Harmonic Mitigation",
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "Rated Voltage", "value": "208-690V" },
      { "@type": "PropertyValue", "name": "Rated Capacity", "value": "8 A – 20 A per module (parallel expandable, unlimited)" },
      { "@type": "PropertyValue", "name": "Frequency", "value": "50/60 Hz" },
      { "@type": "PropertyValue", "name": "Wiring", "value": "3P3W / 3P4W" },
      { "@type": "PropertyValue", "name": "Filtering Range", "value": "2nd-51st order harmonic" },
      { "@type": "PropertyValue", "name": "Full Response Time", "value": "< 5 ms" },
      { "@type": "PropertyValue", "name": "Switching Frequency", "value": "up to 20 kHz (IGBT)" },
      { "@type": "PropertyValue", "name": "Efficiency", "value": ">=98%" },
      { "@type": "PropertyValue", "name": "THDi", "value": "<5% (IEEE 519)" },
      { "@type": "PropertyValue", "name": "Topology", "value": "3-level NPC, IGBT" },
      { "@type": "PropertyValue", "name": "Standard", "value": "IEC 61000 / IEC 62477" },
      { "@type": "PropertyValue", "name": "Communication", "value": "MODBUS / optional Ethernet" }
    ]
  }
  </script>
    <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is an active harmonic filter (AHF)?", "acceptedAnswer": { "@type": "Answer", "text": "An active harmonic filter is a power-electronics device that measures the load current with an external CT, isolates the harmonic, reactive and imbalance components with a DSP, and injects an equal and opposite compensation current through an IGBT inverter bridge. The utility then sees a clean fundamental waveform." } },
      { "@type": "Question", "name": "How does the AHF work?", "acceptedAnswer": { "@type": "Answer", "text": "An external CT samples the load current; a DSP/FPGA runs an FFT to separate 2nd–51st order harmonics, reactive power and imbalance; the IGBT inverter bridge then injects an equal and opposite-phase compensation current. The result is THDi held below 5% per IEEE 519 at the point of common coupling." } },
      { "@type": "Question", "name": "What capacity and voltage range is available?", "acceptedAnswer": { "@type": "Answer", "text": "8 A – 20 A per module (parallel expandable, unlimited), 3P3W/3P4W, covering 208–690V. Modules parallel without a practical limit to reach 3000 A and beyond for large plants." } },
      { "@type": "Question", "name": "Can it also correct power factor and balance loads?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A selectable priority function covers harmonic mitigation, reactive compensation and three-phase balancing. In 3P4W mode it also cancels the accumulated 3rd-harmonic neutral current." } },
      { "@type": "Question", "name": "How is it installed and what protection rating does it have?", "acceptedAnswer": { "@type": "Answer", "text": "Installed as wall-mounted or rack / cabinet type; rated IP20, IP30, IP65 (customizable). The enclosure is built for the duty cycle of industrial switchrooms and can be customized for harsher or outdoor sites." } },
      { "@type": "Question", "name": "How do I confirm the right model for my site?", "acceptedAnswer": { "@type": "Answer", "text": "Send us the load’s harmonic spectrum, voltage class and installed nonlinear capacity. CHITEK supplies a selection matrix by voltage class, series and capacity, plus a sizing calculation on request." } }
    ]
  }
  </script>

