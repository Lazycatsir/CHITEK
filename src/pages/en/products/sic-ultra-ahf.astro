---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const meta = {
  title: 'SiC MOSFET Ultra AHF | Active Harmonic Filter | CHITEK',
  description: 'CHITEK SiC MOSFET Ultra Active Harmonic Filter (AHF) — silicon-carbide 3-level topology for higher efficiency, higher power density and lower thermal loss. THDi < 5% per IEEE 519, 208-690V, 50-200A per module.',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/en' + p : p;
---

<BaseLayout title={meta.title} description={meta.description} lang="en" alternates={false}>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Structured data: BreadcrumbList + Product -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://en.chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://en.chitek-inno.com/products" },
      { "@type": "ListItem", "position": 3, "name": "Silicon Carbide (SiC) MOSFET Ultra AHF", "item": "https://en.chitek-inno.com/products/sic-ultra-ahf" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "CHITEK SiC MOSFET Ultra Active Harmonic Filter",
    "brand": { "@type": "Brand", "name": "CHITEK INNOPOWER" },
    "description": "Silicon-carbide (SiC) MOSFET active harmonic filter with 3-level topology, delivering higher switching efficiency, higher power density and lower thermal loss than IGBT platforms, while holding THDi below 5% per IEEE 519.",
    "category": "Power Quality / Harmonic Mitigation",
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "Rated Voltage", "value": "208-690V" },
      { "@type": "PropertyValue", "name": "Rated Capacity", "value": "50A-200A per module, parallel expandable" },
      { "@type": "PropertyValue", "name": "Frequency", "value": "50/60 Hz" },
      { "@type": "PropertyValue", "name": "Wiring", "value": "3P3W / 3P4W" },
      { "@type": "PropertyValue", "name": "Filtering Range", "value": "2nd-51st order harmonic" },
      { "@type": "PropertyValue", "name": "Full Response Time", "value": "<50 us" },
      { "@type": "PropertyValue", "name": "Switching Frequency", "value": "up to 40 kHz (SiC)" },
      { "@type": "PropertyValue", "name": "Efficiency", "value": ">=98%" },
      { "@type": "PropertyValue", "name": "THDi", "value": "<5% (IEEE 519)" },
      { "@type": "PropertyValue", "name": "Topology", "value": "3-level NPC, SiC MOSFET" },
      { "@type": "PropertyValue", "name": "Standard", "value": "IEC 61000 / IEC 62477" },
      { "@type": "PropertyValue", "name": "Communication", "value": "MODBUS / optional Ethernet" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is a SiC MOSFET active harmonic filter?", "acceptedAnswer": { "@type": "Answer", "text": "A SiC MOSFET active harmonic filter replaces the conventional silicon IGBT bridge with silicon-carbide power devices. Because SiC switches faster with lower conduction and switching loss, the filter achieves higher efficiency, higher power density and lower heat rejection while still cancelling harmonics in real time and holding THDi below 5%." } },
      { "@type": "Question", "name": "Why choose silicon carbide (SiC) instead of IGBT?", "acceptedAnswer": { "@type": "Answer", "text": "SiC MOSFETs tolerate higher switching frequencies (up to 40 kHz), which shrinks magnetics, raises efficiency to 98% or more, and reduces thermal loss by roughly a third. Practically, that means a smaller cabinet for the same capacity, lower cooling demand and longer device life — ideal for space- and efficiency-critical installations." } },
      { "@type": "Question", "name": "How does the Ultra AHF work?", "acceptedAnswer": { "@type": "Answer", "text": "An external CT samples the load current; a DSP/FPGA runs an FFT to separate 2nd-51st order harmonics, reactive power and imbalance; the SiC inverter bridge then injects an equal and opposite-phase compensation current. The utility sees only the fundamental, with THDi below 5% and power factor corrected." } },
      { "@type": "Question", "name": "What is the rated capacity and voltage range?", "acceptedAnswer": { "@type": "Answer", "text": "The Ultra AHF covers 208-690V, 3P3W/3P4W, with 50A to 200A per module. Modules can be paralleled without a practical limit to reach 3000A and beyond for large plants." } },
      { "@type": "Question", "name": "Can it also correct power factor and balance loads?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The unit offers a selectable priority function covering harmonic mitigation, reactive power compensation and three-phase load balancing. In 3P4W mode it also cancels the accumulated 3rd-harmonic neutral current." } },
      { "@type": "Question", "name": "Which installations benefit most from the SiC Ultra AHF?", "acceptedAnswer": { "@type": "Answer", "text": "Data centres, semiconductor fabs, precision manufacturing and any site where switchroom space is scarce, cooling is expensive or downtime is costly. The higher power density lets you fit more compensation capacity in the same footprint." } }
    ]
  }
  </script>

  <!-- Breadcrumb (full width, above the sidebar so it is never overlapped) -->
  <nav class="bg-white border-b border-border-light mt-[72px]" aria-label="Breadcrumb">
    <div class="mx-auto max-w-7xl px-6 py-3 text-[clamp(12px,0.9vw,14px)] text-text-muted">
      <a href={lp('/')} class="hover:text-brand-orange transition-colors">Home</a>
      <span class="mx-2 text-border-light">/</span>
      <a href={lp('/products')} class="hover:text-brand-orange transition-colors">Products</a>
      <span class="mx-2 text-border-light">/</span>
      <span class="text-text-dark font-medium">SiC MOSFET Ultra AHF</span>
    </div>
  </nav>

  <!-- Left section navigation (desktop sticky sidebar) + content column -->
  <div class="lg:flex">
    <aside class="hidden lg:block lg:w-[140px] shrink-0 border-r border-border-light">
      <nav class="sticky top-[72px] max-h-[calc(100vh-72px)] overflow-y-auto py-8 px-2" aria-label="Section navigation">
        <p class="px-2 mb-3 text-[11px] font-semibold uppercase tracking-[0.15em] text-text-muted">PAGE GUIDE</p>
          <a href="#overview" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] leading-snug font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Overview</a>
          <a href="#description" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Product Description</a>
          <a href="#parameters" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Technical Parameters</a>
          <a href="#why" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Why CHITEK</a>
          <a href="#faq" class="js-secnav block px-2 py-2 mb-0.5 rounded-md text-[13px] font-medium text-text-muted border-l-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">FAQ</a>
      </nav>
    </aside>
    <div class="flex-1 min-w-0">

  <!-- Product top: description (left) + product image (right). No background image. -->
  <section id="overview" data-product-top class="bg-white pt-[clamp(28px,3vw,48px)] pb-[clamp(32px,3.5vw,56px)] scroll-mt-[72px]">
    <div class="max-w-none px-3 lg:pl-6 lg:pr-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-[clamp(24px,4vw,56px)] items-start">

        <!-- LEFT: title / meta / specs / advantages -->
        <div>
          <h1 class="text-[clamp(21px,2.1vw,32px)] font-bold leading-snug text-text-dark mb-6 font-barlow-condensed">SiC MOSFET Active Harmonic Filter Ultra AHF Series 3 Phase Power Quality Correction Device</h1>

          <p class="text-[clamp(14px,1.1vw,16px)] text-text-mid leading-relaxed mb-7">
            <strong class="text-text-dark font-bold">Tags</strong> SiC MOSFET AHF, active harmonic filter, active harmonic filter price, power factor correction device, power quality filter, ultra high efficiency AHF
          </p>

          <div class="text-[clamp(14px,1.1vw,16px)] text-text-mid leading-[1.9] mb-6">
            <p>Frequency: 50/60HZ</p>
            <p>Warranty: Standard 1 year/negotiable</p>
          </div>

          <!-- Configurator: checkable voltage / current / connection / installation -->
          <div class="mb-7 space-y-4">
            <div>
              <p class="text-[13px] font-semibold text-text-dark mb-2">Voltage</p>
              <div class="flex flex-wrap gap-2">
                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="v" data-val="208V" /> 208V</label>                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="v" data-val="400V" /> 400V</label>                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="v" data-val="480V" /> 480V</label>                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="v" data-val="690V" /> 690V</label>
              </div>
            </div>
            <div>
              <p class="text-[13px] font-semibold text-text-dark mb-2">Current</p>
              <div class="flex flex-wrap gap-2">
                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="a" data-val="50A" /> 50A</label>                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="a" data-val="75A" /> 75A</label>                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="a" data-val="100A" /> 100A</label>                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="a" data-val="150A" /> 150A</label>                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="a" data-val="200A" /> 200A</label>
              </div>
            </div>
            <div>
              <div class="flex flex-wrap items-start gap-x-8 gap-y-3">
                <div>
                  <p class="text-[13px] font-semibold text-text-dark mb-2">Connection</p>
                  <div class="flex flex-wrap gap-2">
                    <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="c" data-val="3P3W" /> 3P3W</label>                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="c" data-val="3P4W" /> 3P4W</label>
                  </div>
                </div>
                <div>
                  <p class="text-[13px] font-semibold text-text-dark mb-2">Installation</p>
                  <div class="flex flex-wrap gap-2">
                    <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="i" data-val="Wall" /> Wall</label>                <label class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[13px] text-text-mid cursor-pointer"><input type="checkbox" class="accent-[#ff6b1a]" data-group="i" data-val="Rack" /> Rack</label>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mb-1">
            <!-- SKU box / Quote and Download share ONE row: both sit at the same height, and the
                 formerly lone Download line no longer makes the left column overhang the image card. -->
            <div class="flex flex-col sm:flex-row sm:items-stretch gap-3">
              <!-- Quote button: submits to Netlify Forms exactly like the contact page Send Message,
                   and analytics.js binds it via [data-lead-form] to fire generate_lead. -->
              <form
                name="quote"
                method="POST"
                data-netlify="true"
                netlify-honeypot="bot-field"
                data-lead-form
                class="m-0 flex-1 min-w-0"
              >
                <input type="hidden" name="form-name" value="quote" />
                <div data-utm-fields hidden></div>
                <div hidden aria-hidden="true">
                  <label>Don't fill this out <input name="bot-field" /></label>
                </div>
                <div class="relative h-full">
                  <textarea data-inquiry-summary name="message" readonly rows="2" class="block w-full h-full rounded-lg border border-border-light bg-[#fafbfc] py-1.5 px-3 pr-[110px] text-[13px] leading-tight text-text-mid resize-none"></textarea>
                  <button type="submit" class="absolute right-0 top-0 bottom-0 inline-flex items-center justify-center bg-brand-orange hover:bg-brand-orange-dark text-white font-semibold rounded-r-lg px-5 text-[12px] transition-colors whitespace-nowrap cursor-pointer">Quote</button>
                </div>
              </form>
              <!-- Download stays OUTSIDE the form so the post-submit form.reset() can't touch it -->
              <button type="button" data-download-config class="shrink-0 inline-flex items-center justify-center bg-brand-orange hover:bg-brand-orange-dark text-white font-semibold rounded-lg px-7 py-2 text-[clamp(14px,1.1vw,16px)] transition-colors whitespace-nowrap">Download</button>
            </div>
            <!-- Success message: picked up natively by analytics.js showSuccess()
                 (same [data-form-success] contract and copy as the contact page) -->
            <div data-form-success data-no-reset hidden class="mt-3 p-4 rounded-lg bg-[#e8f5e9] border border-[#c8e6c9]">
              <p class="text-[13px] font-semibold text-[#2e7d32] mb-0.5">Thank you! Our application engineer will contact you within 24 hours.</p>
              <p class="text-[11px] text-[#558b2f]">CHITEK INNOPOWER</p>
            </div>
            </div>
        </div>

        <!-- RIGHT: 3-image carousel + thumbnails, capped to the left column height -->
        <div data-gallery class="rounded-2xl border border-border-light bg-[#fafbfc] p-6 flex flex-col items-center">
          <div class="w-full flex items-center justify-center overflow-hidden">
            <img data-gallery-main src="/assets/images/index-product-ahf.webp" alt="CHITEK SiC MOSFET Ultra Active Harmonic Filter module" class="w-auto h-auto max-w-full max-h-[400px] object-contain" loading="eager" />
          </div>
          <div class="mt-4 grid grid-cols-3 gap-3 w-full shrink-0">
            <button type="button" data-gallery-thumb data-src="/assets/images/index-product-ahf.webp" data-alt="CHITEK SiC MOSFET Ultra Active Harmonic Filter module" class="gallery-thumb is-active overflow-hidden rounded-lg border border-border-light bg-white p-1">
              <img src="/assets/images/index-product-ahf.webp" alt="Ultra AHF front view" class="w-full h-[72px] object-contain" loading="lazy" />
            </button>
            <button type="button" data-gallery-thumb data-src="/assets/images/index-product-svg.webp" data-alt="CHITEK Static Var Generator SVG module" class="gallery-thumb overflow-hidden rounded-lg border border-border-light bg-white p-1">
              <img src="/assets/images/index-product-svg.webp" alt="SVG module view" class="w-full h-[72px] object-contain" loading="lazy" />
            </button>
            <button type="button" data-gallery-thumb data-src="/assets/images/index-product-avr.webp" data-alt="CHITEK Automatic Voltage Regulator AVR module" class="gallery-thumb overflow-hidden rounded-lg border border-border-light bg-white p-1">
              <img src="/assets/images/index-product-avr.webp" alt="AVR module view" class="w-full h-[72px] object-contain" loading="lazy" />
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Sticky section sub-navigation (mobile only) -->
  <nav class="lg:hidden sticky top-[72px] z-[999] bg-white/95 backdrop-blur border-b border-border-light" aria-label="Section navigation">
    <div class="max-w-none px-3 lg:pl-6 lg:pr-10">
      <div class="flex gap-1 overflow-x-auto">
        <a href="#overview" class="whitespace-nowrap px-3.5 py-3 text-[13px] font-medium text-text-muted border-b-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Overview</a>
        <a href="#description" class="whitespace-nowrap px-3.5 py-3 text-[13px] font-medium text-text-muted border-b-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Product Description</a>
        <a href="#parameters" class="whitespace-nowrap px-3.5 py-3 text-[13px] font-medium text-text-muted border-b-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Technical Parameters</a>
        <a href="#why" class="whitespace-nowrap px-3.5 py-3 text-[13px] font-medium text-text-muted border-b-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">Why CHITEK</a>
        <a href="#faq" class="whitespace-nowrap px-3.5 py-3 text-[13px] font-medium text-text-muted border-b-2 border-transparent hover:text-brand-orange hover:border-brand-orange transition-colors">FAQ</a>
      </div>
    </div>
  </nav>

  <!-- 00 Product Description (moved above Technical Parameters) -->
  <section id="description" class="bg-white pt-[clamp(28px,3vw,48px)] pb-[clamp(40px,4vw,72px)] scroll-mt-[120px]">
    <div class="max-w-none px-3 lg:pl-6 lg:pr-10">
      <h2 class="text-[clamp(24px,2.5vw,44px)] font-bold text-text-dark mb-6 font-barlow-condensed text-left">Product Description</h2>
      <div class="max-w-none lg:pr-[clamp(40px,8vw,160px)] mb-10 space-y-4 text-text-mid text-[clamp(13.5px,1.05vw,15.5px)] leading-relaxed">
        <p>Lower harmonic levels on a CHITEK Active Harmonic Filter translate directly into a more dependable electrical network and lower running costs. By removing the harmonic currents that cause extra heating, the filter helps eliminate the nuisance tripping of protective devices and the unexplained fuse failures that plant teams often spend weeks tracing.</p>
        <p>Because harmonic heating is kept in check, motors, transformers, switchgear and cables run cooler, so their service life is extended and maintenance schedules become lighter. On new-build projects, engineers can also revisit the practice of oversizing distribution equipment purely as a defence against harmonics — a smaller, better-utilised design is usually enough.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="rounded-2xl border border-border-light p-6">
          <h3 class="text-brand-orange font-semibold mb-2 text-[clamp(15px,1.1vw,18px)]">Graphical HMI</h3>
          <p class="text-text-mid text-[clamp(13px,1vw,15px)] leading-relaxed">Direct control, configuration, monitoring and harmonic analysis from the front panel — no PC required.</p>
        </div>
        <div class="rounded-2xl border border-border-light p-6">
          <h3 class="text-brand-orange font-semibold mb-2 text-[clamp(15px,1.1vw,18px)]">Comprehensive Measurements</h3>
          <p class="text-text-mid text-[clamp(13px,1vw,15px)] leading-relaxed">RMS voltages and currents, THDu/THDi, system frequency, load factor, compensated current, PF before/after and 2nd–50th order spectrum.</p>
        </div>
        <div class="rounded-2xl border border-border-light p-6">
          <h3 class="text-brand-orange font-semibold mb-2 text-[clamp(15px,1.1vw,18px)]">Power Factor Correction</h3>
          <p class="text-text-mid text-[clamp(13px,1vw,15px)] leading-relaxed">Dynamic correction for both lagging and leading power factor without capacitor-step switching.</p>
        </div>
        <div class="rounded-2xl border border-border-light p-6">
          <h3 class="text-brand-orange font-semibold mb-2 text-[clamp(15px,1.1vw,18px)]">Load Balancing</h3>
          <p class="text-text-mid text-[clamp(13px,1vw,15px)] leading-relaxed">Balances three-phase systems and relieves neutral current in 3P4W networks.</p>
        </div>
        <div class="rounded-2xl border border-border-light p-6">
          <h3 class="text-brand-orange font-semibold mb-2 text-[clamp(15px,1.1vw,18px)]">Low Thermal Loss</h3>
          <p class="text-text-mid text-[clamp(13px,1vw,15px)] leading-relaxed">SiC switching keeps losses under 1.8% of rated kVA and efficiency at 98% or better, cutting cooling demand.</p>
        </div>
        <div class="rounded-2xl border border-border-light p-6">
          <h3 class="text-brand-orange font-semibold mb-2 text-[clamp(15px,1.1vw,18px)]">Flexible &amp; Modular</h3>
          <p class="text-text-mid text-[clamp(13px,1vw,15px)] leading-relaxed">Modular design embedded in standard or customized cabinets, with parallel expansion and factory ODM support.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 Technical Parameters -->
  <section id="parameters" class="bg-[#fafbfc] pt-[clamp(28px,3vw,48px)] pb-[clamp(40px,4vw,72px)] scroll-mt-[120px]">
    <div class="max-w-none px-3 lg:pl-6 lg:pr-[clamp(40px,8vw,160px)]">
      <h2 class="text-[clamp(24px,2.5vw,44px)] font-bold text-text-dark mb-8 font-barlow-condensed text-left">Technical Parameters</h2>
      <div class="overflow-x-auto rounded-2xl border border-border-light bg-white">
        <table class="w-full border-collapse text-[clamp(12px,0.9vw,13.5px)] leading-tight text-left">
          <tbody>
            <tr class="border-b border-border-light"><th class="text-left py-1.5 px-4 pr-10 bg-[#fafbfc] font-semibold text-text-dark w-1/6">Rated Voltage</th><td class="py-1.5 px-4 pr-10 text-text-mid whitespace-nowrap">208–690 V</td></tr>
            <tr class="border-b border-border-light"><th class="text-left py-1.5 px-4 pr-10 bg-[#fafbfc] font-semibold text-text-dark">Rated Capacity</th><td class="py-1.5 px-4 pr-10 text-text-mid whitespace-nowrap">50 A – 200 A per module (parallel expandable, unlimited)</td></tr>
            <tr class="border-b border-border-light"><th class="text-left py-1.5 px-4 pr-10 bg-[#fafbfc] font-semibold text-text-dark">Frequency</th><td class="py-1.5 px-4 pr-10 text-text-mid whitespace-nowrap">50 / 60 Hz</td></tr>
            <tr class="border-b border-border-light"><th class="text-left py-1.5 px-4 pr-10 bg-[#fafbfc] font-semibold text-text-dark">Wiring Mode</th><td class="py-1.5 px-4 pr-10 text-text-mid whitespace-nowrap">3P3W / 3P4W</td></tr>
            <tr class="border-b border-border-light"><th class="text-left py-1.5 px-4 pr-10 bg-[#fafbfc] font-semibold text-text-dark">Filtering Range</th><td class="py-1.5 px-4 pr-10 text-text-mid whitespace-nowrap">2nd – 51st order harmonic</td></tr>
            <tr class="border-b border-border-light"><th class="text-left py-1.5 px-4 pr-10 bg-[#fafbfc] font-semibold text-text-dark">Function</th><td class="py-1.5 px-4 pr-10 text-text-mid whitespace-nowrap">Harmonic mitigation, reactive compensation, imbalance phase balancing</td></tr>
