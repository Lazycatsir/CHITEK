---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AHF_SKU, skuTail, skuPrice, skuPartNo } from '../../../data/ahfSku.js';

// Default configuration shown before any chip is picked (mirrors DEFAULT_CFG in the summary script).
const skuTable = AHF_SKU['ultra-slim-ahf'];
const skuDefRow = skuTable.rows[skuTable.defaultCurrent];
const skuDefNo = skuPartNo(skuTable, skuTable.defaultCurrent, '400V', 'Rack', 'IP20');
const skuDefLine = 'SKU: ' + skuDefNo + ' · ' + skuTail(skuDefRow);
const skuDefPrice = skuPrice(skuDefRow);

const meta = {
  title: 'Ultra-slim Active Harmonic Filter AHF | Active Harmonic Filter | CHITEK',
  description: 'CHITEK Ultra-slim Active Harmonic Filter AHF — IGBT active harmonic filter (AHF). THDi < 5% per IEEE 519, 400VAC, 208V, 480V, 8A/15A/20A modules.',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/en' + p : p;
---

<BaseLayout title={meta.title} description={meta.description} lang="en" alternates={false}>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Structured data: BreadcrumbList + Product -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://en.chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://en.chitek-inno.com/products" },
      { "@type": "ListItem", "position": 3, "name": "Ultra-slim Active Harmonic Filter AHF", "item": "https://en.chitek-inno.com/products/ultra-slim-ahf" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "CHITEK Ultra-slim Active Harmonic Filter AHF",
    "brand": { "@type": "Brand", "name": "CHITEK INNOPOWER" },
    "description": "CHITEK Ultra-slim Active Harmonic Filter AHF (IGBT active harmonic filter (AHF)) delivering real-time harmonic cancellation, reactive compensation and load balancing with THDi held below 5% per IEEE 519 across a 400VAC, 208V, 480V, 8A/15A/20A module range.",
    "category": "Power Quality / Harmonic Mitigation",
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "Rated Voltage", "value": "400VAC, 208V, 480V" },
      { "@type": "PropertyValue", "name": "Rated Capacity", "value": "8A, 15A, 20A" },
      { "@type": "PropertyValue", "name": "Frequency", "value": "50/60 Hz" },
      { "@type": "PropertyValue", "name": "Wiring", "value": "3P3W / 3P4W" },
      { "@type": "PropertyValue", "name": "Filtering Range", "value": "2nd-51st order harmonic" },
      { "@type": "PropertyValue", "name": "Full Response Time", "value": "< 5 ms" },
      { "@type": "PropertyValue", "name": "Switching Frequency", "value": "up to 20 kHz (IGBT)" },
      { "@type": "PropertyValue", "name": "Efficiency", "value": ">=98%" },
      { "@type": "PropertyValue", "name": "THDi", "value": "<5% (IEEE 519)" },
      { "@type": "PropertyValue", "name": "Topology", "value": "3-level NPC, IGBT" },
      { "@type": "PropertyValue", "name": "Standard", "value": "IEC 61000 / IEC 62477" },
      { "@type": "PropertyValue", "name": "Communication", "value": "MODBUS / optional Ethernet" }
    ]
  }
  </script>
    <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is an active harmonic filter (AHF)?", "acceptedAnswer": { "@type": "Answer", "text": "An active harmonic filter is a power-electronics device that measures the load current with an external CT, isolates the harmonic, reactive and imbalance components with a DSP, and injects an equal and opposite compensation current through an IGBT inverter bridge. The utility then sees a clean fundamental waveform." } },
      { "@type": "Question", "name": "How does the AHF work?", "acceptedAnswer": { "@type": "Answer", "text": "An external CT samples the load current; a DSP/FPGA runs an FFT to separate 2nd–51st order harmonics, reactive power and imbalance; the IGBT inverter bridge then injects an equal and opposite-phase compensation current. The result is THDi held below 5% per IEEE 519 at the point of common coupling." } },
      { "@type": "Question", "name": "What capacity and voltage range is available?", "acceptedAnswer": { "@type": "Answer", "text": "8A, 15A and 20A modules, 3P3W/3P4W, rated 400VAC, 208V and 480V. Modules parallel without a practical limit to reach 3000 A and beyond for large plants." } },
      { "@type": "Question", "name": "Can it also correct power factor and balance loads?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A selectable priority function covers harmonic mitigation, reactive compensation and three-phase balancing. In 3P4W mode it also cancels the accumulated 3rd-harmonic neutral current." } },
      { "@type": "Question", "name": "How is it installed and what protection rating does it have?", "acceptedAnswer": { "@type": "Answer", "text": "Installed as wall-mounted or rack / cabinet type; rated IP20, IP30, IP40 (customizable). The enclosure is built for the duty cycle of industrial switchrooms and can be customized for harsher or outdoor sites." } },
      { "@type": "Question", "name": "How do I confirm the right model for my site?", "acceptedAnswer": { "@type": "Answer", "text": "Send us the load’s harmonic spectrum, voltage class and installed nonlinear capacity. CHITEK supplies a selection matrix by voltage class, series and capacity, plus a sizing calculation on request." } }
    ]
  }
  </script>

  <!-- Breadcrumb (full width, above the sidebar so it is never overlapped) -->
  <nav class="bg-white border-b border-border-light mt-[72px]" aria-label="Breadcrumb">
    <div class="max-w-none px-9 lg:px-[110px] py-3 text-[clamp(12px,1.1vw,16px)] text-text-muted">
      <a href={lp('/')} class="hover:text-brand-orange transition-colors">Home</a>
      <span class="mx-2 text-border-light">/</span>
      <a href={lp('/products')} class="hover:text-brand-orange transition-colors">Products</a>
      <span class="mx-2 text-border-light">/</span>
      <span class="text-text-dark font-medium">Ultra-slim Active Harmonic Filter AHF</span>
    </div>
  </nav>

  <!-- Section navigation: horizontal bar, slides in under the fixed header only after the first screen -->
  <nav data-secnavbar class="fixed left-0 right-0 top-[72px] z-[999] bg-white/95 backdrop-blur border-b border-border-light" aria-label="Section navigation">
    <div class="max-w-none px-9 lg:px-[110px]">
      <div class="flex gap-1 overflow-x-auto" data-secnav-track>
        <a href="#overview" class="js-secnav whitespace-nowrap px-3.5 py-3 text-[15px] font-medium text-[#333333] border-b-2 border-transparent hover:text-[#ea511e] hover:border-[#ea511e] transition-colors">Overview</a>
        <a href="#description" class="js-secnav whitespace-nowrap px-3.5 py-3 text-[15px] font-medium text-[#333333] border-b-2 border-transparent hover:text-[#ea511e] hover:border-[#ea511e] transition-colors">Description</a>
        <a href="#parameters" class="js-secnav whitespace-nowrap px-3.5 py-3 text-[15px] font-medium text-[#333333] border-b-2 border-transparent hover:text-[#ea511e] hover:border-[#ea511e] transition-colors">Parameters</a>
        <a href="#why" class="js-secnav whitespace-nowrap px-3.5 py-3 text-[15px] font-medium text-[#333333] border-b-2 border-transparent hover:text-[#ea511e] hover:border-[#ea511e] transition-colors">Advantages</a>
        <a href="#manufacturing" class="js-secnav whitespace-nowrap px-3.5 py-3 text-[15px] font-medium text-[#333333] border-b-2 border-transparent hover:text-[#ea511e] hover:border-[#ea511e] transition-colors">Manufacturing</a>
        <a href="#faq" class="js-secnav whitespace-nowrap px-3.5 py-3 text-[15px] font-medium text-[#333333] border-b-2 border-transparent hover:text-[#ea511e] hover:border-[#ea511e] transition-colors">FAQ</a>
        <a href="#application" class="js-secnav whitespace-nowrap px-3.5 py-3 text-[15px] font-medium text-[#333333] border-b-2 border-transparent hover:text-[#ea511e] hover:border-[#ea511e] transition-colors">Application</a>
      </div>
    </div>
  </nav>

  <div>

  <!-- Product top: description (left) + product image (right). No background image. -->
  <section id="overview" data-product-top class="bg-white pt-[clamp(14px,1.5vw,24px)] pb-[clamp(32px,3.5vw,56px)] scroll-mt-[72px]">
    <div class="max-w-none px-9 lg:px-[110px]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-[clamp(24px,4vw,56px)] items-start">

        <!-- LEFT: title / meta / specs / advantages -->
        <div>
          <h1 class="text-[22px] font-bold leading-[30px] sm:text-[28px] sm:leading-[40px] text-[#333333] mb-2.5 sm:mb-5 font-barlow-condensed">Ultra-slim Active Harmonic Filter AHF — Compact 1U Power Quality Series</h1>

          <p class="text-[clamp(12px,1.05vw,15px)] text-text-mid leading-[1.5] sm:leading-[1.7] mb-2.5 sm:mb-5 lowercase">
            <strong class="text-[#333333] font-bold normal-case">Tags</strong>
            <a href={lp('/')} class="text-[13px] text-[#0075a3] hover:underline">Ultra-Slim AHF</a>,
            <a href={lp('/')} class="text-[13px] text-[#0075a3] hover:underline">slim active power filter APF</a>,
            <a href={lp('/')} class="text-[13px] text-[#0075a3] hover:underline">compact 1U AHF module</a>,
            <a href={lp('/')} class="text-[13px] text-[#0075a3] hover:underline">low-profile harmonic filter</a>,
            <a href={lp('/')} class="text-[13px] text-[#0075a3] hover:underline">space-saving active harmonic filter</a>,
            <a href={lp('/')} class="text-[13px] text-[#0075a3] hover:underline">slimline ADF</a>
          </p>

          <div class="text-[14px] font-normal text-[#333333] leading-[1.5] sm:leading-[1.9] mb-3 sm:mb-5">
            <p><strong class="text-[#333333] font-bold">Function:</strong> Harmonic Mitigation, Reactive Compensation, Imbalance Phase Balancing</p>
            <p><strong class="text-[#333333] font-bold">Rated Voltage:</strong> 208/400/480 VAC</p>
            <p><strong class="text-[#333333] font-bold">Power Capacity:</strong> 8/15/20A single module (Max. 16 modules parallel)</p>
            <p><strong class="text-[#333333] font-bold">Efficiency:</strong> ≥ 97%</p>
            <p><strong class="text-[#333333] font-bold">Filter Performance:</strong> up to 97%</p>
            <p><strong class="text-[#333333] font-bold">Nominal Frequency:</strong> 50/60HZ</p>
            <p><strong class="text-[#333333] font-bold">Connection Type:</strong> 3 Phase 3 Wire / 3 Phase 4 Wire</p>
            <p><strong class="text-[#333333] font-bold">Installation:</strong> Wall mounted/Rack mounted/Cabinet</p>
            <p><strong class="text-[#333333] font-bold">Warranty:</strong> Standard 2 years/negotiable</p>
          </div>

          <!-- Configurator: SKU selector card (header / labelled chips / summary bar) -->
          <div class="mt-[16px] sm:mt-[clamp(14px,1.4vw,22px)] rounded-2xl border border-border-light bg-white overflow-hidden">
            <div class="flex flex-wrap items-center justify-between gap-3 px-4 sm:px-5 pt-4 sm:pt-3.5 pb-1">
              <p class="m-0 text-[13px] sm:text-[14px] font-bold tracking-[0.08em] text-[#333333]">Configure your sku</p>
            </div>
            <p class="m-0 px-4 sm:px-5 pb-3 sm:pb-2.5 text-[12px] sm:text-[14px] leading-tight sm:leading-snug text-[#626469] line-clamp-2 sm:line-clamp-none">Pick voltage, protection rate, capacity, wiring and installation &mdash; the selector fills in the matching part number.</p>

            <div class="px-4 sm:px-5 pb-4 space-y-2.5 sm:space-y-3">
                              <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2 sm:gap-y-3">
                <div>
                  <p class="text-[12px] sm:text-[14px] font-semibold tracking-[0.06em] sm:tracking-[0.08em] text-[#626469] mb-1 sm:mb-1.5">Rated voltage</p>
                  <div class="flex flex-wrap gap-1.5 sm:gap-2">
                    <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="v" data-val="208V" /> 208V</label>
                    <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="v" data-val="400V" /> 400V</label>
                    <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="v" data-val="480V" /> 480V</label>
                  </div>
                </div>
                <div>
                  <p class="text-[12px] sm:text-[14px] font-semibold tracking-[0.06em] sm:tracking-[0.08em] text-[#626469] mb-1 sm:mb-1.5">Protection rate</p>
                  <div class="flex flex-wrap gap-1.5 sm:gap-2">
                    <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="p" data-val="IP20" /> IP20</label>
                    <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="p" data-val="IP65" /> IP65</label>
                    <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="p" data-val="other" /> other</label>
                  </div>
                </div>
              </div>
              <div>
                <p class="text-[12px] sm:text-[14px] font-semibold tracking-[0.06em] sm:tracking-[0.08em] text-[#626469] mb-1 sm:mb-1.5">Power capacity</p>
                <div class="flex flex-wrap gap-1.5 sm:gap-2">
                  <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="a" data-val="8A" /> 8A</label>
                  <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="a" data-val="15A" /> 15A</label>
                  <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="a" data-val="20A" /> 20A</label><label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="a" data-val="Unlimited" /> Max. 16 modules parallel</label>
                </div>
              </div>
              <div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2 sm:gap-y-3">
                  <div>
                    <p class="text-[12px] sm:text-[14px] font-semibold tracking-[0.06em] sm:tracking-[0.08em] text-[#626469] mb-1 sm:mb-1.5">Wiring</p>
                    <div class="flex flex-wrap gap-1.5 sm:gap-2">
                      <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="c" data-val="3P3W" /> 3P3W</label>                <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="c" data-val="3P4W" /> 3P4W</label>
                    </div>
                  </div>
                  <div>
                    <p class="text-[12px] sm:text-[14px] font-semibold tracking-[0.06em] sm:tracking-[0.08em] text-[#626469] mb-1 sm:mb-1.5">Installation</p>
                    <div class="flex flex-wrap gap-1.5 sm:gap-2">
                      <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="i" data-val="Wall" /> Wall</label>                <label class="inline-flex items-center rounded-md border border-border-light bg-white px-2.5 py-1.5 text-[12px] sm:px-3.5 sm:py-2.5 sm:text-[14px] font-medium text-[#626469] cursor-pointer transition-colors hover:border-brand-orange has-[:checked]:border-brand-orange has-[:checked]:bg-brand-orange has-[:checked]:text-white"><input type="checkbox" class="sr-only" data-group="i" data-val="Rack" /> Rack</label>
                    </div>
                  </div>
                </div>
              </div>
          
            </div>

            <!-- Summary bar: live SKU line + price + WhatsApp CTA (no email form; the CTA opens WhatsApp with the selected SKU pre-filled) -->
            <div class="border-t border-border-light bg-white px-4 sm:px-5 py-2.5">
              <div class="flex flex-wrap items-center gap-3">
                <p data-summary-view class="m-0 flex-1 min-w-0 sm:w-full sm:flex-none text-[12px] sm:text-[14px] lg:text-[clamp(11px,0.88vw,14px)] leading-snug text-[#626469]">{skuDefLine}</p>
                <div class="flex flex-wrap items-stretch gap-2 sm:ml-auto">
                  <p data-summary-price class="m-0 flex items-center font-bold text-[18px] lg:text-[24px] leading-none text-[#333333] whitespace-nowrap">{skuDefPrice}</p>
                  <a data-wa-link href="https://wa.me/8618818994346" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-[#ea511e] hover:bg-[#ea511e] text-white font-semibold rounded-lg px-4 py-2.5 text-[13px] lg:px-5 lg:text-[14px] transition-colors whitespace-nowrap cursor-pointer no-underline">Inquire now &rarr;</a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT column: the two 360 turntables (rack-mount + 1U wall-mount),
             then the resources card -->
        <div>
          <div data-gallery class="rounded-2xl border border-border-light bg-[#fafbfc] px-6 pb-6 pt-2 flex flex-col items-center">
            <div class="relative w-full flex items-center justify-center overflow-hidden">
              <!-- Interactive 360 view, shown by default. Two frame sets are mounted and
                   the thumbnail below decides which one the viewer walks.
                   Set 1: 18 turntable steps x 9 tilt rows, exported from KeyShot at
                   1600x872 and converted to webp under /assets/spin/ultra-slim-ahf/.
                   This export is wide and flat, so it needs the cover crop plus a 1.28x
                   push (see the stylesheet below).
                   Set 2 (2026-10-26): the 1U wall-mount version without the HMI screen,
                   pre-cropped by _spin_import.py to the box ratio under
                   /assets/spin/ultra-slim-ahf-1u/ - no crop, no push.
                   Clicking the image (or the corner button) pins this very viewer to the
                   full viewport - the drag logic is untouched, so it keeps rotating. -->
              <div data-spin-viewer data-spin-base="/assets/spin/ultra-slim-ahf/" class="spin360" role="group" aria-label="CHITEK Ultra-slim Active Harmonic Filter AHF 360 degree view - drag, swipe or use the arrow keys to rotate" tabindex="0">
                <img data-spin-frame src="/assets/spin/ultra-slim-ahf/5_6.webp" width="1600" height="872" alt="CHITEK Ultra-slim Active Harmonic Filter AHF, 360 degree rotating view" class="pointer-events-none select-none" loading="eager" decoding="async" draggable="false" />
                <p class="spin-hint">Drag to rotate 360&deg;</p>
                <p class="spin-tip" aria-hidden="true">Drag to rotate 360&deg; &middot; Esc or &times; to close</p>
                <button type="button" data-spin-close class="spin-close" aria-label="Close the enlarged 360 view">&times;</button>
              </div>
              <!-- Both gallery slots are turntables now, so the card no longer needs a
                   static reference photo behind them - the viewer is always mounted. -->
              <button type="button" data-spin-expand class="spin-expand" aria-expanded="false" aria-label="Enlarge the 360 degree view" title="Enlarge">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3h6v6" /><path d="M9 21H3v-6" /><path d="M21 3l-7 7" /><path d="M3 21l7-7" /></svg>
              </button>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-3 w-full shrink-0">
              <!-- Two independent turntables. Each thumb owns a frame set, so picking a
                   thumb swaps the sequence the viewer walks - never the single picture.
                   Set 1 needs the cover crop + 1.28x push of the 1600x872 export; set 2
