        if (!dir) return;
        for (var k = 1; k <= 2; k++) {
          var uu = mod(u + dir * k, U);
          var key = v + '_' + uu;
          if (warmed[key]) continue;
          warmed[key] = 1;
          var im = new Image();
          im.src = file(v, uu);
        }
      }

      function hintOff() { viewer.classList.add('has-rotated'); }

      // --- switch frame set (second thumbnail) -------------------------------
      // The set has its own start frame, its own pixel size and its own crop, so
      // the swap resets the walk, the warm cache and the CSS branch in one go.
      // 'is-native' drops the legacy 1.28x push (see the stylesheet above).
      document.addEventListener('spin:frameset', function (ev) {
        var d = (ev && ev.detail) || {};
        if (!d.base) return;
        BASE = d.base;
        u = d.u;
        v = d.v;
        shown = '';
        pending = null;
        warmed = {};
        if (d.alt) img.alt = d.alt;
        if (d.w) img.width = d.w;
        if (d.h) img.height = d.h;
        viewer.classList.toggle('is-native', !!d.native);
        img.src = file(v, u);
        shown = v + '_' + u;
        // this is a different object to explore, so the drag hint earns its place again
        viewer.classList.remove('has-rotated');
        // preload the ring the visitor lands on
        for (var i = 0; i < U; i++) {
          if (i === u) continue;
          warmed[v + '_' + i] = 1;
          (new Image()).src = file(v, i);
        }
      });

      if (expandBtn) {
        expandBtn.addEventListener('click', function (e) {
          e.preventDefault();
          openZoom();
        });
      }
      if (closeBtn) {
        closeBtn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          closeZoom();
        });
      }
      // clicking the picture opens the enlargement; a drag that moved the turntable
      // is not a click, so it must not close it again.
      viewer.addEventListener('click', function (e) {
        if (closeBtn && e.target === closeBtn) return;
        if (zoomed) {
          if (!dragged) closeZoom();
        } else {
          openZoom();
        }
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && zoomed) {
          closeZoom();
          e.preventDefault();
        }
      });

      viewer.addEventListener('pointerdown', function (e) {
        if (e.button && e.button !== 0) return;
        if (closeBtn && e.target === closeBtn) return;
        dragging = true;
        dragged = false;
        lastX = e.clientX;
        lastY = e.clientY;
        viewer.classList.add('is-dragging');
        if (viewer.setPointerCapture) {
          try { viewer.setPointerCapture(e.pointerId); } catch (err) {}
        }
        if (e.preventDefault) e.preventDefault();
      });

      viewer.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        var w = viewer.clientWidth || 800;
        var h = viewer.clientHeight || 436;
        var moved = false, dir = 0;

        var stepX = Math.max(10, w / U);
        var nx = Math.round((e.clientX - lastX) / stepX);
        if (nx) {
          u = mod(u - nx, U);
          lastX += nx * stepX;
          dir = nx > 0 ? -1 : 1;
          moved = true;
        }

        var stepY = Math.max(12, h / 12);
        var ny = Math.round((e.clientY - lastY) / stepY);
        if (ny) {
          var nv = Math.min(V_MAX, Math.max(V_MIN, v + ny));
          if (nv !== v) { v = nv; dir = 0; moved = true; }
          lastY = e.clientY;
        }

        if (moved) { dragged = true; draw(); warm(dir); hintOff(); }
      });

      function stop(e) {
        if (!dragging) return;
        dragging = false;
        viewer.classList.remove('is-dragging');
        if (e && e.pointerId != null && viewer.releasePointerCapture) {
          try { viewer.releasePointerCapture(e.pointerId); } catch (err) {}
        }
      }
      viewer.addEventListener('pointerup', stop);
      viewer.addEventListener('pointercancel', stop);
      viewer.addEventListener('dragstart', function (e) { e.preventDefault(); });

      viewer.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
          var dir = e.key === 'ArrowRight' ? 1 : -1;
          u = mod(u + dir, U);
          draw(); warm(dir); hintOff();
          e.preventDefault();
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
          var nv = Math.min(V_MAX, Math.max(V_MIN, v + (e.key === 'ArrowDown' ? 1 : -1)));
          if (nv !== v) { v = nv; draw(); hintOff(); }
          e.preventDefault();
        }
      });

      // Warm the starting turntable ring while the browser is idle so the very
      // first drag is smooth (18 frames, roughly 200 KB).
      var idle = window.requestIdleCallback || function (f) { setTimeout(f, 900); };
      idle(function () {
        for (var i = 0; i < U; i++) {
          if (i === u) continue;
          var key = v + '_' + i;
          if (warmed[key]) continue;
          warmed[key] = 1;
          var im = new Image();
          im.src = file(v, i);
        }
      });
    })();
  </script>

  <!-- Related products: 4-up carousel (9 slides = the same 9 products as the /products grid) -->
  <script is:inline>
    (function () {
      var track = document.querySelector('[data-rel-track]');
      var vp = document.querySelector('[data-rel-viewport]');
      var prev = document.querySelector('[data-rel-prev]');
      var next = document.querySelector('[data-rel-next]');
      if (!track || !vp || !prev || !next) return;
      var cards = Array.prototype.slice.call(track.querySelectorAll('.rel-card'));
      var i = 0;

      function step() {
        if (cards.length < 2) return cards[0].getBoundingClientRect().width;
        return cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left;
      }
      // how many cards are fully visible right now: 1 on phones, 4 on desktop
      function visibleCount() {
        if (cards.length < 2) return 1;
        var s = step();
        if (s <= 0) return 1;
        var a = cards[0].getBoundingClientRect();
        var b = cards[1].getBoundingClientRect();
        var gap = Math.max(0, b.left - a.right);
        return Math.max(1, Math.round((vp.getBoundingClientRect().width + gap) / s));
      }
      function maxIndex() { return Math.max(0, cards.length - visibleCount()); }
      function go() {
        if (i > maxIndex()) i = maxIndex();
        track.style.transform = 'translateX(' + (-i * step()) + 'px)';
        prev.disabled = i === 0;
        next.disabled = i >= maxIndex();
      }
      function sync() {
        go();
      }
      prev.addEventListener('click', function () { if (i > 0) { i--; go(); } restart(); });
      next.addEventListener('click', function () { if (i < maxIndex()) { i++; go(); } restart(); });

      // drag / swipe
      var x0 = null;
      vp.addEventListener('pointerdown', function (e) { x0 = e.clientX; });
      vp.addEventListener('pointercancel', function () { x0 = null; });
      vp.addEventListener('dragstart', function (e) { e.preventDefault(); });
      window.addEventListener('pointerup', function (e) {
        if (x0 === null) return;
        var dx = e.clientX - x0; x0 = null;
        if (dx < -40 && i < maxIndex()) { i++; go(); }
        else if (dx > 40 && i > 0) { i--; go(); }
        else return;
        restart();
      });

      // ---- autoplay: advance every 6s, loop back to the start ----
      var DELAY = 6000;
      var timer = null;
      var paused = false;
      function tick() {
        if (paused) return;
        i = (i >= maxIndex()) ? 0 : i + 1;   // wrap around to the first slide
        go();
      }
      function restart() {
        if (timer) clearInterval(timer);
        timer = setInterval(tick, DELAY);
      }
      // pause while the pointer is over the carousel or a slide has focus
      var root = vp.parentNode;
      root.addEventListener('mouseenter', function () { paused = true; });
      root.addEventListener('mouseleave', function () { paused = false; });
      root.addEventListener('focusin', function () { paused = true; });
      root.addEventListener('focusout', function () { paused = false; });
      // pause when scrolled out of view so we do not animate off-screen
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          paused = !entries[0].isIntersecting;
        }, { threshold: 0.15 }).observe(vp);
      } else {
        // fallback: pause when the document is hidden
        document.addEventListener('visibilitychange', function () {
          paused = document.hidden;
        });
      }

      window.addEventListener('resize', sync);
      sync();
      restart();
    })();
  </script>


  <!-- Parameters table: everything below "Target power factor" sits behind a toggle -->
  <script>
    (function () {
      var btn = document.querySelector('[data-param-toggle]');
      var panel = document.getElementById('parameters-more');
      if (!btn || !panel) return;
      var label = btn.querySelector('[data-param-toggle-label]');
      var icon = btn.querySelector('[data-param-toggle-icon]');
      function isOpen() { return !panel.hasAttribute('hidden'); }
      function render() {
        var open = isOpen();
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (label) label.textContent = open ? 'Show fewer parameters' : 'Show all parameters';
        if (icon) icon.classList.toggle('rotate-180', open);
      }
      btn.addEventListener('click', function () {
        if (isOpen()) panel.setAttribute('hidden', '');
        else panel.removeAttribute('hidden');
        render();
      });
      render();
    })();
  </script>
</BaseLayout>

