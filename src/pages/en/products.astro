---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = {
  title: 'CHITEK — Low Voltage AHF & SVG Manufacturer | Power Quality Solutions',
  description: 'CHITEK offers Active Harmonic Filter (AHF), Static Var Generator (SVG), SiC AHF/SVG for low-voltage power quality correction.',
};

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/en' + p : p;
---

<BaseLayout title={meta.title} description={meta.description}>
  <!-- Sticky Tab Bar removed (2026-09-18: the AHF/SVG tab panels do not exist on the EN page, so the bar only added a floating strip on scroll) -->

  <!-- Hero Section -->
  <section id="hero" class="relative w-full overflow-hidden min-h-[33vh] mt-[72px] flex items-center justify-center" style="background:url('/assets/images/products-hero-bg.webp') center/cover no-repeat">
    <canvas id="hero-canvas" class="absolute inset-0 z-[1] pointer-events-none"></canvas>
    <div class="relative z-[2]">
      <div class="text-center">
        <h1 id="hero-title" class="text-[clamp(2.5rem,6vw,5rem)] font-bold leading-tight mb-[clamp(12px,2vw,32px)] hero-fade font-barlow-condensed text-brand-orange">
          Excellent Products
