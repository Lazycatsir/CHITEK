        return '<button onclick="selectWizVoltage(\'' + v + '\')" class="w-full flex items-center gap-[clamp(8px,1.5vw,20px)] p-4 rounded-lg border transition-all text-left ' + (isSel ? 'border-brand-orange bg-brand-orange/5' : 'border-border-light bg-white hover:border-[#d1d5db]') + '"><span class="w-4 h-4 rounded-full ' + colors[v] + '"></span><div><p class="text-text-dark font-medium">' + v + '</p></div></button>';
