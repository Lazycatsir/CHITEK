                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="v" value="480V" /> 480V</label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="v" value="690V" /> 690V</label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="v" value="800V" /> 800V</label>
              </div>
            </div>
            <div class="mb-4">
              <p class="text-[13px] font-semibold text-gray-800 mb-2">Current</p>
              <div class="grid grid-cols-2 gap-x-2 gap-y-2">
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="a" value="8~20A" /> 8~20A</label>
                <label class="flex items-center gap-2 text-[13px] text-gray-700 cursor-pointer"><input type="checkbox" data-filter="a" value="30~50A" /> 30~50A</label>
