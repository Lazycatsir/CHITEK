---
import BaseLayout from '../layouts/BaseLayout.astro';

const meta = {
  title: 'CHITEK — 低压静止无功发生器（SVG）| 功率因数校正',
  description: 'CHITEK 静止无功发生器（SVG）为低压电网提供无级无功补偿与功率因数校正——涵盖壁挂式、机架式、分布式与 IP65 系列。',
};

// 中文站无语言前缀（/products-svg 就是中文站），因此 lp() 直通；
// 英文站之所以拼 '/en' 前缀，只是为了让本地 dev 能命中 /en 路由。
const lp = (p: string) => p;
---

<BaseLayout lang="zh" title={meta.title} description={meta.description}>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://chitek-inno.com/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://chitek-inno.com/products" },
      { "@type": "ListItem", "position": 3, "name": "Static Var Generator" }
    ]
  }
  </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Static Var Generator (SVG) Series",
    "numberOfItems": 8,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Silicon Carbide MOSFET Static Var Generator SiC", "url": "https://en.chitek-inno.com/products-svg/sic-ultra-svg" },
      { "@type": "ListItem", "position": 2, "name": "208V/400V/480V Anti-Pollution Static Var Generator", "url": "https://en.chitek-inno.com/products-svg/anti-pollution-svg" },
      { "@type": "ListItem", "position": 3, "name": "690V/800V Anti-Pollution Static Var Generator", "url": "https://en.chitek-inno.com/products-svg/anti-pollution-hv-svg" },
      { "@type": "ListItem", "position": 4, "name": "Ultra-slim Static Var Generator", "url": "https://en.chitek-inno.com/products-svg/ultra-slim-svg" },
      { "@type": "ListItem", "position": 5, "name": "Distributed Static Var Generator", "url": "https://en.chitek-inno.com/products-svg/distributed-svg" },
      { "@type": "ListItem", "position": 6, "name": "IP65 SiC-Fanless Static Var Generator 25A", "url": "https://en.chitek-inno.com/products-svg/ip65-sic-fanless-svg" },
      { "@type": "ListItem", "position": 7, "name": "IP65 Static Var Generator", "url": "https://en.chitek-inno.com/products-svg/ip65-svg" },
      { "@type": "ListItem", "position": 8, "name": "IP65 SiC-Low Noise Fan Static Var Generator 50A", "url": "https://en.chitek-inno.com/products-svg/sic-fanless-svg" }
    ]
  }
  </script>
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": "zh-CN",
    "mainEntity": [
      { "@type": "Question", "name": "Q1：SVG 与电容器组有什么区别？", "acceptedAnswer": { "@type": "Answer", "text": "静止无功发生器（SVG）是一种主动式无级补偿装置——它持续读取无功需求，并精确注入电网所需的容量，使补偿实时跟随负载变化。电容器组或电抗器组则以固定分级投切，因此会造成功率因数跳变、可能引发谐振，并且需要定期维护。下表就现场真正关心的各项维度对两者做对比。" } },
      { "@type": "Question", "name": "Q2：一台 SVG 能跟随波动的负载吗？", "acceptedAnswer": { "@type": "Answer", "text": "可以，这正是它优于投切式电容器组的地方。焊接、电机启动和变频器升速每秒都会多次改变无功需求，发生器逐周期跟踪这些变化，因此也能覆盖接触器式电容器组永远看不到的快速波动。" } },
      { "@type": "Question", "name": "Q3：SVG 装置可以并联以获得更高容量吗？", "acceptedAnswer": { "@type": "Answer", "text": "可以。该系列采用模块化设计，装置可并联运行，从单台壁挂式模块到大型工厂均可覆盖，不必让所有负载都通过一个超大柜体。" } },
      { "@type": "Question", "name": "Q4：SVG 可以安装在户外或恶劣环境中吗？", "acceptedAnswer": { "@type": "Answer", "text": "可以。除室内柜体外，该系列还提供面向户外及多尘场所的 IP65 型号；在粉尘、腐蚀或噪声成为主要制约因素的配电室中，可选防污染型与无风扇低噪型。" } }
    ]
  }
  </script>
