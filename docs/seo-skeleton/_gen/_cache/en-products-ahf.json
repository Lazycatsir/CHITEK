    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do the models in the AHF range differ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The range varies on two axes — switching technology (IGBT or SiC MOSFET) and mechanical format (ultra-slim wall mount, distributed, anti-pollution, IP65 outdoor and fanless low-noise). Every model applies the same real-time compensation principle; they differ in switching efficiency, footprint, enclosure rating and acoustic noise."
          }
        },
        {
          "@type": "Question",
          "name": "Which harmonic orders does the AHF series correct?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every model in the range compensates harmonic orders from the 2nd through the 50th, and you choose how much of each individual order is corrected. Instead of running to a fixed curve, the compensation current tracks whatever the network is producing at that moment."
          }
        },
        {
          "@type": "Question",
          "name": "Can AHF modules be combined to reach a higher capacity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The range is modular — modules parallel without a practical limit, so the same platform covers a single wall-mounted unit and installations reaching 3000 A and beyond."
          }
        },
        {
          "@type": "Question",
          "name": "Can AHF be installed outdoors or in harsh environments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Alongside IP20 and IP30/IP40 enclosures for indoor switchrooms, the range includes IP65 models for outdoor and dusty sites, plus anti-pollution and fanless low-noise versions where dust, corrosion or acoustic noise is the constraint."
          }
        }
      ]
    }
  ],
