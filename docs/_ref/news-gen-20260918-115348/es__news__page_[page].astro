---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import NewsCard from '../../../components/news/NewsCard.astro';
import NewsPager from '../../../components/news/NewsPager.astro';
import { esNewsCards, NEWS_PER_PAGE, NEWS_TOTAL_PAGES } from '../../../data/esNewsCards.js';

// Flat URL: /es/news/page_2/ ... (empty prefix for zh => /news/page_2/)
// getStaticPaths runs before the top-level statements below, so it can only use
// values that come from imports (NEWS_TOTAL_PAGES), never local consts.
export function getStaticPaths() {
  return Array.from({ length: NEWS_TOTAL_PAGES - 1 }, (_, i) => ({ params: { page: String(i + 2) } }));
}

const total = NEWS_TOTAL_PAGES;
const current = Number(Astro.params.page);
const start = (current - 1) * NEWS_PER_PAGE;
const cards = esNewsCards.slice(start, start + NEWS_PER_PAGE);

const isLocal = /localhost|127\.0\.0\.1|0\.0\.0\.0/.test(Astro.url.host);
const lp = (p: string) => isLocal ? '/es' + p : p;
const pageUrl = (n: number) => (n === 1 ? lp('/news/') : lp('/news/page_' + n + '/'));
---
<BaseLayout
  title={`Noticias y Perspectivas — Página ${current} | CHITEK INNOPOWER`}
  description={`Página ${current} del archivo de noticias y perspectivas de CHITEK INNOPOWER: artículos técnicos, tendencias y casos de calidad de energía.`}
  lang="es"
  alternates={false}
>
  <Sidebar lang="es" />

  <!-- Hero Section -->
  <section class="relative w-full overflow-hidden min-h-[33vh] mt-[72px] flex items-center bg-bg-dark text-white">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-br from-brand-orange/20 to-transparent"></div>
    </div>
    <div class="relative z-10 w-full max-w-7xl mx-auto px-5 md:px-12">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold font-[family-name:var(--font-barlow-condensed)] tracking-tight mb-6">
        Noticias y <span class="text-brand-orange">Perspectivas</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-300 max-w-2xl leading-relaxed">
        Manténgase informado sobre los últimos desarrollos en tecnología de calidad de energía, tendencias de la industria y soluciones CHITEK.
      </p>
    </div>
  </section>

  <!-- Articles (page 2+) -->
  <section id="articles" class="pt-10 md:pt-14 pb-16 md:pb-20 bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-12">
      <div class="space-y-6">
        {cards.map((card) => (
          <NewsCard
            href={lp(card.href)}
            img={card.img}
            alt={card.alt}
            category={card.category}
            cat={card.cat}
            date={card.date}
            title={card.title}
            desc={card.desc}
            readMore="Leer más"
          />
        ))}
      </div>

      <NewsPager
        current={current}
        total={total}
        url={pageUrl}
        label="Paginación de noticias"
        prevLabel="Página anterior"
        nextLabel="Página siguiente"
      />
    </div>
  </section>
</BaseLayout>
